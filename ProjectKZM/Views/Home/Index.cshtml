    else
    {

        <!-- =================================================
             KHÔNG CÓ SẢN PHẨM
             ================================================= -->

        <div class="empty-products">

            <h4>
                Không tìm thấy sản phẩm
            </h4>

            <p>
                Không có sách nào phù hợp
                với điều kiện tìm kiếm hoặc bộ lọc.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">

                Xem tất cả sản phẩm

            </a>

