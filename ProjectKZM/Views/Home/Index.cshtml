@model IEnumerable<ProjectKZM.Models.Sach>

@{
    ViewData["Title"] = "Yuuji Store";

    var search = ViewBag.Search as string ?? "";

    // =========================================================
    // SÁCH MỚI
    // SẮP XẾP MÃ SÁCH LỚN -> NHỎ
    // =========================================================

    var sachMoi =
        (ViewBag.SachMoi as IEnumerable<ProjectKZM.Models.Sach>
        ?? Enumerable.Empty<ProjectKZM.Models.Sach>())
        .OrderByDescending(x => x.MaSach)
        .ToList();

    // =========================================================
    // TẤT CẢ SÁCH
    // SẮP XẾP MÃ SÁCH LỚN -> NHỎ
    // =========================================================

    var danhSachSach =
        (Model ?? Enumerable.Empty<ProjectKZM.Models.Sach>())
        .OrderByDescending(x => x.MaSach)
        .ToList();

    var selectedTheLoaiIds =
        ViewBag.SelectedTheLoaiIds as int[]
        ?? Array.Empty<int>();

    var selectedLoaiSachIds =
        ViewBag.SelectedLoaiSachIds as int[]
        ?? Array.Empty<int>();

    var favoriteBookIds =
        ViewBag.FavoriteBookIds as int[]
        ?? Array.Empty<int>();

    bool isSearchingOrFiltering =
        Context.Request.Query.ContainsKey("search")
        || selectedTheLoaiIds.Length > 0
        || selectedLoaiSachIds.Length > 0;
}

<style>

    /* =========================================================
               PAGE
               ========================================================= */

    .store-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 25px 60px;
    }


    /* =========================================================
               THẾ GIỚI SÁCH
               ========================================================= */

    .book-store-title {
        width: 100%;
        text-align: center;
        padding: 25px 0 35px;
    }

        .book-store-title h1 {
            margin: 0;
            font-size: 36px;
            font-weight: 400;
            color: #222;
            line-height: 1.3;
        }

        .book-store-title p {
            margin: 10px 0 0;
            font-size: 16px;
            font-weight: 400;
            color: #888;
            line-height: 1.5;
        }


    /* =========================================================
               SÁCH MỚI
               ========================================================= */

    .new-books-section {
        margin-bottom: 40px;
    }

    .new-books-title {
        font-size: 26px;
        font-weight: 600;
        color: #222;
        margin-bottom: 18px;
    }

    .new-books-slider {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 10px;
        cursor: grab;
        user-select: none;
    }

        .new-books-slider:active {
            cursor: grabbing;
        }

    .new-books-track {
        display: flex;
        gap: 22px;
        width: max-content;
        will-change: transform;
    }

    .new-book-card {
        width: 250px;
        min-width: 250px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        overflow: hidden;
        transition: 0.2s;
    }

        .new-book-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }


    /* =========================================================
               ẢNH SÁCH MỚI
               ========================================================= */

    .new-book-image-wrapper {
        position: relative;
        width: 100%;
        height: 300px;
        background: #f5f5f5;
        overflow: hidden;
    }

    .new-book-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .new-book-no-image {
        width: 100%;
        height: 100%;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #777;
        font-size: 13px;
    }


    /* =========================================================
               OVERLAY HẾT HÀNG
               DÙNG CHUNG CHO SÁCH MỚI + TẤT CẢ SẢN PHẨM
               ========================================================= */

    .out-of-stock-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.58);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        pointer-events: none;
    }

    .out-of-stock-text {
        color: white;
        font-size: 36px;
        font-weight: 500;
        text-align: center;
        line-height: 1.2;
        text-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    }


    /* =========================================================
               LOẠI SÁCH - SÁCH MỚI
               ========================================================= */

    .new-book-type-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 5px 9px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        color: #333;
        z-index: 5;
    }


    /* =========================================================
               YÊU THÍCH - SÁCH MỚI
               ========================================================= */

    .new-book-favorite {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        font-size: 22px;
        line-height: 36px;
        cursor: pointer;
        z-index: 5;
        transition: all 0.2s ease;
    }

        .new-book-favorite:hover {
            transform: scale(1.1);
        }

        .new-book-favorite.active {
            color: #dc3545;
        }


    /* =========================================================
               THÔNG TIN SÁCH MỚI
               ========================================================= */

    .new-book-info {
        padding: 15px;
    }

    .new-book-name {
        height: 48px;
        overflow: hidden;
        font-size: 17px;
        font-weight: 600;
        color: #222;
        line-height: 1.4;
        margin-bottom: 8px;
    }

    .new-book-price {
        color: #dc3545;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
    }


    /* =========================================================
               TÌNH TRẠNG
               ========================================================= */

    .book-stock {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 10px;
    }

        .book-stock.available {
            color: #198754;
        }

        .book-stock.out-of-stock {
            color: #dc3545;
        }


    /* =========================================================
               CATEGORY - SÁCH MỚI
               ========================================================= */

    .new-book-categories {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 15px;
        min-height: 25px;
    }

    .new-book-category {
        padding: 4px 7px;
        background: #f0f0f0;
        border-radius: 4px;
        font-size: 11px;
        color: #555;
    }


    /* =========================================================
               BUTTON - SÁCH MỚI
               ========================================================= */

    .new-book-button-group {
        display: flex;
        gap: 8px;
        width: 100%;
    }

    .new-book-view-button {
        flex: 1;
        height: 40px;
        border: none;
        border-radius: 6px;
        background: #6c757d;
        color: white;
        cursor: pointer;
        font-size: 14px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .new-book-view-button:hover {
            background: #5c636a;
            color: white;
            text-decoration: none;
        }

    .new-book-cart-button {
        flex: 1;
        width: auto;
        height: 40px;
        border: none;
        border-radius: 6px;
        background: #212529;
        color: white;
        cursor: pointer;
        font-size: 14px;
    }

        .new-book-cart-button:hover {
            background: #000;
        }

        .new-book-cart-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background: #6c757d;
        }


    /* =========================================================
               KẾT QUẢ TÌM KIẾM
               ========================================================= */

    .result-info {
        margin-bottom: 20px;
        color: #666;
    }


    /* =========================================================
               TẤT CẢ SẢN PHẨM
               ========================================================= */

    .all-products-title {
        font-size: 32px;
        font-weight: 600;
        color: #222;
        margin-bottom: 20px;
    }


    /* =========================================================
               PRODUCT GRID
               ========================================================= */

    .product-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 22px;
    }


    /* =========================================================
               PRODUCT CARD
               ========================================================= */

    .product-card {
        position: relative;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        overflow: hidden;
        transition: 0.2s;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }


    /* =========================================================
               PRODUCT IMAGE
               ========================================================= */

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 300px;
        background: #f5f5f5;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }


    /* =========================================================
               LOẠI SÁCH
               ========================================================= */

    .book-type-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 5px 9px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        color: #333;
        z-index: 5;
    }


    /* =========================================================
               YÊU THÍCH
               ========================================================= */

    .favorite-button {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        font-size: 22px;
        line-height: 36px;
        cursor: pointer;
        z-index: 5;
        transition: all 0.2s ease;
    }

        .favorite-button:hover {
            transform: scale(1.1);
        }

        .favorite-button.active {
            color: #dc3545;
        }

            .favorite-button.active:hover {
                transform: scale(1.15);
            }


    /* =========================================================
               PRODUCT INFO
               ========================================================= */

    .product-info {
        padding: 15px;
    }

    .product-name {
        font-size: 17px;
        font-weight: 600;
        color: #222;
        margin-bottom: 8px;
        height: 48px;
        overflow: hidden;
    }

    .product-price {
        color: #dc3545;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
    }


    /* =========================================================
               PRODUCT CATEGORIES
               ========================================================= */

    .product-categories {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 15px;
        min-height: 25px;
    }


    /* =========================================================
               BADGE
               ========================================================= */

    .book-type-badge,
    .new-book-type-badge,
    .category-badge,
    .new-book-category {
        text-decoration: none !important;
    }

        .book-type-badge:hover,
        .new-book-type-badge:hover,
        .category-badge:hover,
        .new-book-category:hover {
            text-decoration: none !important;
            /* CHỈ BỎ HIỆU ỨNG NHẢY LÊN */
            transform: none;
        }

        /* =====================================================
               CHỈ ĐỔI MÀU KHI RÊ CHUỘT
               CHO LOẠI SÁCH + THỂ LOẠI Ở SÁCH MỚI
               ===================================================== */

        .new-book-type-badge:hover,
        .new-book-category:hover {
            background: #212529;
            color: white;
        }

        .book-type-badge:hover {
            background: #212529;
            color: white;
        }

        .category-badge:hover {
            background: #212529;
            color: white;
        }

    .category-badge {
        padding: 4px 7px;
        background: #f0f0f0;
        border-radius: 4px;
        font-size: 11px;
        color: #555;
    }


    /* =========================================================
               NÚT SẢN PHẨM
               ========================================================= */

    .product-button-group {
        display: flex;
        gap: 8px;
        width: 100%;
    }

    .view-book-button {
        flex: 1;
        height: 40px;
        border: none;
        border-radius: 6px;
        background: #6c757d;
        color: white;
        cursor: pointer;
        font-size: 14px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .view-book-button:hover {
            background: #5c636a;
            color: white;
            text-decoration: none;
        }

    .cart-button {
        flex: 1;
        width: auto;
        height: 40px;
        border: none;
        border-radius: 6px;
        background: #212529;
        color: white;
        cursor: pointer;
        font-size: 14px;
    }

        .cart-button:hover {
            background: #000;
        }

        .cart-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background: #6c757d;
        }


    /* =========================================================
               KHÔNG CÓ SẢN PHẨM
               ========================================================= */

    .empty-products {
        padding: 80px 20px;
        text-align: center;
        color: #777;
        border: 1px dashed #ccc;
        border-radius: 10px;
    }


    /* =========================================================
               THÔNG BÁO
               ========================================================= */

    .login-warning {
        position: fixed;
        top: 25px;
        right: 25px;
        z-index: 9999;
        background: #dc3545;
        color: white;
        padding: 14px 22px;
        border-radius: 7px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        display: none;
        font-size: 15px;
    }


    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 1200px) {

        .product-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .new-book-card {
            width: 250px;
            min-width: 250px;
        }
    }


    @@media (max-width: 900px) {

        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .new-book-card {
            width: 250px;
            min-width: 250px;
        }
    }


    @@media (max-width: 650px) {

        .product-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .store-page {
            padding: 20px 15px 40px;
        }

        .book-store-title {
            padding: 15px 0 25px;
        }

            .book-store-title h1 {
                font-size: 30px;
            }

            .book-store-title p {
                font-size: 14px;
            }

        .new-book-card {
            width: 100%;
            min-width: 100%;
        }

        .new-book-image-wrapper {
            height: 300px;
        }

        .product-button-group,
        .new-book-button-group {
            flex-direction: column;
        }

        .view-book-button,
        .cart-button,
        .new-book-view-button,
        .new-book-cart-button {
            width: 100%;
            flex: none;
        }
    }

</style>


<div class="store-page">

    @* =========================================================
       CHỈ HIỆN THẾ GIỚI SÁCH + SÁCH MỚI
       KHI KHÔNG SEARCH / KHÔNG LỌC
       ========================================================= *@

    @if (!isSearchingOrFiltering)
    {

        <!-- =====================================================
             THẾ GIỚI SÁCH
             ===================================================== -->

        <div class="book-store-title">

            <h1>
                Yuuji Store
            </h1>

            <p>
                Thế giới sách của Yuuji Kazami, Manga, Novel,
                Light Novel và nhiều thể loại sách khác
            </p>

        </div>


        <!-- =====================================================
             SÁCH MỚI
             ===================================================== -->
        @if (sachMoi.Any())
        {

            <div class="new-books-section">

                <div class="new-books-title">
                    Sách mới
                </div>


                <div class="new-books-slider">

                    <div class="new-books-track">


                        @* =================================================
                           LẦN 1
                           ĐÃ SORT MaSach DESC Ở ĐẦU FILE
                           ================================================= *@

                        @foreach (var item in sachMoi)
                        {

                            <div class="new-book-card">

                                <!-- =================================================
                                     ẢNH
                                     ================================================= -->

                                <div class="new-book-image-wrapper">


                                    <!-- LOẠI SÁCH -->
                                    @if (item.LoaiSach != null)
                                    {
                                        <a asp-controller="Home"
                                           asp-action="Index"
                                           asp-route-loaiSachIds="@item.MaLoaiSach"
                                           class="new-book-type-badge"
                                           title="Lọc theo loại sách"
                                           onclick="event.stopPropagation();">

                                            @item.LoaiSach.TenLoaiSach

                                        </a>
                                    }


                                    <!-- YÊU THÍCH -->

                                    <button type="button"
                                            class="new-book-favorite @(favoriteBookIds.Contains(item.MaSach) ? "active" : "")"
                                            title="@(favoriteBookIds.Contains(item.MaSach) ? "Bỏ yêu thích" : "Thêm vào yêu thích")"
                                            data-book-id="@item.MaSach"
                                            onclick="toggleFavorite(this)">

                                        @(favoriteBookIds.Contains(item.MaSach) ? "♥" : "♡")

                                    </button>


                                    <!-- HÌNH -->
                                    @if (!string.IsNullOrEmpty(item.Hinh))
                                    {
                                        <img src="@item.Hinh"
                                             class="new-book-image"
                                             alt="@item.TenSach" />
                                    }
                                    else
                                    {
                                        <div class="new-book-no-image">
                                            Không có hình
                                        </div>
                                    }


                                    <!-- =================================================
                                         OVERLAY HẾT HÀNG
                                         DÙNG CHUNG VỚI TẤT CẢ SẢN PHẨM
                                         ================================================= -->
                                    @if (item.SoLuong <= 0)
                                    {
                                        <div class="out-of-stock-overlay">

                                            <div class="out-of-stock-text">
                                                Hết Hàng
                                            </div>

                                        </div>
                                    }

                                </div>


                                <!-- =================================================
                                     THÔNG TIN
                                     ================================================= -->

                                <div class="new-book-info">


                                    <!-- TÊN -->

                                    <div class="new-book-name">
                                        @item.TenSach
                                    </div>


                                    <!-- GIÁ -->

                                    <div class="new-book-price">
                                        @item.Gia.ToString("N0") ₫
                                    </div>


                                    <!-- TÌNH TRẠNG -->
                                    @if (item.SoLuong > 0)
                                    {
                                        <div class="book-stock available">
                                            Còn hàng
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="book-stock out-of-stock">
                                            Hết hàng
                                        </div>
                                    }


                                    <!-- THỂ LOẠI -->

                                    <div class="new-book-categories">

                                        @if (item.SachTheLoais != null &&
                                             item.SachTheLoais.Any())
                                        {
                                            @foreach (var st in item.SachTheLoais)
                                            {
                                                if (st.TheLoai != null)
                                                {
                                                    <a asp-controller="Home"
                                                       asp-action="Index"
                                                       asp-route-theLoaiIds="@st.MaTheLoai"
                                                       class="new-book-category"
                                                       title="Lọc theo thể loại"
                                                       onclick="event.stopPropagation();">

                                                        @st.TheLoai.TenTheLoai

                                                    </a>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span style="font-size:11px;color:#777;">
                                                Chưa có thể loại
                                            </span>
                                        }

                                    </div>


                                    <!-- NÚT -->

                                    <div class="new-book-button-group">


                                        <!-- XEM SÁCH -->

                                        <a asp-controller="Sachs"
                                           asp-action="Details"
                                           asp-route-id="@item.MaSach"
                                           class="new-book-view-button">

                                            Xem sách

                                        </a>


                                        <!-- GIỎ HÀNG -->
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {

                                            <form asp-controller="GioHangs"
                                                  asp-action="Them"
                                                  method="post"
                                                  class="add-cart-form new-book-cart-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="maSach"
                                                       value="@item.MaSach" />

                                                <input type="hidden"
                                                       name="soLuong"
                                                       value="1" />

                                                @if (item.SoLuong > 0)
                                                {
                                                    <button type="submit"
                                                            class="new-book-cart-button">

                                                        🛒 Bỏ vào giỏ hàng

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="new-book-cart-button"
                                                            disabled>

                                                        🛒 Hết hàng

                                                    </button>
                                                }

                                            </form>

                                        }
                                        else
                                        {

                                            @if (item.SoLuong > 0)
                                            {
                                                <button type="button"
                                                        class="new-book-cart-button"
                                                        onclick="showLoginWarning()">

                                                    🛒 Bỏ vào giỏ hàng

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="new-book-cart-button"
                                                        disabled>

                                                    🛒 Hết hàng

                                                </button>
                                            }

                                        }

                                    </div>

                                </div>

                            </div>

                        }


                        @* =================================================
                           LẦN 2 - NHÂN ĐÔI SLIDER
                           VẪN GIỮ NGUYÊN THỨ TỰ MaSach DESC
                           ================================================= *@

                        @foreach (var item in sachMoi)
                        {

                            <div class="new-book-card">

                                <div class="new-book-image-wrapper">


                                    <!-- LOẠI SÁCH -->
                                    @if (item.LoaiSach != null)
                                    {
                                        <a asp-controller="Home"
                                           asp-action="Index"
                                           asp-route-loaiSachIds="@item.MaLoaiSach"
                                           class="new-book-type-badge"
                                           title="Lọc theo loại sách"
                                           onclick="event.stopPropagation();">

                                            @item.LoaiSach.TenLoaiSach

                                        </a>
                                    }


                                    <!-- YÊU THÍCH -->

                                    <button type="button"
                                            class="new-book-favorite @(favoriteBookIds.Contains(item.MaSach) ? "active" : "")"
                                            title="@(favoriteBookIds.Contains(item.MaSach) ? "Bỏ yêu thích" : "Thêm vào yêu thích")"
                                            data-book-id="@item.MaSach"
                                            onclick="toggleFavorite(this)">

                                        @(favoriteBookIds.Contains(item.MaSach) ? "♥" : "♡")

                                    </button>


                                    <!-- HÌNH -->
                                    @if (!string.IsNullOrEmpty(item.Hinh))
                                    {
                                        <img src="@item.Hinh"
                                             class="new-book-image"
                                             alt="@item.TenSach" />
                                    }
                                    else
                                    {
                                        <div class="new-book-no-image">
                                            Không có hình
                                        </div>
                                    }


                                    <!-- OVERLAY HẾT HÀNG -->
                                    @if (item.SoLuong <= 0)
                                    {
                                        <div class="out-of-stock-overlay">

                                            <div class="out-of-stock-text">
                                                Hết Hàng
                                            </div>

                                        </div>
                                    }

                                </div>


                                <div class="new-book-info">


                                    <div class="new-book-name">
                                        @item.TenSach
                                    </div>


                                    <div class="new-book-price">
                                        @item.Gia.ToString("N0") ₫
                                    </div>


                                    <!-- TÌNH TRẠNG -->
                                    @if (item.SoLuong > 0)
                                    {
                                        <div class="book-stock available">
                                            Còn hàng
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="book-stock out-of-stock">
                                            Hết hàng
                                        </div>
                                    }


                                    <div class="new-book-categories">

                                        @if (item.SachTheLoais != null &&
                                             item.SachTheLoais.Any())
                                        {
                                            @foreach (var st in item.SachTheLoais)
                                            {
                                                if (st.TheLoai != null)
                                                {
                                                    <a asp-controller="Home"
                                                       asp-action="Index"
                                                       asp-route-theLoaiIds="@st.MaTheLoai"
                                                       class="new-book-category"
                                                       title="Lọc theo thể loại"
                                                       onclick="event.stopPropagation();">

                                                        @st.TheLoai.TenTheLoai

                                                    </a>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <span style="font-size:11px;color:#777;">
                                                Chưa có thể loại
                                            </span>
                                        }

                                    </div>


                                    <!-- NÚT -->

                                    <div class="new-book-button-group">


                                        <!-- XEM SÁCH -->

                                        <a asp-controller="Sachs"
                                           asp-action="Details"
                                           asp-route-id="@item.MaSach"
                                           class="new-book-view-button">

                                            Xem sách

                                        </a>


                                        <!-- GIỎ HÀNG -->
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {

                                            <form asp-controller="GioHangs"
                                                  asp-action="Them"
                                                  method="post"
                                                  class="add-cart-form new-book-cart-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="maSach"
                                                       value="@item.MaSach" />

                                                <input type="hidden"
                                                       name="soLuong"
                                                       value="1" />

                                                @if (item.SoLuong > 0)
                                                {
                                                    <button type="submit"
                                                            class="new-book-cart-button">

                                                        🛒 Bỏ vào giỏ hàng

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="new-book-cart-button"
                                                            disabled>

                                                        🛒 Hết hàng

                                                    </button>
                                                }

                                            </form>

                                        }
                                        else
                                        {

                                            @if (item.SoLuong > 0)
                                            {
                                                <button type="button"
                                                        class="new-book-cart-button"
                                                        onclick="showLoginWarning()">

                                                    🛒 Bỏ vào giỏ hàng

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="new-book-cart-button"
                                                        disabled>

                                                    🛒 Hết hàng

                                                </button>
                                            }

                                        }

                                    </div>

                                </div>

                            </div>

                        }

                    </div>

                </div>

            </div>

        }

    }


    <!-- =========================================================
         KẾT QUẢ
         ========================================================= -->

    <div class="result-info">

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <span>

                Kết quả tìm kiếm cho:

                <strong>
                    "@search"
                </strong>

            </span>
        }
        else if (selectedTheLoaiIds.Length > 0 ||
                 selectedLoaiSachIds.Length > 0)
        {
            <span>
                Kết quả sau khi lọc
            </span>
        }
        else if (Context.Request.Query.ContainsKey("search"))
        {
            <span>
                Kết quả tìm kiếm
            </span>
        }
        else
        {
            <div class="all-products-title">
                Tất Cả Sản Phẩm
            </div>
        }

    </div>


    <!-- =========================================================
         DANH SÁCH SẢN PHẨM
         ĐÃ SORT MaSach DESC
         ========================================================= -->
    @if (danhSachSach.Any())
    {

        <div class="product-grid">

            @foreach (var item in danhSachSach)
            {

                <div class="product-card">


                    <!-- =================================================
                         HÌNH SẢN PHẨM
                         ================================================= -->

                    <div class="product-image-wrapper">


                        <!-- LOẠI SÁCH -->
                        @if (item.LoaiSach != null)
                        {
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-route-loaiSachIds="@item.MaLoaiSach"
                               class="book-type-badge"
                               title="Lọc theo loại sách"
                               onclick="event.stopPropagation();">

                                @item.LoaiSach.TenLoaiSach

                            </a>
                        }


                        <!-- YÊU THÍCH -->

                        <button type="button"
                                class="favorite-button @(favoriteBookIds.Contains(item.MaSach) ? "active" : "")"
                                title="@(favoriteBookIds.Contains(item.MaSach) ? "Bỏ yêu thích" : "Thêm vào yêu thích")"
                                data-book-id="@item.MaSach"
                                onclick="toggleFavorite(this)">

                            @(favoriteBookIds.Contains(item.MaSach) ? "♥" : "♡")

                        </button>


                        <!-- HÌNH -->
                        @if (!string.IsNullOrEmpty(item.Hinh))
                        {
                            <img src="@item.Hinh"
