</div>


<!-- =========================================================
     LOGIN WARNING
     ========================================================= -->

<div id="loginWarning"
     class="login-warning">

    Hãy đăng nhập để bỏ vào giỏ hàng

</div>


@section Scripts {

    <script>


        /* =====================================================
           THÔNG BÁO ĐĂNG NHẬP
           ===================================================== */

        function showLoginWarning() {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                "Hãy đăng nhập để bỏ vào giỏ hàng";

            warning.style.background =
                "#dc3545";

            warning.style.display =
                "block";


            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           THÊM SẢN PHẨM VÀO GIỎ
           KHÔNG CHUYỂN TRANG
           ===================================================== */

        document.querySelectorAll(".add-cart-form")
            .forEach(function(form) {

                form.addEventListener(
                    "submit",
                    async function(event) {

                        event.preventDefault();


                        const button =
                            form.querySelector(
                                ".cart-button, .new-book-cart-button"
                            );


                        if (!button) {
                            return;
                        }


                        const originalText =
                            button.innerHTML;


                        button.disabled =
                            true;


                        button.innerHTML =
                            "⏳ Đang thêm...";


                        try {

                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: "POST",
                                        body: new FormData(form)
                                    }
                                );


                            if (response.ok) {

                                let productCard =
                                    form.closest(".product-card");


                                if (!productCard) {

                                    productCard =
                                        form.closest(".new-book-card");

                                }


                                const bookNameElement =
                                    productCard
                                        ?.querySelector(
                                            ".product-name, .new-book-name"
                                        );


                                const bookName =
                                    bookNameElement
                                        ?.innerText
                                        ?.trim();


                                showCartSuccess(
                                    'Đã thêm "' +
                                    (bookName || "sản phẩm") +
                                    '" vào giỏ hàng.'
                                );

                            }
                            else {

                                showCartError(
                                    "Không thể thêm sản phẩm vào giỏ hàng."
                                );

                            }

                        }
                        catch (error) {

                            showCartError(
                                "Có lỗi xảy ra khi thêm vào giỏ hàng."
                            );

                        }
                        finally {

                            button.disabled =
                                false;


                            button.innerHTML =
                                originalText;

                        }

                    }
                );

            });


        /* =====================================================
           THÔNG BÁO THÊM GIỎ HÀNG THÀNH CÔNG
           ===================================================== */

        function showCartSuccess(message) {

            const warning =
                document.getElementById("loginWarning");


            if (!warning) {
                return;
            }


            warning.innerText =
                message;


            warning.style.background =
                "#198754";


            warning.style.display =
                "block";


            setTimeout(function() {

                warning.style.display =
                    "none";


                warning.style.background =
                    "#dc3545";

            }, 2000);

        }


        /* =====================================================
           THÔNG BÁO LỖI GIỎ HÀNG
           ===================================================== */

        function showCartError(message) {

            const warning =
                document.getElementById("loginWarning");


            if (!warning) {
                return;
            }


            warning.innerText =
                message;


            warning.style.background =
                "#dc3545";


            warning.style.display =
                "block";


            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           YÊU THÍCH
           ===================================================== */

        function toggleFavorite(button) {

            const isAuthenticated =
                @((User.Identity?.IsAuthenticated == true).ToString().ToLower());


            // =================================================
            // CHƯA ĐĂNG NHẬP
            // =================================================

            if (!isAuthenticated) {

                showFavoriteLoginWarning();

                return;
            }


            // =================================================
            // ĐỔI TRẠNG THÁI YÊU THÍCH
            // =================================================

            button.classList.toggle("active");


            if (button.classList.contains("active")) {

                button.innerHTML = "♥";

                button.title = "Bỏ yêu thích";


                showFavoriteSuccess(
                    "Đã thêm sách vào danh sách yêu thích."
                );

            }
            else {

                button.innerHTML = "♡";

                button.title = "Thêm vào yêu thích";


                showFavoriteSuccess(
                    "Đã bỏ sách khỏi danh sách yêu thích."
                );

            }

        }


        /* =====================================================
           THÔNG BÁO YÊU THÍCH THÀNH CÔNG
           ===================================================== */

        function showFavoriteSuccess(message) {

            const warning =
                document.getElementById("loginWarning");


            if (!warning) {
                return;
            }


            warning.innerText =
                message;


            warning.style.background =
                "#198754";


            warning.style.display =
                "block";


            setTimeout(function() {

                warning.style.display =
                    "none";

                warning.style.background =
                    "#dc3545";

            }, 2000);

        }


        /* =====================================================
           THÔNG BÁO ĐĂNG NHẬP KHI BẤM YÊU THÍCH
           ===================================================== */

        function showFavoriteLoginWarning() {

            const warning =
                document.getElementById("loginWarning");


            if (!warning) {
                return;
            }


            warning.innerText =
                "Hãy đăng nhập để thêm sách vào yêu thích";


            warning.style.background =
                "#dc3545";


            warning.style.display =
                "block";


            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        // =====================================================
        // SÁCH MỚI
        // TỰ ĐỘNG CHẠY + CÓ THỂ DÙNG CHUỘT KÉO QUA LẠI
        // =====================================================

        const newBooksSlider =
            document.querySelector(".new-books-slider");

        const newBooksTrack =
            document.querySelector(".new-books-track");

        if (newBooksSlider && newBooksTrack) {

            let position = 0;

            const speed = 0.5;

            let isMouseDown = false;
            let isHovering = false;

            let startX = 0;
            let startPosition = 0;


            // =================================================
            // DI CHUYỂN TỰ ĐỘNG
            // =================================================

            function moveNewBooks() {

                if (!isMouseDown && !isHovering) {

                    position -= speed;

                    const firstSetWidth =
                        newBooksTrack.scrollWidth / 2;

                    if (Math.abs(position) >= firstSetWidth) {
                        position = 0;
                    }

                    newBooksTrack.style.transform =
                        "translateX(" + position + "px)";
                }

                requestAnimationFrame(moveNewBooks);
            }


            // =================================================
            // RÊ CHUỘT VÀO -> DỪNG
            // =================================================

            newBooksSlider.addEventListener(
                "mouseenter",
                function () {

                    isHovering = true;

                }
            );


            // =================================================
            // RỜI CHUỘT -> CHẠY LẠI
            // =================================================

            newBooksSlider.addEventListener(
                "mouseleave",
                function () {

                    isHovering = false;

                    isMouseDown = false;

                }
            );


            // =================================================
            // BẮT ĐẦU KÉO
            // =================================================

            newBooksSlider.addEventListener(
                "mousedown",
                function (event) {

                    isMouseDown = true;

                    startX = event.clientX;

                    startPosition = position;

                    newBooksSlider.style.cursor =
                        "grabbing";

                }
            );


            // =================================================
            // KÉO CHUỘT
            // =================================================

            newBooksSlider.addEventListener(
                "mousemove",
                function (event) {

                    if (!isMouseDown) {
                        return;
                    }

                    const distance =
                        event.clientX - startX;

                    position =
                        startPosition + distance;


                    const firstSetWidth =
                        newBooksTrack.scrollWidth / 2;


                    // Nếu kéo quá bên trái
                    if (position <= -firstSetWidth) {

                        position = 0;

                        startX = event.clientX;
                        startPosition = position;

                    }


                    // Nếu kéo quá bên phải
                    if (position > 0) {

                        position = 0;

                        startX = event.clientX;
                        startPosition = position;

                    }


                    newBooksTrack.style.transform =
                        "translateX(" + position + "px";

                }
            );


            // =================================================
            // THẢ CHUỘT
            // =================================================

            document.addEventListener(
                "mouseup",
                function () {

                    if (!isMouseDown) {
                        return;
                    }

                    isMouseDown = false;

                    newBooksSlider.style.cursor =
                        "grab";

                }
            );


            // =================================================
            // BẮT ĐẦU
            // =================================================

            moveNewBooks();

        }

    </script>

}