</div>


<!-- =========================================================
     LOGIN WARNING
     ========================================================= -->

<div id="loginWarning"
     class="login-warning">

    Hãy đăng nhập để bỏ vào giỏ hàng

</div>


<!-- =========================================================
     ANTI FORGERY TOKEN CHO YÊU THÍCH
     ========================================================= -->

<form id="favoriteTokenForm"
      style="display:none;">

    @Html.AntiForgeryToken()

</form>


@section Scripts {

    <script>

        /* =====================================================
           THÔNG BÁO ĐĂNG NHẬP
           ===================================================== */

        function showLoginWarning() {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                "Hãy đăng nhập để bỏ vào giỏ hàng";

            warning.style.background =
                "#dc3545";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           THÊM SẢN PHẨM VÀO GIỎ
           ===================================================== */

        document.querySelectorAll(".add-cart-form")
            .forEach(function(form) {

                form.addEventListener(
                    "submit",
                    async function(event) {

                        event.preventDefault();

                        const button =
                            form.querySelector(
                                ".cart-button, .new-book-cart-button"
                            );

                        if (!button) {
                            return;
                        }

                        if (button.disabled) {
                            return;
                        }

                        const originalText =
                            button.innerHTML;

                        const originalBackground =
                            button.style.backgroundColor;

                        button.disabled = true;

                        try {

                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: "POST",
                                        body: new FormData(form)
                                    }
                                );

                            if (response.ok) {

                                button.innerHTML =
                                    "🛒 Đã thêm vào giỏ";

                                button.style.backgroundColor =
                                    "#198754";

                                button.style.borderColor =
                                    "#198754";

                                let productCard =
                                    form.closest(".product-card");

                                if (!productCard) {

                                    productCard =
                                        form.closest(".new-book-card");

                                }

                                const bookNameElement =
                                    productCard
                                        ?.querySelector(
                                            ".product-name, .new-book-name"
                                        );

                                const bookName =
                                    bookNameElement
                                        ?.innerText
                                        ?.trim();

                                showCartSuccess(
                                    'Đã thêm "' +
                                    (bookName || "sản phẩm") +
                                    '" vào giỏ hàng.'
                                );

                                setTimeout(function() {

                                    button.disabled =
                                        false;

                                    button.innerHTML =
                                        originalText;

                                    button.style.backgroundColor =
                                        originalBackground;

                                    button.style.borderColor =
                                        "";

                                }, 2000);

                            }
                            else {

                                button.disabled =
                                    false;

                                button.innerHTML =
                                    originalText;

                                button.style.backgroundColor =
                                    originalBackground;

                                button.style.borderColor =
                                    "";

                                showCartError(
                                    "Không thể thêm sản phẩm vào giỏ hàng."
                                );

                            }

                        }
                        catch (error) {

                            console.error(error);

                            button.disabled =
                                false;

                            button.innerHTML =
                                originalText;

                            button.style.backgroundColor =
                                originalBackground;

                            button.style.borderColor =
                                "";

                            showCartError(
                                "Có lỗi xảy ra khi thêm vào giỏ hàng."
                            );

                        }

                    }
                );

            });


        /* =====================================================
           THÔNG BÁO THÊM GIỎ HÀNG THÀNH CÔNG
           ===================================================== */

        function showCartSuccess(message) {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                message;

            warning.style.background =
                "#198754";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

                warning.style.background =
                    "#dc3545";

            }, 2000);

        }


        /* =====================================================
           THÔNG BÁO LỖI GIỎ HÀNG
           ===================================================== */

        function showCartError(message) {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                message;

            warning.style.background =
                "#dc3545";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           YÊU THÍCH
           ===================================================== */

        async function toggleFavorite(button) {

            const isAuthenticated =
                                @(User.Identity?.IsAuthenticated == true ? "true" : "false");

            if (!isAuthenticated) {

                showFavoriteLoginWarning();

                return;
            }

            const maSach =
                button.getAttribute("data-book-id");

            if (!maSach) {
                return;
            }

            const isFavorite =
                button.classList.contains("active");

            const tokenElement =
                document.querySelector(
                    '#favoriteTokenForm input[name="__RequestVerificationToken"]'
                );

            if (!tokenElement) {

                showFavoriteError(
                    "Không tìm thấy mã bảo mật."
                );

                return;
            }

            const token =
                tokenElement.value;

            const url =
                isFavorite
                    ? "/YeuThichs/Xoa"
                    : "/YeuThichs/Them";

            button.disabled =
                true;

            try {

                const formData =
                    new FormData();

                formData.append(
                    "maSach",
                    maSach
                );

                formData.append(
                    "__RequestVerificationToken",
                    token
                );

                const response =
                    await fetch(
                        url,
                        {
                            method: "POST",
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            },
                            body: formData
                        }
                    );

                if (!response.ok) {

                    throw new Error(
                        "Không thể cập nhật yêu thích."
                    );

                }

                const result =
                    await response.json();

                if (result.success &&
                    result.active === true) {

                    button.classList.add(
                        "active"
                    );

                    button.innerHTML =
                        "♥";

                    button.title =
                        "Bỏ yêu thích";

                    showFavoriteSuccess(
                        "Đã thêm sách vào danh sách yêu thích."
                    );

                }
                else if (result.success &&
                    result.active === false) {

                    button.classList.remove(
                        "active"
                    );

                    button.innerHTML =
                        "♡";

                    button.title =
                        "Thêm vào yêu thích";

                    showFavoriteSuccess(
                        "Đã bỏ sách khỏi danh sách yêu thích."
                    );

                }
                else {

                    throw new Error(
                        "Dữ liệu trả về không hợp lệ."
                    );

                }

            }
            catch (error) {

                console.error(
                    "Favorite error:",
                    error
                );

                showFavoriteError(
                    "Không thể cập nhật danh sách yêu thích."
                );

            }
            finally {

                button.disabled =
                    false;

            }

        }


        /* =====================================================
           THÔNG BÁO YÊU THÍCH THÀNH CÔNG
           ===================================================== */

        function showFavoriteSuccess(message) {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                message;

            warning.style.background =
                "#198754";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

                warning.style.background =
                    "#dc3545";

            }, 2000);

        }


        /* =====================================================
           THÔNG BÁO LỖI YÊU THÍCH
           ===================================================== */

        function showFavoriteError(message) {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                message;

            warning.style.background =
                "#dc3545";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           THÔNG BÁO ĐĂNG NHẬP YÊU THÍCH
           ===================================================== */

        function showFavoriteLoginWarning() {

            const warning =
                document.getElementById("loginWarning");

            if (!warning) {
                return;
            }

            warning.innerText =
                "Hãy đăng nhập để thêm sách vào danh sách yêu thích";

            warning.style.background =
                "#dc3545";

            warning.style.display =
                "block";

            setTimeout(function() {

                warning.style.display =
                    "none";

            }, 2000);

        }


        /* =====================================================
           SÁCH MỚI
           TỰ ĐỘNG CHẠY + KÉO CHUỘT
           ===================================================== */

        const newBooksSlider =
            document.querySelector(".new-books-slider");

        const newBooksTrack =
            document.querySelector(".new-books-track");

        if (newBooksSlider && newBooksTrack) {

            let position = 0;

            const speed = 0.5;

            let isMouseDown = false;
            let isHovering = false;

            let startX = 0;
            let startPosition = 0;


            function moveNewBooks() {

                if (!isMouseDown && !isHovering) {

                    position -= speed;

                    const firstSetWidth =
                        newBooksTrack.scrollWidth / 2;

                    if (Math.abs(position) >= firstSetWidth) {

                        position = 0;

                    }

                    newBooksTrack.style.transform =
                        "translateX(" +
                        position +
                        "px)";

                }

                requestAnimationFrame(
                    moveNewBooks
                );

            }


            newBooksSlider.addEventListener(
                "mouseenter",
                function() {

                    isHovering = true;

                }
            );


            newBooksSlider.addEventListener(
                "mouseleave",
                function() {

                    isHovering = false;

                    isMouseDown = false;

                }
            );


            newBooksSlider.addEventListener(
                "mousedown",
                function(event) {

                    isMouseDown = true;

                    startX =
                        event.clientX;

                    startPosition =
                        position;

                    newBooksSlider.style.cursor =
                        "grabbing";

                }
            );


            newBooksSlider.addEventListener(
                "mousemove",
                function(event) {

                    if (!isMouseDown) {
                        return;
                    }

                    const distance =
                        event.clientX - startX;

                    position =
                        startPosition + distance;

                    const firstSetWidth =
                        newBooksTrack.scrollWidth / 2;

                    if (position <= -firstSetWidth) {

                        position = 0;

                        startX =
                            event.clientX;

                        startPosition =
                            position;

                    }

                    if (position > 0) {

                        position = 0;

                        startX =
                            event.clientX;

                        startPosition =
                            position;

                    }

                    newBooksTrack.style.transform =
                        "translateX(" +
                        position +
                        "px)";

                }
            );


            document.addEventListener(
                "mouseup",
                function() {

                    if (!isMouseDown) {
                        return;
                    }

                    isMouseDown =
                        false;

                    newBooksSlider.style.cursor =
                        "grab";

                }
            );


            moveNewBooks();

        }

    </script>

}