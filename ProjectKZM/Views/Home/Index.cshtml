                                </div>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         THÔNG TIN SẢN PHẨM
                         ================================================= -->

                    <div class="product-info">


                        <!-- TÊN -->

                        <div class="product-name">
                            @item.TenSach
                        </div>


                        <!-- GIÁ -->

                        <div class="product-price">
                            @item.Gia.ToString("N0") ₫
                        </div>


                        <!-- TÌNH TRẠNG -->
                        @if (item.SoLuong > 0)
                        {
                            <div class="book-stock available">
                                Còn hàng
                            </div>
                        }
                        else
                        {
                            <div class="book-stock out-of-stock">
                                Hết hàng
                            </div>
                        }


                        <!-- THỂ LOẠI -->

                        <div class="product-categories">

                            @if (item.SachTheLoais != null &&
                                 item.SachTheLoais.Any())
                            {

                                @foreach (var st in item.SachTheLoais)
                                {

                                    if (st.TheLoai != null)
                                    {
                                        <a asp-controller="Home"
                                           asp-action="Index"
                                           asp-route-theLoaiIds="@st.MaTheLoai"
                                           class="category-badge"
                                           title="Lọc theo thể loại">

                                            @st.TheLoai.TenTheLoai

                                        </a>
                                    }

                                }

                            }
                            else
                            {
                                <span class="text-muted"
                                      style="font-size:12px;">

                                    Chưa có thể loại

                                </span>
                            }

                        </div>


                        <!-- =================================================
                             NÚT
                             ================================================= -->

                        <div class="product-button-group">


                            <!-- XEM SÁCH -->

                            <a asp-controller="Sachs"
                               asp-action="Details"
                               asp-route-id="@item.MaSach"
                               class="view-book-button">

                                Xem sách

                            </a>


                            <!-- GIỎ HÀNG -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {

                                <form asp-controller="GioHangs"
                                      asp-action="Them"
                                      method="post"
                                      class="add-cart-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="maSach"
                                           value="@item.MaSach" />

                                    <input type="hidden"
                                           name="soLuong"
                                           value="1" />

                                    @if (item.SoLuong > 0)
                                    {
                                        <button type="submit"
                                                class="cart-button">

                                            🛒 Bỏ vào giỏ hàng

                                        </button>
