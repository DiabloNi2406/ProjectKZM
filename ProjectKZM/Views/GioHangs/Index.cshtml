                );

            }


            /* =====================================================
               TĂNG / GIẢM SỐ LƯỢNG TRONG GIỎ
               ===================================================== */

            function bindQuantityForms() {

                document
                    .querySelectorAll(
                        ".cart-quantity-form"
                    )
                    .forEach(
                        function(form) {

                            if (
                                form.dataset.bound ===
                                "true"
                            ) {

                                return;

                            }


                            form.dataset.bound =
                                "true";


                            form.addEventListener(
                                "submit",
                                async function(event) {

                                    event.preventDefault();


                                    const card =
                                        form.closest(
                                            ".cart-item-card"
                                        );


                                    if (!card) {

                                        return;

                                    }


                                    const isIncrease =
                                        form.querySelector(
                                            ".quantity-increase-button"
                                        ) !== null;


                                    const isDecrease =
                                        form.querySelector(
                                            ".quantity-decrease-button"
                                        ) !== null;


                                    const bookName =
                                        card.dataset.bookName ||
                                        "Sản phẩm";


                                    const quantityElement =
                                        card.querySelector(
                                            ".cart-current-quantity"
                                        );


                                    let currentQuantity =
                                        parseInt(
                                            quantityElement?.innerText
                                        );


                                    if (
                                        isNaN(
                                            currentQuantity
                                        )
                                    ) {

                                        currentQuantity =
                                            0;

                                    }


                                    const maxQuantity =
                                        parseInt(
                                            card.dataset.max
                                        ) || 0;


                                    /* =================================
                                       TĂNG
                                       ================================= */

                                    if (isIncrease) {

                                        if (
                                            maxQuantity <= 0
                                        ) {

                                            showCartNotification(
                                                'Sản phẩm "' +
                                                bookName +
                                                '" đã hết hàng',
                                                "danger"
                                            );

                                            return;

                                        }


                                        if (
                                            currentQuantity >=
                                            maxQuantity
                                        ) {

                                            showCartNotification(
                                                'Sản phẩm "' +
                                                bookName +
                                                '" đã đạt đến giới hạn tồn kho',
                                                "warning"
                                            );

                                            return;

                                        }

                                    }


                                    /* =================================
                                       GIẢM
                                       ================================= */

                                    if (isDecrease) {

                                        if (
                                            currentQuantity <=
                                            1
                                        ) {

                                            const deleteForm =
                                                card.querySelector(
                                                    ".delete-cart-form"
                                                );


                                            if (!deleteForm) {

                                                return;

                                            }


                                            const deleteButton =
                                                deleteForm.querySelector(
                                                    "button"
                                                );


                                            if (deleteButton) {

                                                deleteButton.disabled =
                                                    true;

                                            }


                                            try {

                                                await submitAjaxForm(
                                                    deleteForm
                                                );


                                                animateRemoveCard(
                                                    card
                                                );

                                            }
                                            catch (error) {

                                                console.error(
                                                    error
                                                );


                                                if (deleteButton) {

                                                    deleteButton.disabled =
                                                        false;

                                                }


                                                showCartNotification(
                                                    "Không thể xóa sản phẩm.",
                                                    "danger"
                                                );

                                            }


                                            return;

                                        }

                                    }


                                    const button =
                                        form.querySelector(
                                            "button"
                                        );


                                    if (button) {

                                        button.disabled =
                                            true;

                                    }


                                    try {

                                        await submitAjaxForm(
                                            form
                                        );


                                        let newQuantity =
                                            currentQuantity;


                                        if (isIncrease) {

                                            newQuantity =
                                                currentQuantity + 1;

                                        }


                                        if (isDecrease) {

                                            newQuantity =
                                                currentQuantity - 1;

                                        }


                                        if (
                                            maxQuantity > 0 &&
                                            newQuantity >
                                            maxQuantity
                                        ) {

                                            newQuantity =
                                                maxQuantity;

                                        }


                                        if (
                                            newQuantity <
                                            1
                                        ) {

                                            newQuantity =
                                                1;

                                        }


                                        updateCardQuantity(
                                            card,
                                            newQuantity,
                                            maxQuantity
                                        );

                                    }
                                    catch (error) {

                                        console.error(
                                            error
                                        );


                                        showCartNotification(
                                            "Không thể cập nhật số lượng sản phẩm.",
                                            "danger"
                                        );

                                    }
                                    finally {

                                        if (button) {

                                            button.disabled =
                                                false;

                                        }

                                    }

                                }
                            );

                        }
                    );

            }


            /* =====================================================
               NÚT + / - SỐ LƯỢNG THANH TOÁN
               ===================================================== */

            function bindPaymentQuantityControls() {

                document
                    .querySelectorAll(
                        ".payment-quantity-control"
                    )
                    .forEach(
                        function(control) {

                            if (
                                control.dataset.bound ===
                                "true"
                            ) {

                                return;

                            }


                            control.dataset.bound =
                                "true";


                            const input =
                                control.querySelector(
                                    ".payment-quantity"
                                );


                            const minusButton =
                                control.querySelector(
                                    ".payment-minus"
                                );


                            const plusButton =
                                control.querySelector(
                                    ".payment-plus"
                                );


                            if (
                                !input ||
                                !minusButton ||
                                !plusButton
                            ) {

                                return;

                            }


                            const card =
                                control.closest(
                                    ".cart-item-card"
                                );


                            /* =================================
                               GIẢM
                               ================================= */

                            minusButton.addEventListener(
                                "click",
                                function() {

                                    if (
                                        minusButton.disabled
                                    ) {

                                        return;

                                    }


                                    let value =
                                        parseInt(
                                            input.value
                                        );


                                    if (
                                        isNaN(value)
                                    ) {

                                        value =
                                            1;

                                    }


                                    const min =
                                        parseInt(
                                            input.min
                                        );


                                    if (
                                        !isNaN(min) &&
                                        value >
                                        min
                                    ) {

                                        value--;

                                    }


                                    input.value =
                                        value;


                                    updateCartSummary();

                                }
                            );


                            /* =================================
                               TĂNG
                               ================================= */

                            plusButton.addEventListener(
                                "click",
                                function() {

                                    if (
                                        plusButton.disabled
                                    ) {

                                        return;

                                    }


                                    let value =
                                        parseInt(
                                            input.value
                                        );


                                    if (
                                        isNaN(value)
                                    ) {

                                        value =
                                            1;

                                    }


                                    const max =
                                        parseInt(
                                            input.max
                                        );


                                    if (
                                        isNaN(max) ||
                                        max <= 0
                                    ) {

                                        return;

                                    }


                                    if (
                                        value >=
                                        max
                                    ) {

                                        return;

                                    }


                                    value++;


                                    if (
                                        value >
                                        max
                                    ) {

                                        value =
                                            max;

                                    }


                                    input.value =
                                        value;


                                    updateCartSummary();

                                }
                            );


                            /* =================================
                               NHẬP TRỰC TIẾP
                               ================================= */

                            input.addEventListener(
                                "input",
                                function() {

                                    const stock =
                                        parseInt(
                                            card?.dataset.max
                                        ) || 0;


                                    if (
                                        stock <= 0
                                    ) {

                                        input.min =
                                            0;

                                        input.max =
                                            0;

                                        input.value =
                                            0;

                                        updateCartSummary();

                                        return;

                                    }


                                    let value =
                                        parseInt(
                                            input.value
                                        );


                                    if (
                                        isNaN(value)
                                    ) {

                                        value =
                                            1;

                                    }


                                    const min =
                                        parseInt(
                                            input.min
                                        ) || 1;


                                    const max =
                                        parseInt(
                                            input.max
                                        ) || 1;


                                    if (
                                        value <
                                        min
                                    ) {

                                        value =
                                            min;

                                    }


                                    if (
                                        value >
                                        max
                                    ) {

                                        value =
                                            max;

                                    }


                                    input.value =
                                        value;


                                    updateCartSummary();

                                }
                            );


                            input.addEventListener(
                                "change",
                                function() {

                                    const stock =
                                        parseInt(
                                            card?.dataset.max
                                        ) || 0;


                                    if (
                                        stock <= 0
                                    ) {

                                        input.min =
                                            0;

                                        input.max =
                                            0;

                                        input.value =
                                            0;

                                        updateCartSummary();

                                        return;

                                    }


                                    let value =
                                        parseInt(
                                            input.value
                                        );


                                    if (
                                        isNaN(value)
                                    ) {

                                        value =
                                            1;

                                    }


                                    const min =
                                        parseInt(
                                            input.min
                                        ) || 1;


                                    const max =
                                        parseInt(
                                            input.max
                                        ) || 1;


                                    if (
                                        value <
                                        min
                                    ) {

                                        value =
                                            min;

                                    }


                                    if (
                                        value >
                                        max
                                    ) {

                                        value =
                                            max;

                                    }


                                    input.value =
                                        value;


                                    updateCartSummary();

                                }
                            );

                        }
                    );

            }


