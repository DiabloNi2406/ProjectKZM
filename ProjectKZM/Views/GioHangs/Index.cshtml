                                        "none";


                                    if (selectAll) {

                                        selectAll.checked =
                                            false;

                                    }


                                    if (selectedQuantity) {

                                        selectedQuantity.innerText =
                                            "0";

                                    }


                                    if (selectedTotal) {

                                        selectedTotal.innerText =
                                            "0 đ";

                                    }


                                    if (selectedInfo) {

                                        selectedInfo.innerText =
                                            "Chưa chọn sản phẩm";

                                    }


                                    if (checkoutButton) {

                                        checkoutButton.disabled =
                                            true;

                                    }


                                    if (checkoutItems) {

                                        checkoutItems.innerHTML =
                                            "";

                                    }

                                },
                                320
                            );

                        }
                        catch (error) {

                            console.error(
                                error
                            );


                            if (button) {

                                button.disabled =
                                    false;

                            }


                            showCartNotification(
                                "Không thể xóa toàn bộ giỏ hàng.",
                                "danger"
                            );

                        }

                    }
                );

            }


            /* =====================================================
               CHỌN TẤT CẢ
               ===================================================== */

            if (selectAll) {

                selectAll.addEventListener(
                    "change",
                    function() {

                        getProductChecks().forEach(
                            function(checkbox) {

                                checkbox.checked =
                                    selectAll.checked;

                            }
                        );


                        updateCartSummary();

                    }
                );

            }


            /* =====================================================
               KIỂM TRA TỒN KHO MỚI NHẤT
               ===================================================== */

            async function getFreshStockSnapshot() {

                try {

                    const response =
                        await fetch(
                            window.location.href,
                            {
                                method: "GET",
                                cache: "no-store",
                                headers: {
                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                }
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Không thể kiểm tra tồn kho."
                        );

                    }


                    const html =
                        await response.text();


                    const parser =
                        new DOMParser();


                    const doc =
                        parser.parseFromString(
                            html,
                            "text/html"
                        );


                    const freshCards =
                        doc.querySelectorAll(
                            ".cart-item-card"
                        );


                    const stockMap =
                        new Map();


                    freshCards.forEach(
                        function(card) {

                            const maSach =
                                card.dataset.maSach;


                            const bookName =
                                card.dataset.bookName ||
                                "Sản phẩm";


                            const stock =
                                parseInt(
                                    card.dataset.max
                                ) || 0;


                            const cartQuantityElement =
                                card.querySelector(
                                    ".cart-current-quantity"
                                );


                            const cartQuantity =
                                parseInt(
                                    cartQuantityElement?.innerText
                                ) || 0;


                            if (maSach) {

                                stockMap.set(
                                    String(maSach),
                                    {
                                        stock: stock,
                                        bookName: bookName,
                                        cartQuantity: cartQuantity
                                    }
                                );

                            }

                        }
                    );


                    return stockMap;

                }
                catch (error) {

                    console.error(
                        error
                    );


                    showCartNotification(
                        "Không thể kiểm tra số lượng sản phẩm trong kho.",
                        "danger"
                    );


                    return null;

                }

            }


            /* =====================================================
               THANH TOÁN
               ===================================================== */

            const checkoutForm =
                document.getElementById(
                    "checkoutForm"
                );


            if (checkoutForm) {

                checkoutForm.addEventListener(
                    "submit",
                    async function(event) {

                        event.preventDefault();


                        if (checkoutButton) {

                            checkoutButton.disabled =
                                true;

                        }


                        checkoutItems.innerHTML =
                            "";


                        let hasSelected =
                            false;


                        getProductChecks().forEach(
                            function(checkbox) {

                                if (
                                    checkbox.checked
                                ) {

                                    hasSelected =
                                        true;

                                }

                            }
                        );


                        if (!hasSelected) {

                            showCartNotification(
                                "Vui lòng chọn ít nhất một sản phẩm để thanh toán.",
                                "danger"
                            );


                            if (checkoutButton) {

                                checkoutButton.disabled =
                                    false;

                            }


                            return;

                        }


                        const freshStockMap =
                            await getFreshStockSnapshot();


                        if (!freshStockMap) {

                            if (checkoutButton) {

                                checkoutButton.disabled =
                                    false;

                            }


                            return;

                        }


                        const selectedCheckoutItems =
                            [];


                        let hasStockChanged =
                            false;


                        let hasOutOfStock =
                            false;


                        getProductChecks().forEach(
                            function(checkbox) {

                                if (
                                    !checkbox.checked
                                ) {

                                    return;

                                }


                                const card =
                                    checkbox.closest(
                                        ".cart-item-card"
                                    );


                                if (!card) {

                                    return;

                                }


                                const maSach =
                                    checkbox.dataset.maSach;


                                const bookName =
                                    card.dataset.bookName ||
                                    "Sản phẩm";


                                const freshStock =
                                    freshStockMap.get(
                                        String(maSach)
                                    );


                                if (!freshStock) {

                                    hasStockChanged =
                                        true;

                                    hasOutOfStock =
                                        true;


                                    updateFreshStockOnCard(
                                        card,
                                        0,
                                        true
                                    );


                                    showCartNotification(
                                        'Sản phẩm "' +
                                        bookName +
                                        '" đã hết hàng',
                                        "danger"
                                    );


                                    return;

                                }


                                const freshStockQuantity =
                                    parseInt(
                                        freshStock.stock
                                    ) || 0;


                                const displayedStock =
                                    parseInt(
                                        card.dataset.max
                                    ) || 0;


                                if (
                                    displayedStock !==
                                    freshStockQuantity
                                ) {

                                    hasStockChanged =
                                        true;


                                    updateFreshStockOnCard(
                                        card,
                                        freshStockQuantity,
                                        true
                                    );


                                    if (
                                        freshStockQuantity <= 0
                                    ) {

                                        hasOutOfStock =
                                            true;


                                        showCartNotification(
                                            'Sản phẩm "' +
                                            freshStock.bookName +
                                            '" đã hết hàng',
                                            "danger"
                                        );

                                    }
                                    else {

                                        showCartNotification(
                                            'Sản phẩm "' +
                                            freshStock.bookName +
                                            '" vừa thay đổi số lượng hàng tồn',
                                            "warning"
                                        );

                                    }


                                    return;

                                }


                                updateFreshStockOnCard(
                                    card,
                                    freshStockQuantity,
                                    false
                                );


                                const paymentInput =
                                    card.querySelector(
                                        ".payment-quantity"
                                    );


                                let soLuong =
                                    parseInt(
                                        paymentInput?.value
                                    );


                                if (
                                    isNaN(
                                        soLuong
                                    )
                                ) {

                                    soLuong =
                                        0;

                                }


                                /*
                                 * Nếu hết hàng:
                                 * đưa cả 2 ô về 0,
                                 * không thanh toán.
                                 */

                                if (
                                    freshStockQuantity <= 0
                                ) {

                                    hasOutOfStock =
                                        true;


                                    updateFreshStockOnCard(
                                        card,
                                        0,
                                        true
                                    );


                                    showCartNotification(
                                        'Sản phẩm "' +
                                        freshStock.bookName +
                                        '" đã hết hàng',
                                        "danger"
                                    );


                                    return;

                                }


                                /*
                                 * Nếu còn hàng,
                                 * số lượng thanh toán tối thiểu = 1.
                                 */

                                if (
                                    soLuong <
                                    1
                                ) {

                                    soLuong =
                                        1;


                                    paymentInput.value =
                                        1;

                                }


                                if (
                                    soLuong >
                                    freshStockQuantity
                                ) {

                                    hasOutOfStock =
                                        true;


                                    paymentInput.max =
                                        freshStockQuantity;


                                    paymentInput.value =
                                        freshStockQuantity;


                                    updateCartSummary();


                                    showCartNotification(
                                        'Sản phẩm "' +
                                        freshStock.bookName +
                                        '" đã hết hàng',
                                        "danger"
                                    );


                                    return;

                                }


                                selectedCheckoutItems.push({
                                    maSach: maSach,
                                    soLuong: soLuong
                                });

                            }
                        );


                        if (hasOutOfStock) {

                            updateCartSummary();


                            if (checkoutButton) {

                                checkoutButton.disabled =
                                    false;

                            }


                            return;

                        }


                        if (hasStockChanged) {

                            updateCartSummary();


                            if (checkoutButton) {

                                checkoutButton.disabled =
                                    false;

                            }


                            return;

                        }


                        if (
                            selectedCheckoutItems.length === 0
                        ) {

                            showCartNotification(
                                "Vui lòng chọn ít nhất một sản phẩm để thanh toán.",
                                "danger"
                            );


                            if (checkoutButton) {

                                checkoutButton.disabled =
                                    false;

                            }


                            return;

                        }


                        selectedCheckoutItems.forEach(
                            function(item) {

                                const maSachInput =
                                    document.createElement(
                                        "input"
                                    );


                                maSachInput.type =
                                    "hidden";

                                maSachInput.name =
                                    "maSach";

                                maSachInput.value =
                                    item.maSach;


                                checkoutItems.appendChild(
                                    maSachInput
                                );


                                const soLuongInput =
                                    document.createElement(
                                        "input"
                                    );


                                soLuongInput.type =
                                    "hidden";

                                soLuongInput.name =
                                    "soLuong";

                                soLuongInput.value =
                                    item.soLuong;


                                checkoutItems.appendChild(
                                    soLuongInput
                                );

                            }
                        );


                        checkoutForm.submit();

                    }
                );

            }


            /* =====================================================
               KHỞI TẠO
               ===================================================== */

            bindCheckboxes();

            bindQuantityForms();

            bindPaymentQuantityControls();

            bindDeleteForms();

            updateCartSummary();


            document
                .querySelectorAll(
                    ".cart-item-card"
                )
                .forEach(
                    function(card) {

                        const stock =
                            parseInt(
                                card.dataset.max
                            ) || 0;


                        const currentQuantity =
                            parseInt(
                                card.querySelector(
                                    ".cart-current-quantity"
                                )?.innerText
                            );


                        /*
                         * Hết hàng ngay từ lúc load:
                         * cả hai ô đều về 0.
                         */

                        if (stock <= 0) {

                            updateFreshStockOnCard(
                                card,
                                0,
                                true
                            );

                        }
                        else {

                            updateFreshStockOnCard(
                                card,
                                stock,
                                false,
                                isNaN(currentQuantity)
                                    ? 1
                                    : currentQuantity
                            );

                        }

                    }
                );

        });

    </script>

}