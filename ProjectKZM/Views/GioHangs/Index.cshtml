            /* =====================================================
               CẬP NHẬT CARD SAU TĂNG / GIẢM
               ===================================================== */

            function updateCardQuantity(
                card,
                newQuantity,
                stock
            ) {

                if (!card) {
                    return;
                }


                const quantityElement =
                    card.querySelector(
                        ".cart-current-quantity"
                    );


                if (quantityElement) {

                    quantityElement.innerText =
                        newQuantity;

                }


                const paymentInput =
                    card.querySelector(
                        ".payment-quantity"
                    );


                if (paymentInput) {

                    if (stock <= 0) {

                        paymentInput.min =
                            0;

                        paymentInput.max =
                            0;

                        paymentInput.value =
                            0;

                    }
                    else {

                        paymentInput.min =
                            1;

                        paymentInput.max =
                            newQuantity;


                        let paymentQuantity =
                            parseInt(
                                paymentInput.value
                            );


                        if (isNaN(paymentQuantity)) {

                            paymentQuantity =
                                1;

                        }


                        if (
                            paymentQuantity >
                            newQuantity
                        ) {

                            paymentInput.value =
                                newQuantity;

                        }


                        if (
                            paymentQuantity <
                            1
                        ) {

                            paymentInput.value =
                                1;

                        }

                    }

                }


                const price =
                    parseFloat(
                        card.dataset.price
                    ) || 0;


                const totalElement =
                    card.querySelector(
                        ".cart-item-total"
                    );


                if (totalElement) {

                    totalElement.innerText =
                        (
                            price *
                            newQuantity
                        ).toLocaleString(
                            "vi-VN"
                        ) + " đ";

                }


                updateFreshStockOnCard(
                    card,
                    stock,
                    false,
                    newQuantity
                );


                updateCartSummary();

            }


            /* =====================================================
               CẬP NHẬT TỒN KHO MỚI
               ===================================================== */

            function updateFreshStockOnCard(
                card,
                freshStock,
                resetPaymentQuantity,
                currentCartQuantityOverride
            ) {

                if (!card) {
                    return;
                }


                const stock =
                    parseInt(freshStock) || 0;


                card.dataset.max =
                    Math.max(
                        0,
                        stock
                    );


                const quantityElement =
                    card.querySelector(
                        ".cart-current-quantity"
                    );


                let currentCartQuantity =
                    parseInt(
                        quantityElement?.innerText
                    );


                if (
                    isNaN(
                        currentCartQuantity
                    )
                ) {

                    currentCartQuantity =
                        0;

                }


                if (
                    currentCartQuantityOverride !== undefined &&
                    currentCartQuantityOverride !== null
                ) {

                    currentCartQuantity =
                        parseInt(
                            currentCartQuantityOverride
                        );


                    if (
                        isNaN(
                            currentCartQuantity
                        )
                    ) {

                        currentCartQuantity =
                            0;

                    }

                }


                /* =================================================
                   HẾT HÀNG
                   ================================================= */

                if (stock <= 0) {

                    currentCartQuantity =
                        0;


                    if (quantityElement) {

                        quantityElement.innerText =
                            0;

                    }


                    const paymentInput =
                        card.querySelector(
                            ".payment-quantity"
                        );


                    if (paymentInput) {

                        paymentInput.min =
                            0;

                        paymentInput.max =
                            0;

                        paymentInput.value =
                            0;

                    }


                    const stockStatus =
                        card.querySelector(
                            ".cart-stock-status"
                        );


                    if (stockStatus) {

                        stockStatus.innerText =
                            "Hết hàng";

                        stockStatus.classList.remove(
                            "text-success"
                        );

                        stockStatus.classList.add(
                            "text-danger"
                        );

                    }


                    const imageWrapper =
                        card.querySelector(
                            ".cart-product-image-wrapper"
                        );


                    if (imageWrapper) {

                        const oldOverlay =
                            imageWrapper.querySelector(
                                ".cart-product-out-of-stock-overlay"
                            );


                        if (!oldOverlay) {

                            const overlay =
                                document.createElement(
                                    "div"
                                );


                            overlay.className =
                                "cart-product-out-of-stock-overlay";


                            const overlayText =
                                document.createElement(
                                    "div"
                                );


                            overlayText.className =
                                "cart-product-out-of-stock-text";


                            overlayText.innerText =
                                "Hết Hàng";


                            overlay.appendChild(
                                overlayText
                            );


                            imageWrapper.appendChild(
                                overlay
                            );

                        }

                    }


                    const topPlus =
                        card.querySelector(
                            ".quantity-increase-button"
                        );


                    const topMinus =
                        card.querySelector(
                            ".quantity-decrease-button"
                        );


                    if (topPlus) {

                        topPlus.disabled =
                            false;

                    }


                    if (topMinus) {

                        topMinus.disabled =
                            false;

                    }


                    const paymentMinus =
                        card.querySelector(
                            ".payment-minus"
                        );


                    const paymentPlus =
                        card.querySelector(
                            ".payment-plus"
                        );


                    if (paymentMinus) {

                        paymentMinus.disabled =
                            true;

                    }


                    if (paymentPlus) {

                        paymentPlus.disabled =
                            true;

                    }


                    const totalElement =
                        card.querySelector(
                            ".cart-item-total"
                        );


                    if (totalElement) {

                        totalElement.innerText =
                            "0 đ";

                    }


                    return;

                }


                /* =================================================
                   CÒN HÀNG
                   ================================================= */

                if (
                    currentCartQuantity >
                    stock
                ) {

                    currentCartQuantity =
                        stock;


                    if (quantityElement) {

                        quantityElement.innerText =
                            stock;

                    }

                }


                if (
                    currentCartQuantity <
                    1
                ) {

                    currentCartQuantity =
                        1;


                    if (quantityElement) {

                        quantityElement.innerText =
                            1;

                    }

                }


                const price =
                    parseFloat(
                        card.dataset.price
                    ) || 0;


                const totalElement =
                    card.querySelector(
                        ".cart-item-total"
                    );


                if (totalElement) {

                    totalElement.innerText =
                        (
                            price *
                            currentCartQuantity
                        ).toLocaleString(
                            "vi-VN"
                        ) + " đ";

                }


                const stockStatus =
                    card.querySelector(
                        ".cart-stock-status"
                    );


                if (stockStatus) {

                    stockStatus.innerText =
                        "Còn hàng";

                    stockStatus.classList.remove(
                        "text-danger"
                    );

                    stockStatus.classList.add(
                        "text-success"
                    );

                }


                const imageWrapper =
                    card.querySelector(
                        ".cart-product-image-wrapper"
                    );


                if (imageWrapper) {

                    const oldOverlay =
                        imageWrapper.querySelector(
                            ".cart-product-out-of-stock-overlay"
                        );


                    if (oldOverlay) {

                        oldOverlay.remove();

                    }

                }


                const paymentInput =
                    card.querySelector(
                        ".payment-quantity"
                    );


                if (paymentInput) {

                    paymentInput.min =
                        1;

                    paymentInput.max =
                        currentCartQuantity;


                    let paymentQuantity =
                        parseInt(
                            paymentInput.value
                        );


                    if (
                        isNaN(
                            paymentQuantity
                        )
                    ) {

                        paymentQuantity =
                            1;

                    }


                    if (
                        paymentQuantity <
                        1
                    ) {

                        paymentInput.value =
                            1;

                    }


                    if (
                        paymentQuantity >
                        currentCartQuantity
                    ) {

                        paymentInput.value =
                            currentCartQuantity;

                    }

                }


                const topMinus =
                    card.querySelector(
                        ".quantity-decrease-button"
                    );


                const topPlus =
                    card.querySelector(
                        ".quantity-increase-button"
                    );


                if (topMinus) {

                    topMinus.disabled =
                        false;

                }


                if (topPlus) {

                    topPlus.disabled =
                        false;

                }


                const paymentMinus =
                    card.querySelector(
                        ".payment-minus"
                    );


                const paymentPlus =
                    card.querySelector(
                        ".payment-plus"
                    );


                if (paymentMinus) {

                    paymentMinus.disabled =
                        false;

                }


                if (paymentPlus) {

                    paymentPlus.disabled =
                        false;

                }

            }


            /* =====================================================
               AJAX FORM
               ===================================================== */

            async function submitAjaxForm(form) {

                const response =
                    await fetch(
                        form.action,
                        {
                            method: "POST",
                            body: new FormData(form),
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Request failed"
                    );

                }


                return response;

            }


            /* =====================================================
               XÓA CARD KHÔNG RELOAD
               ===================================================== */

            function animateRemoveCard(card) {

                if (!card) {
                    return;
                }


                const height =
                    card.offsetHeight;


                card.style.maxHeight =
                    height + "px";


                card.offsetHeight;


                card.classList.add(
                    "removing"
                );


                setTimeout(
                    function() {

                        card.remove();

                        bindCheckboxes();

                        updateCartSummary();


                        const remainingCards =
                            document.querySelectorAll(
                                ".cart-item-card"
                            );


                        if (
                            remainingCards.length ===
                            0
                        ) {

                            const container =
                                document.getElementById(
                                    "cartItemsContainer"
                                );


                            if (container) {

                                container.innerHTML =
                                    `
                                                    <div class="text-center py-5">

                                                        <div style="font-size:70px;">
                                                            🛒
                                                        </div>

                                                        <h4 class="mt-3">
                                                            Giỏ hàng đang trống
                                                        </h4>

                                                        <p class="text-muted">
                                                            Bạn chưa có sản phẩm nào trong giỏ hàng.
                                                        </p>

                                                        <a href="/Home/Index"
                                                           class="btn btn-success mt-2">

                                                            Xem sản phẩm

                                                        </a>

                                                    </div>
                                                    `;

                            }


                            const deleteAllForm =
                                document.getElementById(
                                    "deleteAllCartForm"
                                );


                            if (deleteAllForm) {

                                deleteAllForm.style.display =
                                    "none";

                            }

                        }

                    },
