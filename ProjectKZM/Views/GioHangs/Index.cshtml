@model ProjectKZM.Models.GioHang

@{
    ViewData["Title"] = "Giỏ hàng";
}

<style>

    /* =========================================================
                                           CHECKBOX
                                           ========================================================= */

    .cart-check {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }


    /* =========================================================
                                           SỐ LƯỢNG THANH TOÁN
                                           ========================================================= */

    .payment-quantity-control {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

    .payment-quantity-button {
        width: 28px;
        height: 28px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #ced4da;
        background: white;
        color: #212529;
        border-radius: 5px;
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        transition: 0.15s;
    }

        .payment-quantity-button:hover {
            background: #212529;
            color: white;
            border-color: #212529;
        }

        .payment-quantity-button:active {
            transform: scale(0.95);
        }

        .payment-quantity-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .payment-quantity {
        width: 50px;
        height: 28px;
        text-align: center;
        border: 1px solid #ced4da;
        border-radius: 5px;
        font-size: 14px;
        padding: 3px 5px;
    }

        .payment-quantity::-webkit-outer-spin-button,
        .payment-quantity::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .payment-quantity[type=number] {
            -moz-appearance: textfield;
        }


    /* =========================================================
                                           CARD SẢN PHẨM
                                           ========================================================= */

    .cart-item-card {
        transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease, margin 0.3s ease, padding 0.3s ease;
        overflow: hidden;
    }

        .cart-item-card.selected {
            border: 2px solid #198754;
        }

        .cart-item-card.removing {
            opacity: 0;
            transform: translateX(60px);
            max-height: 0 !important;
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }


    /* =========================================================
                                           THÔNG TIN ĐÃ CHỌN
                                           ========================================================= */

    .selected-info {
        font-size: 14px;
        color: #666;
    }


    /* =========================================================
                                           BUTTON THANH TOÁN
                                           ========================================================= */

    .checkout-button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }


    /* =========================================================
                                           CHỌN TẤT CẢ
                                           ========================================================= */

    .select-all-area {
        background: #f8f9fa;
        border-radius: 6px;
        padding: 10px 15px;
        margin-bottom: 15px;
    }


    /* =========================================================
                                           THÔNG BÁO
                                           ========================================================= */

    .cart-notification-container {
        position: fixed;
        top: 25px;
        right: 25px;
        width: min(420px, calc(100vw - 50px));
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: flex-start;
        gap: 10px;
        pointer-events: none;
        overflow: visible;
    }

    .cart-notification {
        min-width: 280px;
        max-width: 420px;
        width: fit-content;
        color: white;
        padding: 14px 22px;
        border-radius: 7px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        display: block;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.4;
        pointer-events: none;
        flex: 0 0 auto;
        animation: cartNotificationIn 0.25s ease;
        box-sizing: border-box;
    }

        .cart-notification.hiding {
            animation: cartNotificationOut 0.25s ease forwards;
        }

    @@keyframes cartNotificationIn {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes cartNotificationOut {
        from {
            opacity: 1;
            transform: translateX(0);
        }

        to {
            opacity: 0;
            transform: translateX(30px);
        }
    }


    /* =========================================================
                                           OVERLAY HẾT HÀNG
                                           ========================================================= */

    .cart-product-image-wrapper {
        position: relative;
        display: inline-block;
        width: 90px;
        height: 120px;
    }

        .cart-product-image-wrapper img {
            width: 90px;
            height: 120px;
            object-fit: cover;
            border-radius: 6px;
            display: block;
        }

    .cart-product-out-of-stock-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.58);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }

    .cart-product-out-of-stock-text {
        color: white;
        font-size: 16px;
        font-weight: 600;
        text-align: center;
        line-height: 1.2;
    }

</style>


<div class="container py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="mb-0">
            🛒 Giỏ hàng
        </h2>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">

            ← Tiếp tục mua hàng

        </a>

    </div>


    <!-- =========================================================
         THÔNG BÁO
         ========================================================= -->

    <div id="cartNotification"
         class="cart-notification-container">
    </div>


    <!-- =========================================================
         GIỎ HÀNG
         ========================================================= -->
    @if (Model == null ||
                         Model.ChiTietGioHangs == null ||
                         !Model.ChiTietGioHangs.Any())
    {
        <div class="row"
             id="cartMainContent">

            <div class="col-lg-8">

                <div class="select-all-area">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <input type="checkbox"
                                   id="selectAll"
                                   class="cart-check" />

                            <label for="selectAll"
                                   class="fw-bold ms-2"
                                   style="cursor:pointer;">

                                Chọn tất cả

                            </label>

                        </div>

                        <span class="selected-info"
                              id="selectedInfo">

                            Chưa chọn sản phẩm

                        </span>

                    </div>

                </div>


                <div id="cartItemsContainer">

                    <div class="text-center py-5"
                         id="emptyCartMessage">

                        <div style="font-size:70px;">
                            🛒
                        </div>

                        <h4 class="mt-3">
                            Giỏ hàng đang trống
                        </h4>

                        <p class="text-muted">
                            Bạn chưa có sản phẩm nào trong giỏ hàng.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-success mt-2">

                            Xem sản phẩm

                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h4 class="mb-4">
                            Tổng đơn hàng
                        </h4>


                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Số lượng sản phẩm:
                            </span>

                            <strong id="selectedQuantity">
                                0
                            </strong>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between mb-4">

                            <span>
                                Tổng tiền:
                            </span>

                            <strong class="text-danger fs-5"
                                    id="selectedTotal">

                                0 đ

                            </strong>

                        </div>


                        <form asp-controller="GioHangs"
                              asp-action="ThanhToan"
                              method="post"
                              id="checkoutForm">

                            @Html.AntiForgeryToken()

                            <div id="checkoutItems">
                            </div>

                            <button type="submit"
                                    class="btn btn-success w-100 checkout-button"
                                    id="checkoutButton"
                                    disabled>

                                Thanh toán sản phẩm đã chọn

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="row"
             id="cartMainContent">

            <div class="col-lg-8">

                <div class="select-all-area">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <input type="checkbox"
                                   id="selectAll"
                                   class="cart-check" />

                            <label for="selectAll"
                                   class="fw-bold ms-2"
                                   style="cursor:pointer;">

                                Chọn tất cả

                            </label>

                        </div>

                        <span class="selected-info"
                              id="selectedInfo">

                            Chưa chọn sản phẩm

                        </span>

                    </div>

                </div>


                <div id="cartItemsContainer">

                    @foreach (var item in Model.ChiTietGioHangs)
                    {
                        var sachHetHang =
                            item.Sach == null ||
                            item.Sach.SoLuong <= 0;

                        var tenSach =
                            item.Sach?.TenSach ?? "Sản phẩm";

                        var tonKho =
                            item.Sach?.SoLuong ?? 0;

                        <div class="card mb-3 shadow-sm cart-item-card"
                             data-price="@(item.Sach?.Gia ?? 0)"
                             data-max="@Math.Max(0, tonKho)"
                             data-ma-sach="@item.MaSach"
                             data-book-name="@tenSach">

                            <div class="card-body">

                                <div class="row align-items-center">

                                    <!-- =================================
                                         CHECKBOX
                                         ================================= -->

                                    <div class="col-md-1 text-center">

                                        <input type="checkbox"
                                               class="cart-check product-check"
                                               data-ma-sach="@item.MaSach" />

                                    </div>


                                    <!-- =================================
                                         HÌNH ẢNH
                                         ================================= -->

                                    <div class="col-md-2 text-center">

                                        @if (item.Sach != null &&
                                             !string.IsNullOrEmpty(item.Sach.Hinh))
                                        {
                                            <div class="cart-product-image-wrapper">

                                                <img src="@item.Sach.Hinh"
                                                     alt="@item.Sach.TenSach" />

                                                @if (sachHetHang)
                                                {
                                                    <div class="cart-product-out-of-stock-overlay">

                                                        <div class="cart-product-out-of-stock-text">
                                                            Hết Hàng
                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cart-product-image-wrapper"
                                                 style="
                                                background:#eee;
                                                display:flex;
                                                align-items:center;
                                                justify-content:center;
                                                border-radius:6px;
                                                ">

                                                <span style="font-size:12px;color:#777;">
                                                    Không có ảnh
                                                </span>

                                                @if (sachHetHang)
                                                {
                                                    <div class="cart-product-out-of-stock-overlay">

                                                        <div class="cart-product-out-of-stock-text">
                                                            Hết Hàng
                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>


                                    <!-- =================================
                                         THÔNG TIN SẢN PHẨM
                                         ================================= -->

                                    <div class="col-md-3">

                                        <h5 class="mb-2">
                                            @tenSach
                                        </h5>


                                        @if (item.Sach != null)
                                        {
                                            <div class="text-muted small">

                                                @if (!string.IsNullOrEmpty(item.Sach.TacGia))
                                                {
                                                    <div>
                                                        Tác giả:
                                                        @item.Sach.TacGia
                                                    </div>
                                                }

                                                <div>

                                                    Giá:

                                                    <strong class="text-danger">

                                                        @item.Sach.Gia.ToString("N0") đ

                                                    </strong>

                                                </div>

                                            </div>
                                        }

                                    </div>


                                    <!-- =================================
                                         SỐ LƯỢNG TRONG GIỎ
                                         ================================= -->

                                    <div class="col-md-3">

                                        <div class="d-flex align-items-center justify-content-center">

                                            <!-- GIẢM -->

                                            <form asp-controller="GioHangs"
                                                  asp-action="Giam"
                                                  method="post"
                                                  class="m-0 cart-quantity-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="maGioHang"
                                                       value="@Model.MaGioHang" />

                                                <input type="hidden"
                                                       name="maSach"
                                                       value="@item.MaSach" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary quantity-decrease-button"
                                                        title="Giảm số lượng">

                                                    −

                                                </button>

                                            </form>


                                            <!-- SỐ LƯỢNG -->

                                            <span class="mx-3 fw-bold cart-current-quantity"
                                                  style="
                                                min-width:30px;
                                                text-align:center;
                                                ">

                                                @item.SoLuong

                                            </span>


                                            <!-- TĂNG -->

                                            <form asp-controller="GioHangs"
                                                  asp-action="Tang"
                                                  method="post"
                                                  class="m-0 cart-quantity-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="maGioHang"
                                                       value="@Model.MaGioHang" />

                                                <input type="hidden"
                                                       name="maSach"
                                                       value="@item.MaSach" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary quantity-increase-button"
                                                        title="Tăng số lượng">

                                                    +

                                                </button>

                                            </form>

                                        </div>


                                        <!-- =================================
                                             SỐ LƯỢNG MUỐN THANH TOÁN
                                             ================================= -->

                                        <div class="text-center mt-3">

                                            <small class="text-muted d-block mb-2">

                                                Số lượng thanh toán:

                                            </small>

                                            <div class="payment-quantity-control">

                                                <button type="button"
                                                        class="payment-quantity-button payment-minus"
                                                        title="Giảm số lượng">

                                                    −

                                                </button>

                                                <input type="number"
                                                       class="payment-quantity"
                                                       value="1"
                                                       min="1"
                                                       max="@Math.Max(1, item.SoLuong)"
                                                       data-ma-sach="@item.MaSach" />

                                                <button type="button"
                                                        class="payment-quantity-button payment-plus"
                                                        title="Tăng số lượng">

                                                    +

                                                </button>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- =================================
                                         THÀNH TIỀN + TÌNH TRẠNG
                                         ================================= -->

                                    <div class="col-md-2 text-center">

                                        @if (item.Sach != null)
                                        {
                                            <strong class="text-danger d-block cart-item-total">

                                                @((item.Sach.Gia * item.SoLuong).ToString("N0")) đ

                                            </strong>


                                            @if (item.Sach.SoLuong > 0)
                                            {
                                                <div class="text-success small mt-1 cart-stock-status">

                                                    Còn hàng

                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-danger small mt-1 cart-stock-status">

                                                    Hết hàng

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <strong class="text-danger d-block cart-item-total">

                                                0 đ

                                            </strong>

                                            <div class="text-danger small mt-1 cart-stock-status">

                                                Sản phẩm không tồn tại

                                            </div>
                                        }

                                    </div>


                                    <!-- =================================
                                         XÓA
                                         ================================= -->

                                    <div class="col-md-1 text-end">

                                        <form asp-controller="GioHangs"
                                              asp-action="Xoa"
                                              method="post"
                                              class="delete-cart-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="maGioHang"
                                                   value="@Model.MaGioHang" />

                                            <input type="hidden"
                                                   name="maSach"
                                                   value="@item.MaSach" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger"
                                                    title="Xóa">

                                                🗑

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- =================================================
                     XÓA TOÀN BỘ
                     ================================================= -->

                <div class="text-end mt-3">

                    <form asp-controller="GioHangs"
                          asp-action="XoaTatCa"
                          method="post"
                          id="deleteAllCartForm">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger">

                            🗑 Xóa toàn bộ giỏ hàng

                        </button>

                    </form>

                </div>

            </div>


            <!-- =====================================================
                 TỔNG ĐƠN HÀNG
                 ===================================================== -->

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h4 class="mb-4">
                            Tổng đơn hàng
                        </h4>


                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Số lượng sản phẩm:
                            </span>

                            <strong id="selectedQuantity">
                                0
                            </strong>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between mb-4">

                            <span>
                                Tổng tiền:
                            </span>

                            <strong class="text-danger fs-5"
                                    id="selectedTotal">

                                0 đ

                            </strong>

                        </div>


                        <form asp-controller="GioHangs"
                              asp-action="ThanhToan"
                              method="post"
                              id="checkoutForm">

                            @Html.AntiForgeryToken()

                            <div id="checkoutItems">
                            </div>

                            <button type="submit"
                                    class="btn btn-success w-100 checkout-button"
                                    id="checkoutButton"
                                    disabled>

                                Thanh toán sản phẩm đã chọn

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            /* =====================================================
               ELEMENT
               ===================================================== */

            const selectAll =
                document.getElementById("selectAll");

            const selectedQuantity =
                document.getElementById("selectedQuantity");

            const selectedTotal =
                document.getElementById("selectedTotal");

            const selectedInfo =
                document.getElementById("selectedInfo");

            const checkoutButton =
                document.getElementById("checkoutButton");

            const checkoutItems =
                document.getElementById("checkoutItems");

            const cartNotification =
                document.getElementById("cartNotification");


            /* =====================================================
               HỆ THỐNG THÔNG BÁO
               - Mỗi thông báo xử lý theo thứ tự
               - Thời gian: 3 giây
               - Không xóa thông báo mới
               - Có thể chồng lên nhau
               ===================================================== */

            let notificationQueue = [];

            let notificationProcessing =
                false;


            function showCartNotification(message, type) {

                if (!cartNotification) {
                    return;
                }


                const notification =
                    document.createElement("div");

                notification.className =
                    "cart-notification";

                notification.innerText =
                    message;


                /* =========================================
                   MÀU ĐỎ
                   ========================================= */

                if (type === "danger") {

                    notification.style.background =
                        "#dc3545";

                    notification.style.color =
                        "#fff";

                }


                /* =========================================
                   MÀU VÀNG
                   ========================================= */

                else if (type === "warning") {

                    notification.style.background =
                        "#ffc107";

                    notification.style.color =
                        "#212529";

                }


                /* =========================================
                   MÀU XANH
                   ========================================= */

                else {

                    notification.style.background =
                        "#198754";

                    notification.style.color =
                        "#fff";

                }


                /*
                 * Đưa thông báo vào hàng đợi.
                 */

                notificationQueue.push(
                    notification
                );


                /*
                 * Thông báo vẫn được thêm ngay vào DOM
                 * nên có thể nhìn thấy nhiều thông báo
                 * cùng lúc.
                 */

                cartNotification.appendChild(
                    notification
                );


                /*
                 * Bắt đầu xử lý theo thứ tự.
                 */

                processNotificationQueue();

            }


            /* =====================================================
               XỬ LÝ THÔNG BÁO THEO THỨ TỰ
               ===================================================== */

            function processNotificationQueue() {

                /*
                 * Đang xử lý một thông báo
                 * thì không xử lý cái tiếp theo.
                 */

                if (notificationProcessing) {
                    return;
                }


                /*
                 * Không còn thông báo.
                 */

                if (
                    notificationQueue.length ===
                    0
                ) {

                    return;

                }


                notificationProcessing =
                    true;


                const currentNotification =
                    notificationQueue.shift();


                /*
                 * Giữ thông báo đầu tiên trong 3 giây.
                 */

                setTimeout(function() {

                    if (
                        currentNotification &&
                        currentNotification.isConnected
                    ) {

                        currentNotification.classList.add(
                            "hiding"
                        );


                        /*
                         * Đợi animation biến mất.
                         */

                        setTimeout(function() {

                            if (
                                currentNotification.isConnected
                            ) {

                                currentNotification.remove();

                            }

                        }, 250);

                    }


                    /*
                     * Sau khi thông báo hiện tại hoàn tất,
                     * bắt đầu thông báo kế tiếp.
                     *
                     * Thông báo kế tiếp cũng có 3 giây.
                     */

                    setTimeout(function() {

                        notificationProcessing =
                            false;

                        processNotificationQueue();

                    }, 250);

                }, 3000);

            }


            /* =====================================================
               LẤY DANH SÁCH CHECKBOX
               ===================================================== */

            function getProductChecks() {

                return document.querySelectorAll(
                    ".product-check"
                );

            }


            /* =====================================================
               CẬP NHẬT TỔNG
               ===================================================== */

            function updateCartSummary() {

                const productChecks =
                    getProductChecks();


                let total = 0;
                let quantity = 0;
                let selectedCount = 0;


                productChecks.forEach(function(checkbox) {

                    const card =
                        checkbox.closest(
                            ".cart-item-card"
                        );


                    if (!card) {
                        return;
                    }


                    if (!checkbox.checked) {

                        card.classList.remove(
                            "selected"
                        );

                        return;

                    }


                    selectedCount++;

                    card.classList.add(
                        "selected"
                    );


                    const price =
                        parseFloat(
                            card.dataset.price
                        ) || 0;


                    const quantityInput =
                        card.querySelector(
                            ".payment-quantity"
                        );


                    if (!quantityInput) {
                        return;
                    }


                    let qty =
                        parseInt(
                            quantityInput.value
                        );


                    const max =
                        parseInt(
                            quantityInput.max
                        );


                    /*
                     * Khi hết hàng:
                     * số lượng thanh toán được phép là 0.
                     */

                    if (isNaN(qty)) {

                        qty = 0;

                    }


                    if (qty < 0) {

                        qty = 0;

                        quantityInput.value =
                            0;

                    }


                    if (
                        !isNaN(max) &&
                        qty > max
                    ) {

                        qty = max;

                        quantityInput.value =
                            max;

                    }


                    total +=
                        price * qty;

                    quantity +=
                        qty;

                });


                if (selectedQuantity) {

                    selectedQuantity.innerText =
                        quantity;

                }


                if (selectedTotal) {

                    selectedTotal.innerText =
                        total.toLocaleString(
                            "vi-VN"
                        ) + " đ";

                }


                if (selectedInfo) {

                    if (selectedCount === 0) {

                        selectedInfo.innerText =
                            "Chưa chọn sản phẩm";


                        if (checkoutButton) {

                            checkoutButton.disabled =
                                true;

                        }

                    }
                    else {

                        selectedInfo.innerText =
                            "Đã chọn " +
                            selectedCount +
                            " sản phẩm";


                        if (checkoutButton) {

                            checkoutButton.disabled =
                                false;

                        }

                    }

                }


                if (productChecks.length > 0) {

                    const checkedCount =
                        document.querySelectorAll(
                            ".product-check:checked"
                        ).length;


                    if (selectAll) {

                        selectAll.checked =
                            checkedCount ===
                            productChecks.length;

                    }

                }
                else {

                    if (selectAll) {

                        selectAll.checked =
                            false;

                    }

                }

            }


            /* =====================================================
               CHECKBOX
