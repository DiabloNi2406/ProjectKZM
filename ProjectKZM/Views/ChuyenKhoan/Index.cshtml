@model ProjectKZM.ViewModels.ThanhToanViewModel

@{
    ViewData["Title"] = "Chuyển khoản ngân hàng";
}

<style>
    /* =========================================================
           BANK PAGE
           ========================================================= */

    .bank-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 50px 20px 80px;
        color: #222;
    }

    /* HEADER */

    .bank-header {
        margin-bottom: 32px;
    }

    .bank-title {
        margin: 0;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: -.7px;
        color: #222;
    }

    .bank-subtitle {
        margin-top: 10px;
        max-width: 760px;
        color: #777;
        font-size: 14px;
        line-height: 1.8;
    }

    /* MAIN GRID */

    .bank-grid {
        display: grid;
        grid-template-columns: 1.35fr .9fr;
        gap: 25px;
        align-items: start;
    }

    .bank-box {
        min-width: 0;
        padding: 28px;
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, .04);
    }

    .box-title {
        margin: 0 0 20px;
        font-size: 20px;
        font-weight: 600;
        color: #222;
    }

    /* PRODUCTS */

    .product-list {
        border-top: 1px solid #eee;
    }

    .product-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid #eee;
    }

    .product-image {
        display: block;
        width: 72px;
        height: 96px;
        flex-shrink: 0;
        object-fit: cover;
        background: #f3f3f3;
        border-radius: 8px;
    }

    .product-info {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        margin-bottom: 8px;
        color: #222;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }

    .product-meta {
        color: #888;
        font-size: 12px;
        line-height: 1.8;
    }

        .product-meta strong {
            color: #555;
        }

    .product-total {
        flex-shrink: 0;
        color: #222;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* SUMMARY */

    .summary {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #ddd;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        color: #555;
        font-size: 14px;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        padding-top: 18px;
        border-top: 1px solid #ddd;
        color: #111;
        font-size: 20px;
        font-weight: 700;
    }

        .summary-total span:last-child {
            color: #23864b;
            text-align: right;
        }

    /* =========================================================
           ACB BANK CARD - GIỮ NGUYÊN MÀU XANH ACB
           ========================================================= */

    .bank-brand {
        position: relative;
        overflow: hidden;
        padding: 29px;
        margin-bottom: 23px;
        border-radius: 19px;
        background: linear-gradient(120deg, #123b81, #1765d7);
        color: #fff;
    }

        .bank-brand::after {
            content: "";
            position: absolute;
            top: -60px;
            right: -35px;
            width: 190px;
            height: 190px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 50%;
            box-shadow: 0 0 0 22px rgba(255,255,255,.035), 0 0 0 45px rgba(255,255,255,.025);
            pointer-events: none;
        }

    .bank-brand-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .bank-brand-logo {
        display: grid;
        place-items: center;
        width: 64px;
        height: 54px;
        border-radius: 11px;
        background: #fff;
        color: #1252b7;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: -1px;
    }

    .bank-brand-tag {
        padding: 9px 13px;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 22px;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

    .bank-brand-name {
        position: relative;
        z-index: 1;
        margin-top: 28px;
        font-size: 23px;
        font-weight: 800;
    }

    .bank-brand-description {
        position: relative;
        z-index: 1;
        margin-top: 8px;
        color: rgba(255,255,255,.8);
        font-size: 14px;
    }

    /* BANK INFORMATION */

    .bank-info {
        padding: 18px;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        background: #fafafa;
    }

    .bank-info-title {
        margin-bottom: 15px;
        color: #222;
        font-size: 15px;
        font-weight: 600;
    }

    .bank-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 12px 0;
        border-bottom: 1px solid #e6e6e6;
    }

        .bank-row:last-child {
            border-bottom: none;
        }

    .bank-label {
        color: #777;
        font-size: 13px;
    }

    .bank-value {
        color: #222;
        font-size: 14px;
        font-weight: 600;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .money-value {
        color: #23864b;
        font-size: 19px;
        font-weight: 700;
    }

    .transfer-content {
        display: inline-block;
        padding: 8px 11px;
        border: 1px dashed #b9d9c2;
        border-radius: 7px;
        background: #f1f8f3;
        color: #176b39;
        font-weight: 700;
        letter-spacing: .3px;
    }

    /* NOTICE */

    .notice {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid #dcebdF;
        border-radius: 9px;
        background: #f3f8f4;
        color: #526b59;
        font-size: 13px;
        line-height: 1.8;
    }

        .notice strong {
            color: #23864b;
        }

    /* BUTTON */

    .submit-button {
        width: 100%;
        padding: 16px;
        margin-top: 23px;
        border: none;
        border-radius: 9px;
        background: #23864b;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s ease, transform .2s ease;
    }

        .submit-button:hover {
            background: #176b39;
            transform: translateY(-1px);
        }

    .submit-caption {
        margin-top: 10px;
        color: #999;
        font-size: 11px;
        line-height: 1.6;
        text-align: center;
    }

    /* BACK */

    .back-link {
        display: inline-block;
        margin-top: 18px;
        color: #555;
        font-size: 14px;
        text-decoration: none;
    }

        .back-link:hover {
            color: #23864b;
            text-decoration: underline;
        }

    /* MOBILE */

    @@media (max-width: 850px) {
        .bank-grid {
            grid-template-columns: 1fr;
        }

        .bank-title {
            font-size: 32px;
        }
    }

    @@media (max-width: 550px) {
        .bank-page {
            padding: 35px 15px 60px;
        }

        .bank-box {
            padding: 20px;
        }

        .product-item {
            align-items: flex-start;
            gap: 11px;
        }

        .product-image {
            width: 60px;
            height: 80px;
        }

        .product-name {
            font-size: 13px;
        }

        .product-meta {
            font-size: 11px;
        }

        .product-total {
            font-size: 12px;
        }

        .bank-row {
            flex-direction: column;
            gap: 5px;
        }

        .bank-value {
            text-align: left;
        }

        .bank-brand {
            padding: 23px;
        }

        .bank-brand-name {
            font-size: 20px;
        }

        .summary-total {
            font-size: 17px;
        }

            .summary-total span:last-child {
                font-size: 18px;
            }
    }
</style>


<div class="bank-page">

    <!-- HEADER -->

    <div class="bank-header">

        <h1 class="bank-title">
            Chuyển khoản ngân hàng
        </h1>

        <p class="bank-subtitle">
            Vui lòng kiểm tra lại sản phẩm và thực hiện chuyển khoản
            đúng số tiền. Sau khi bạn xác nhận đã chuyển khoản,
            đơn hàng sẽ được giữ và chờ Admin kiểm tra giao dịch.
        </p>

    </div>


    <!-- MAIN -->

    <div class="bank-grid">

        <!-- LEFT - PRODUCTS -->

        <div class="bank-box">

            <h2 class="box-title">
                Sản phẩm trong đơn hàng
            </h2>

            <div class="product-list">

                @for (int i = 0; i < Model.SanPhams.Count; i++)
                {
                    <div class="product-item">

                        @if (!string.IsNullOrWhiteSpace(Model.SanPhams[i].Hinh))
                        {
                            <img src="@Model.SanPhams[i].Hinh"
                                 class="product-image"
                                 alt="@Model.SanPhams[i].TenSach" />
                        }
                        else
                        {
                            <div class="product-image"></div>
                        }

                        <div class="product-info">

                            <div class="product-name">
                                @Model.SanPhams[i].TenSach
                            </div>

                            <div class="product-meta">
                                Số lượng:
                                <strong>@Model.SanPhams[i].SoLuong</strong>

                                <br />

                                Đơn giá:
                                <strong>
                                    @Model.SanPhams[i].DonGia.ToString("N0") VNĐ
                                </strong>
                            </div>

                        </div>

                        <div class="product-total">
                            @Model.SanPhams[i].ThanhTien.ToString("N0") VNĐ
                        </div>

                    </div>
                }

            </div>

            <!-- SUMMARY -->

            <div class="summary">

                <div class="summary-row">
                    <span>Tổng số lượng</span>
                    <strong>@Model.TongSoLuong</strong>
                </div>

                <div class="summary-total">
                    <span>Tổng tiền</span>
                    <span>@Model.TongTien.ToString("N0") VNĐ</span>
                </div>

            </div>

        </div>


        <!-- RIGHT - BANK INFORMATION -->

        <div class="bank-box">

            <h2 class="box-title">
                Thông tin chuyển khoản
            </h2>

            <!-- ACB BRAND CARD -->

            <div class="bank-brand">

                <div class="bank-brand-top">

                    <div class="bank-brand-logo">
                        ACB
                    </div>

                    <div class="bank-brand-tag">
                        BANK TRANSFER
                    </div>

                </div>

                <div class="bank-brand-name">
                    Ngân hàng ACB
                </div>

                <div class="bank-brand-description">
                    Ngân hàng Thương mại Cổ phần Á Châu
                </div>

            </div>


            <!-- ACCOUNT INFORMATION -->

            <div class="bank-info">

                <div class="bank-info-title">
                    Vui lòng chuyển khoản chính xác
                </div>

                <div class="bank-row">

                    <span class="bank-label">
                        Ngân hàng
                    </span>

                    <span class="bank-value">
                        ACB (Á CHÂU BANK)
                    </span>

                </div>

                <div class="bank-row">

                    <span class="bank-label">
                        Số tài khoản
                    </span>

                    <span class="bank-value">
                        5148641
                    </span>

                </div>

                <div class="bank-row">

                    <span class="bank-label">
                        Chủ tài khoản
                    </span>

                    <span class="bank-value">
                        LÊ HOÀNG BẢO LÂN
                    </span>

                </div>

                <div class="bank-row">

                    <span class="bank-label">
                        Số tiền cần chuyển
                    </span>

                    <span class="bank-value money-value">
                        @Model.TongTien.ToString("N0") VNĐ
                    </span>

                </div>

                @if (Model.MaDonHang.HasValue)
                {
                    <div class="bank-row">

                        <span class="bank-label">
                            Mã đơn hàng
                        </span>

                        <span class="bank-value">
                            #@Model.MaDonHang
                        </span>

                    </div>
                }

                <div class="bank-row">

                    <span class="bank-label">
                        Nội dung chuyển khoản
                    </span>

                    <span class="bank-value">
                        <span class="transfer-content">
                            THANHTOAN-@(Model.MaDonHang?.ToString() ?? "DONHANG")
                        </span>
                    </span>

                </div>

            </div>


            <!-- NOTICE -->

            <div class="notice">

                <strong>Lưu ý:</strong>

                Nội dung chuyển khoản cần ghi đúng để Admin
                dễ dàng kiểm tra giao dịch. Sau khi bạn bấm
                “Xác nhận chuyển khoản”, hệ thống sẽ thông báo cho Admin
                kiểm tra giao dịch trước khi xác nhận đơn hàng.

            </div>


            <!-- CONFIRM FORM -->

            <form asp-controller="ThanhToan"
                  asp-action="XacNhanChuyenKhoan"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaDonHang" />

                @for (int i = 0; i < Model.SanPhams.Count; i++)
                {
                    <input type="hidden"
                           asp-for="SanPhams[i].MaSach" />

                    <input type="hidden"
                           asp-for="SanPhams[i].SoLuong" />
                }

                <input type="hidden" asp-for="HoTen" />

                <input type="hidden" asp-for="SoDienThoai" />

                <input type="hidden" asp-for="DiaChiGiaoHang" />

                <input type="hidden" asp-for="GhiChu" />

                <input type="hidden"
                       name="PhuongThucThanhToan"
                       value="BANK" />

                <button type="submit" class="submit-button">
                    XÁC NHẬN CHUYỂN KHOẢN
                </button>

                <div class="submit-caption">
                    Admin sẽ kiểm tra giao dịch thực tế trước khi
                    xác nhận đơn hàng của bạn.
                </div>

            </form>


            <a asp-controller="ThanhToan"
               asp-action="Index"
               class="back-link">

                ← Quay lại phương thức thanh toán

            </a>

        </div>

    </div>

</div>
