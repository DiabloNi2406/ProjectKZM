@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Xóa người dùng";
}

<h1>Xóa người dùng</h1>

<hr />

<div class="alert alert-danger">

    <h5>Bạn có chắc chắn muốn xóa tài khoản này?</h5>

    <p>
        Hành động này không thể hoàn tác.
    </p>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Mã người dùng
            </dt>

            <dd class="col-sm-9">
                @Model.MaNguoiDung
            </dd>


            <dt class="col-sm-3">
                Họ và tên
            </dt>

            <dd class="col-sm-9">
                @Model.HoTen
            </dd>


            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>


            <dt class="col-sm-3">
                Số điện thoại
            </dt>

            <dd class="col-sm-9">
                @Model.SoDienThoai
            </dd>


            <dt class="col-sm-3">
                Địa chỉ
            </dt>

            <dd class="col-sm-9">
                @Model.DiaChi
            </dd>


            <dt class="col-sm-3">
                Vai trò
            </dt>

            <dd class="col-sm-9">

                @if (Model.VaiTro != null)
                {
                    @Model.VaiTro.TenVaiTro
                }
                else
                {
                    <span>Chưa có vai trò</span>
                }

            </dd>

        </dl>


        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   name="manguoidung"
                   value="@Model.MaNguoiDung" />

            <button type="submit"
                    class="btn btn-danger">
                Xác nhận xóa
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Hủy
            </a>

        </form>

    </div>

</div>