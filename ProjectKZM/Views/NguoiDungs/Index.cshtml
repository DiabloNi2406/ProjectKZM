                @Html.DisplayFor(model => item.VaiTro)
            </td>
            <td>
                @Html.DisplayFor(model => item.GioHangs)
            </td>
            <td>
                @Html.DisplayFor(model => item.DonHangs)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaNguoiDung">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaNguoiDung">Details</a> |
