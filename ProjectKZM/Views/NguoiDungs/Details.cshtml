@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<h1>Chi tiết người dùng</h1>

<hr />

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-md-8">

                <dl class="row">

                    <dt class="col-sm-4">
                        Mã người dùng
                    </dt>

                    <dd class="col-sm-8">
                        @Model.MaNguoiDung
                    </dd>


                    <dt class="col-sm-4">
                        Họ và tên
                    </dt>

                    <dd class="col-sm-8">
                        @Model.HoTen
                    </dd>


                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Email
                    </dd>


                    <dt class="col-sm-4">
                        Số điện thoại
                    </dt>

                    <dd class="col-sm-8">
                        @Model.SoDienThoai
                    </dd>


                    <dt class="col-sm-4">
                        Địa chỉ
                    </dt>

                    <dd class="col-sm-8">
                        @Model.DiaChi
                    </dd>


                    <dt class="col-sm-4">
                        Vai trò
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.VaiTro != null)
                        {
                            @Model.VaiTro.TenVaiTro
                        }
                        else
                        {
                            <span>Chưa có vai trò</span>
                        }

                    </dd>

                </dl>

            </div>

        </div>

        <hr />

        <a asp-action="Edit"
           asp-route-manguoidung="@Model.MaNguoiDung"
           class="btn btn-warning">
            Sửa
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>

    </div>

</div>