@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Thêm người dùng";
}

<style>
    .register-page {
        max-width: 650px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .register-title {
        font-size: 40px;
        font-weight: 400;
        color: #222;
        margin-bottom: 8px;
    }

    .register-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .register-card {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 35px;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .form-label {
        font-weight: 500;
    }

    .button-area {
        margin-top: 25px;
        display: flex;
        gap: 10px;
    }
</style>

<div class="register-page">

    <h1 class="register-title">
        Thêm người dùng
    </h1>

    <p class="register-subtitle">
        Tạo tài khoản người dùng mới trong hệ thống
    </p>

    <div class="register-card">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <!-- HỌ TÊN -->

            <div class="mb-3">

                <label asp-for="HoTen"
                       class="form-label">
                    Họ tên
                </label>

                <input asp-for="HoTen"
                       class="form-control"
                       placeholder="Nhập họ tên" />

                <span asp-validation-for="HoTen"
                      class="text-danger">
                </span>

            </div>

            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="example@gmail.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <!-- MẬT KHẨU -->

            <div class="mb-3">

                <label asp-for="MatKhau"
                       class="form-label">
                    Mật khẩu
                </label>

                <input asp-for="MatKhau"
                       type="password"
                       class="form-control"
                       placeholder="Nhập mật khẩu" />

                <span asp-validation-for="MatKhau"
                      class="text-danger">
                </span>

            </div>

            <!-- SỐ ĐIỆN THOẠI -->

            <div class="mb-3">

                <label asp-for="SoDienThoai"
                       class="form-label">
                    Số điện thoại
                </label>

                <input asp-for="SoDienThoai"
                       class="form-control"
                       placeholder="Nhập số điện thoại" />

                <span asp-validation-for="SoDienThoai"
                      class="text-danger">
                </span>

            </div>

            <!-- ĐỊA CHỈ -->

            <div class="mb-3">

                <label asp-for="DiaChi"
                       class="form-label">
                    Địa chỉ
                </label>

                <input asp-for="DiaChi"
                       class="form-control"
                       placeholder="Nhập địa chỉ" />

                <span asp-validation-for="DiaChi"
                      class="text-danger">
                </span>

            </div>

            <!-- ẢNH ĐẠI DIỆN -->

            <div class="mb-3">

                <label asp-for="AnhDaiDien"
                       class="form-label">
                    Ảnh đại diện
                </label>

                <input asp-for="AnhDaiDien"
                       class="form-control"
                       placeholder="/images/avatar/example.jpg" />

                <span asp-validation-for="AnhDaiDien"
                      class="text-danger">
                </span>

            </div>

            <!-- VAI TRÒ -->

            <div class="mb-3">

                <label asp-for="MaVaiTro"
                       class="form-label">
                    Vai trò
                </label>

                <select asp-for="MaVaiTro"
                        class="form-select"
                        asp-items="ViewBag.Roles">

                    <option value="">
                        -- Chọn vai trò --
                    </option>

                </select>

                <span asp-validation-for="MaVaiTro"
                      class="text-danger">
                </span>

            </div>

            <!-- BUTTON -->

            <div class="button-area">

                <button type="submit"
                        class="btn btn-success">
                    + Thêm người dùng
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    ← Quản lý
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}