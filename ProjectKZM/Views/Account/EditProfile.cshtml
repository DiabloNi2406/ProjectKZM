@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";
}

<style>
    .profile-page {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px 60px;
    }

    .profile-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .profile-title {
        text-align: center;
        margin-bottom: 30px;
    }

        .profile-title h1 {
            font-size: 30px;
            margin-bottom: 8px;
            color: #222;
        }

        .profile-title p {
            color: #777;
            margin: 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        font-weight: 600;
        color: #333;
    }

    .form-control {
        width: 100%;
        height: 42px;
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #198754;
            box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.15);
        }

    textarea.form-control {
        height: 100px;
        resize: vertical;
    }

    .text-danger {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 13px;
    }

    .button-area {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 30px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        background: #6c757d;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        border: none;
    }

        .btn-back:hover {
            background: #5c636a;
            color: white;
        }

    .btn-save {
        padding: 10px 20px;
        background: #198754;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
    }

        .btn-save:hover {
            background: #157347;
        }

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px;
        border-radius: 6px;
        background: #f8d7da;
        color: #842029;
    }

    @@media (max-width: 600px) {
        .profile-card {
            padding: 20px;
        }

        .button-area {
            flex-direction: column;
        }

        .btn-back,
        .btn-save {
            width: 100%;
        }
    }
</style>


<div class="profile-page">

    <div class="profile-card">

        <div class="profile-title">

            <h1>Chỉnh sửa thông tin cá nhân</h1>

            <p>
                Cập nhật thông tin cá nhân của bạn
            </p>

        </div>


        <form asp-controller="Account"
              asp-action="EditProfile"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.MaNguoiDung" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- HỌ TÊN -->

            <div class="form-group">

                <label class="form-label">
                    Họ và tên
                </label>

                <input type="text"
                       name="hoTen"
                       value="@Model.HoTen"
                       class="form-control"
                       required />

                <span asp-validation-for="HoTen"
                      class="text-danger">
                </span>

            </div>


            <!-- EMAIL -->

            <div class="form-group">

                <label class="form-label">
                    Email
                </label>

                <input type="email"
                       name="email"
                       value="@Model.Email"
                       class="form-control"
                       required />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- SỐ ĐIỆN THOẠI -->

            <div class="form-group">

                <label class="form-label">
                    Số điện thoại
                </label>

                <input type="text"
                       name="soDienThoai"
                       value="@Model.SoDienThoai"
                       class="form-control" />

                <span asp-validation-for="SoDienThoai"
                      class="text-danger">
                </span>

            </div>


            <!-- ĐỊA CHỈ -->

            <div class="form-group">

                <label class="form-label">
                    Địa chỉ
                </label>

                <textarea name="diaChi"
                          class="form-control">@Model.DiaChi</textarea>

                <span asp-validation-for="DiaChi"
                      class="text-danger">
                </span>

            </div>


            <!-- KHÔNG CHO SỬA VAI TRÒ -->

            <div class="button-area">

                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn-back">

                    ← Quay lại

                </a>


                <button type="submit"
                        class="btn-save">

                    💾 Lưu thay đổi

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}