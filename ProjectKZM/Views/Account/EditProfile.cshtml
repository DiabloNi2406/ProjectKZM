@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";

    string? avatarUrl = null;

    if (!string.IsNullOrWhiteSpace(Model.AnhDaiDien))
    {
        string avatar = Model.AnhDaiDien.Trim();

        if (avatar.StartsWith("/"))
        {
            avatarUrl = Url.Content("~" + avatar);
        }
        else if (avatar.StartsWith("uploads/avatars/", StringComparison.OrdinalIgnoreCase))
        {
            avatarUrl = Url.Content("~/" + avatar);
        }
        else
        {
            avatarUrl = Url.Content("~/uploads/avatars/" + avatar);
        }
    }
}

<style>
    .edit-page {
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .edit-title {
        font-size: 40px;
        font-weight: 400;
        color: #222;
        margin-bottom: 8px;
    }

    .edit-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .edit-card {
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 35px;
        background: white;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    }

    .form-label {
        font-weight: 500;
        color: #333;
    }

    .button-area {
        margin-top: 25px;
        display: flex;
        gap: 10px;
    }

    .validation-summary {
        margin-bottom: 20px;
    }

    .text-danger {
        display: block;
        margin-top: 5px;
    }

    /* =========================================================
           AVATAR
           ========================================================= */

    .avatar-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 35px;
        padding-bottom: 30px;
        border-bottom: 1px solid #eeeeee;
    }

    .avatar-wrapper {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        padding: 4px;
        background: #212529;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.14);
        margin-bottom: 15px;
    }

    .avatar-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #f1f1f1;
    }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #f1f1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 52px;
    }

    .avatar-name {
        margin: 0;
        color: #222;
        font-size: 20px;
        font-weight: 600;
    }

    .avatar-text {
        margin: 5px 0 0;
        color: #888;
        font-size: 13px;
    }

    /* =========================================================
           CURRENT AVATAR
           ========================================================= */

    .current-avatar-box {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 15px;
        margin-bottom: 12px;
        background: #f8f9fa;
        border: 1px solid #eeeeee;
        border-radius: 12px;
    }

    .current-avatar-wrapper {
        width: 80px;
        height: 80px;
        flex-shrink: 0;
        border-radius: 50%;
        padding: 3px;
        background: #212529;
    }

        .current-avatar-wrapper .avatar-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            display: block;
            background: #f1f1f1;
        }

        .current-avatar-wrapper .avatar-placeholder {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #eeeeee;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

    .current-avatar-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .current-avatar-info strong {
            font-size: 15px;
            color: #222;
        }

        .current-avatar-info span {
            font-size: 13px;
            color: #888;
        }

    .avatar-input-help {
        display: block;
        margin-top: 6px;
        color: #888;
        font-size: 12px;
    }

    @@media (max-width: 600px) {

        .edit-page {
            margin: 25px auto;
            padding: 0 15px;
        }

        .edit-card {
            padding: 25px 20px;
        }

        .edit-title {
            font-size: 32px;
        }

        .avatar-wrapper {
            width: 120px;
            height: 120px;
        }

        .button-area {
            flex-direction: column;
        }

            .button-area .btn {
                width: 100%;
            }

        .current-avatar-box {
            align-items: flex-start;
        }
    }
</style>


<div class="edit-page">

    <h1 class="edit-title">
        Chỉnh sửa thông tin cá nhân
    </h1>

    <p class="edit-subtitle">
        Cập nhật thông tin cá nhân của bạn
    </p>


    <div class="edit-card">

        <form asp-controller="Account"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.MaNguoiDung" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger validation-summary">
            </div>


            <!-- =================================================
                 AVATAR HIỆN TẠI
                 ================================================= -->

            <div class="avatar-section">

                <div class="avatar-wrapper">

                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl"
                             alt="Ảnh đại diện của @Model.HoTen"
                             class="avatar-image"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <div class="avatar-placeholder"
                             style="display:none;">
                            👤
                        </div>
                    }
                    else
                    {
                        <div class="avatar-placeholder">
                            👤
                        </div>
                    }

                </div>


                @if (!string.IsNullOrEmpty(Model.HoTen))
                {
                    <h3 class="avatar-name">
                        @Model.HoTen
                    </h3>
                }


                <p class="avatar-text">
                    Ảnh đại diện hiện tại
                </p>

            </div>


            <!-- =================================================
                 HỌ TÊN
                 ================================================= -->

            <div class="mb-3">

                <label class="form-label">
                    Họ và tên
                </label>

                <input type="text"
                       name="hoTen"
                       value="@Model.HoTen"
                       class="form-control"
                       placeholder="Nhập họ và tên"
                       required />

                <span asp-validation-for="HoTen"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 EMAIL
                 ================================================= -->

            <div class="mb-3">

                <label class="form-label">
                    Email
                </label>

                <input type="email"
                       name="email"
                       value="@Model.Email"
                       class="form-control"
                       placeholder="example@gmail.com"
                       required />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 SỐ ĐIỆN THOẠI
                 ================================================= -->

            <div class="mb-3">

                <label class="form-label">
                    Số điện thoại
                </label>

                <input type="text"
                       name="soDienThoai"
                       value="@Model.SoDienThoai"
                       class="form-control"
                       placeholder="Nhập số điện thoại" />

                <span asp-validation-for="SoDienThoai"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 ĐỊA CHỈ
                 ================================================= -->

            <div class="mb-3">

                <label class="form-label">
                    Địa chỉ
                </label>

                <textarea name="diaChi"
                          class="form-control"
                          rows="4"
                          placeholder="Nhập địa chỉ">@Model.DiaChi</textarea>

                <span asp-validation-for="DiaChi"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 ẢNH ĐẠI DIỆN
                 ================================================= -->

            <div class="mb-3">

                <label class="form-label">
                    Ảnh đại diện
                </label>


                <div class="current-avatar-box">

                    <div class="current-avatar-wrapper">

                        @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                        {
                            <img src="@avatarUrl"
                                 id="avatarPreview"
                                 alt="Ảnh đại diện"
                                 class="avatar-image"
                                 onerror="this.style.display='none'; document.getElementById('avatarPlaceholder').style.display='flex';" />

                            <div id="avatarPlaceholder"
                                 class="avatar-placeholder"
                                 style="display:none;">
                                👤
                            </div>
                        }
                        else
                        {
                            <img id="avatarPreview"
                                 src=""
                                 alt="Ảnh đại diện"
                                 class="avatar-image"
                                 style="display:none;" />

                            <div id="avatarPlaceholder"
                                 class="avatar-placeholder">
                                👤
                            </div>
                        }

                    </div>


                    <div class="current-avatar-info">

                        <strong>
                            @Model.HoTen
                        </strong>

                        <span>
                            Ảnh đại diện hiện tại
                        </span>

                    </div>

                </div>


                <input type="file"
                       name="anhDaiDienFile"
                       id="anhDaiDienFile"
                       class="form-control"
                       accept="image/*" />


                <small class="avatar-input-help">
                    Chọn ảnh mới để thay đổi ảnh đại diện.
                </small>


                <span class="text-danger"
                      id="avatarError">
                </span>

            </div>


            <!-- =================================================
                 BUTTON
                 ================================================= -->

            <div class="button-area">

                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn btn-secondary">

                    ← Quay lại

                </a>


                <button type="submit"
                        class="btn btn-success">

                    Lưu thay đổi

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const avatarFile =
            document.getElementById("anhDaiDienFile");

        const avatarPreview =
            document.getElementById("avatarPreview");

        const avatarPlaceholder =
            document.getElementById("avatarPlaceholder");

        const avatarError =
            document.getElementById("avatarError");


        if (avatarFile) {

            avatarFile.addEventListener(
                "change",
                function() {

                    avatarError.textContent = "";

                    if (!this.files ||
                        !this.files[0]) {

                        return;
                    }


                    const file =
                        this.files[0];


                    /* ==============================
                       KIỂM TRA FILE ẢNH
                       ============================== */

                    if (!file.type.startsWith("image/")) {

                        avatarError.textContent =
                            "Vui lòng chọn một file ảnh.";

                        this.value = "";

                        return;
                    }


                    /* ==============================
                       GIỚI HẠN 5MB
                       ============================== */

                    if (file.size > 5 * 1024 * 1024) {

                        avatarError.textContent =
                            "Ảnh không được vượt quá 5MB.";

                        this.value = "";

                        return;
                    }


                    /* ==============================
                       PREVIEW ẢNH MỚI
                       ============================== */

                    const reader =
                        new FileReader();


                    reader.onload =
                        function(e) {

                            avatarPreview.src =
                                e.target.result;

                            avatarPreview.style.display =
                                "block";


                            if (avatarPlaceholder) {

                                avatarPlaceholder.style.display =
                                    "none";

                            }

                        };


                    reader.readAsDataURL(file);

                }
            );

        }

    </script>
}