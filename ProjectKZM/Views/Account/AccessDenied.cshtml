@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<style>
    .access-denied-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .access-denied-box {
        width: 100%;
        max-width: 550px;
        background: white;
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .access-denied-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .access-denied-box h1 {
        font-size: 28px;
        margin-bottom: 15px;
        color: #dc3545;
    }

    .access-denied-box p {
        color: #666;
        font-size: 15px;
        margin-bottom: 25px;
    }

    .access-denied-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>


<div class="access-denied-page">

    <div class="access-denied-box">

        <div class="access-denied-icon">
            🚫
        </div>

        <h1>
            Không có quyền truy cập
        </h1>

        <p>
            Bạn không có quyền thực hiện thao tác này.
        </p>

        <div class="access-denied-buttons">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary">

                🏠 Về trang chủ

            </a>

            <a asp-controller="Account"
               asp-action="Profile"
               class="btn btn-secondary">

                👤 Thông tin cá nhân

            </a>

        </div>

    </div>

</div>