@model ProjectKZM.ViewModels.RegisterVerifyViewModel

@{
    ViewData["Title"] = "Xác minh Email";
}

<style>
    .verify-page {
        max-width: 500px;
        margin: 0 auto;
        padding: 70px 20px;
    }

    .verify-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(0,0,0,.06);
        text-align: center;
    }

    .verify-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #212529;
        color: #fff;
        font-size: 28px;
    }

    .verify-title {
        margin: 0 0 12px;
        font-size: 30px;
        font-weight: 600;
    }

    .verify-description {
        color: #777;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .email {
        font-weight: 600;
        color: #222;
        word-break: break-word;
    }

    .otp-input {
        width: 100%;
        box-sizing: border-box;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-align: center;
        font-size: 25px;
        letter-spacing: 8px;
        outline: none;
    }

        .otp-input:focus {
            border-color: #212529;
            box-shadow: 0 0 0 3px rgba(33,37,41,.08);
        }

    .validation {
        display: block;
        margin-top: 8px;
        color: #dc3545;
        font-size: 13px;
    }

    .submit-button {
        width: 100%;
        height: 46px;
        margin-top: 20px;
        border: none;
        border-radius: 8px;
        background: #212529;
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

        .submit-button:hover {
            background: #000;
        }

    .resend-form {
        margin-top: 15px;
    }

    .resend-button {
        border: none;
        background: none;
        color: #212529;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .resend-button:hover {
            text-decoration: underline;
        }

    .back-link {
        display: inline-block;
        margin-top: 15px;
        color: #666;
        text-decoration: none;
        font-size: 14px;
    }

        .back-link:hover {
            color: #111;
            text-decoration: underline;
        }

    .alert-area {
        margin-bottom: 18px;
        text-align: left;
    }
</style>


<div class="verify-page">

    <div class="verify-card">

        <div class="verify-icon">
            ✉
        </div>


        <h1 class="verify-title">
            Xác minh Email
        </h1>


        <p class="verify-description">

            Mã xác minh đã được gửi đến:

            <br />

            <span class="email">
                @ViewBag.Email
            </span>

            <br /><br />

            Vui lòng kiểm tra Gmail và nhập mã OTP gồm
            <strong>6 chữ số</strong>.
            Mã có hiệu lực trong <strong>5 phút</strong>.

        </p>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-area">
                @TempData["Success"]
            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-area">
                @TempData["Error"]
            </div>
        }


        <div asp-validation-summary="ModelOnly"
             class="validation">
        </div>


        <form asp-action="XacMinhEmail"
              method="post">

            @Html.AntiForgeryToken()


            <input asp-for="OTP"
                   class="otp-input"
                   maxlength="6"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="000000" />


            <span asp-validation-for="OTP"
                  class="validation">
            </span>


            <button type="submit"
                    class="submit-button">

                XÁC MINH EMAIL

            </button>

        </form>


        <form asp-action="GuiLaiOTP"
              method="post"
              class="resend-form">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="resend-button">

                Gửi lại mã OTP

            </button>

        </form>


        <br />


        <a asp-action="Register"
           class="back-link">

            ← Quay lại đăng ký

        </a>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}