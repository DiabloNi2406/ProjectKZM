@{
    ViewData["Title"] = "Đăng nhập";
}

<style>

    /* =========================================================
               LOGIN PAGE
               ========================================================= */

    .login-page {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }


    /* =========================================================
               LOGIN CARD
               ========================================================= */

    .login-card {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }


    /* =========================================================
               TITLE
               ========================================================= */

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #212529;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .login-header h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 600;
        color: #222;
    }

    .login-header p {
        margin: 8px 0 0;
        color: #888;
        font-size: 14px;
    }


    /* =========================================================
               ERROR
               ========================================================= */

    .login-error {
        border: none;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 20px;
    }


    /* =========================================================
               FORM
               ========================================================= */

    .login-form-group {
        margin-bottom: 20px;
    }

        .login-form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }

    .login-input {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        outline: none;
        font-size: 14px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .login-input:focus {
            border-color: #212529;
            box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.08);
        }

        .login-input::placeholder {
            color: #aaa;
        }


    /* =========================================================
               HIỆN MẬT KHẨU
               ========================================================= */

    .show-password {
        display: flex !important;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        margin-bottom: 0 !important;
        color: #777 !important;
        font-size: 13px !important;
        font-weight: 400 !important;
        cursor: pointer;
        user-select: none;
    }

        .show-password input {
            width: 15px;
            height: 15px;
            margin: 0;
            cursor: pointer;
            accent-color: #212529;
        }


    /* =========================================================
               BUTTON
               ========================================================= */

    .login-button {
        width: 100%;
        height: 46px;
        border: none;
        border-radius: 8px;
        background: #212529;
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .login-button:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

        .login-button:active {
            transform: translateY(0);
        }


    /* =========================================================
               REGISTER
               ========================================================= */

    .register-area {
        text-align: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        font-size: 14px;
        color: #777;
    }

        .register-area a {
            margin-left: 5px;
            color: #212529;
            font-weight: 600;
            text-decoration: none;
        }

            .register-area a:hover {
                text-decoration: underline;
            }


    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 500px) {

        .login-page {
            padding: 25px 15px;
        }

        .login-card {
            padding: 28px 22px;
            border-radius: 12px;
        }

        .login-header h2 {
            font-size: 26px;
        }
    }

</style>


<div class="login-page">

    <div class="login-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="login-header">

            <div class="login-icon">
                🔐
            </div>

            <h2>
                Đăng nhập
            </h2>

            <p>
                Đăng nhập để mua sách tại Yuuji Store
            </p>

        </div>


        <!-- =====================================================
             ERROR
             ===================================================== -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger login-error">
                @ViewBag.Error
            </div>
        }


        <!-- =====================================================
             LOGIN FORM
             ===================================================== -->

        <form asp-controller="Account"
              asp-action="Login"
              method="post">


            <!-- EMAIL -->

            <div class="login-form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       class="login-input"
                       placeholder="Nhập email của bạn"
                       autocomplete="email"
                       required />

            </div>


            <!-- PASSWORD -->

            <div class="login-form-group">

                <label for="password">
                    Mật khẩu
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       class="login-input"
                       placeholder="Nhập mật khẩu"
                       autocomplete="current-password"
                       required />


                <!-- HIỆN MẬT KHẨU -->

                <label for="showPassword"
                       class="show-password">

                    <input type="checkbox"
                           id="showPassword" />

                    <span>
                        Hiện mật khẩu
                    </span>

                </label>

            </div>


            <!-- BUTTON -->

            <div>

                <button type="submit"
                        class="login-button">

                    Đăng nhập

                </button>

            </div>

        </form>


        <!-- =====================================================
             REGISTER
             ===================================================== -->

        <div class="register-area">

            <span>
                Chưa có tài khoản?
            </span>

            <a asp-controller="Account"
               asp-action="Register">

                Đăng ký ngay

            </a>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        // =====================================================
        // HIỆN / ẨN MẬT KHẨU
        // =====================================================

        const showPassword =
            document.getElementById("showPassword");

        const password =
            document.getElementById("password");


        if (showPassword && password) {

            showPassword.addEventListener(
                "change",
                function() {

                    if (this.checked) {

                        password.type = "text";

                    }
                    else {

                        password.type = "password";

                    }

                }
            );

        }

    </script>

}
