@model ProjectKZM.Models.NguoiDung

@{
    ViewData["Title"] = "Thông Tin Cá Nhân";

    // =========================================================
    // AVATAR
    // =========================================================

    string avatarUrl = "/images/Icon/user.png";

    if (!string.IsNullOrWhiteSpace(Model?.AnhDaiDien))
    {
        string avatar = Model.AnhDaiDien.Trim();

        // Database lưu:
        // /uploads/avatars/tenfile.jpg
        if (avatar.StartsWith("/"))
        {
            avatarUrl = avatar;
        }
        // Database lưu:
        // uploads/avatars/tenfile.jpg
        else if (avatar.StartsWith(
            "uploads/avatars/",
            StringComparison.OrdinalIgnoreCase))
        {
            avatarUrl = "/" + avatar;
        }
        // Database chỉ lưu:
        // tenfile.jpg
        else
        {
            avatarUrl = "/uploads/avatars/" + avatar;
        }
    }
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .profile-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 50px 20px;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .profile-header-title {
        margin-bottom: 30px;
    }

        .profile-header-title h1 {
            margin: 0;
            font-size: 36px;
            font-weight: 600;
            color: #212529;
        }

        .profile-header-title p {
            margin: 8px 0 0;
            color: #888;
            font-size: 14px;
        }


    /* =========================================================
           CARD
           ========================================================= */

    .profile-card {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
    }


    /* =========================================================
           PROFILE TOP
           ========================================================= */

    .profile-top {
        display: flex;
        align-items: center;
        gap: 28px;
        padding: 35px;
        background: linear-gradient( 135deg, #f8f9fa, #ffffff );
        border-bottom: 1px solid #eeeeee;
    }


    /* =========================================================
           AVATAR
           ========================================================= */

    .profile-avatar-wrapper {
        width: 125px;
        height: 125px;
        flex-shrink: 0;
        border-radius: 50%;
        padding: 4px;
        background: #212529;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
    }

    .profile-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #f1f1f1;
    }


    /* =========================================================
           PROFILE INFO
           ========================================================= */

    .profile-info {
        flex: 1;
        min-width: 0;
    }

    .profile-name {
        margin: 0 0 8px;
        font-size: 28px;
        font-weight: 600;
        color: #212529;
    }

    .profile-email {
        margin: 0 0 14px;
        color: #777;
        font-size: 15px;
        word-break: break-word;
    }

    .profile-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 999px;
        background: #212529;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .profile-content {
        padding: 35px;
    }


    /* =========================================================
           INFORMATION GRID
           ========================================================= */

    .profile-info-grid {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0, 1fr) );
        gap: 18px;
    }

    .profile-info-item {
        padding: 18px;
        background: #f8f9fa;
        border: 1px solid #eeeeee;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        .profile-info-item:hover {
            border-color: #d8d8d8;
            transform: translateY(-1px);
        }

    .profile-info-label {
        display: block;
        margin-bottom: 7px;
        color: #888;
        font-size: 13px;
        font-weight: 500;
    }

    .profile-info-label-icon {
        margin-right: 5px;
    }

    .profile-info-value {
        color: #212529;
        font-size: 15px;
        font-weight: 500;
        word-break: break-word;
    }


    /* =========================================================
           ACTIONS
           ========================================================= */

    .profile-actions {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #eeeeee;
    }

    .profile-action-button {
        min-width: 110px;
        height: 42px;
        padding: 0 18px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .profile-edit-button {
        background: #198754;
        color: #ffffff;
        border: 1px solid #198754;
    }

        .profile-edit-button:hover {
            background: #157347;
            border-color: #157347;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

    .profile-back-button {
        background: #6c757d;
        color: #ffffff;
        border: 1px solid #6c757d;
    }

        .profile-back-button:hover {
            background: #5c636a;
            border-color: #565e64;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.12);
        }


    /* =========================================================
           EMPTY PROFILE
           ========================================================= */

    .empty-profile {
        background: #ffffff;
        border: 1px dashed #cccccc;
        border-radius: 14px;
        padding: 60px 20px;
        text-align: center;
        color: #777;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 700px) {

        .profile-page {
            padding: 30px 15px;
        }

        .profile-top {
            flex-direction: column;
            text-align: center;
            padding: 30px 20px;
        }

        .profile-avatar-wrapper {
            width: 110px;
            height: 110px;
        }

        .profile-name {
            font-size: 24px;
        }

        .profile-info-grid {
            grid-template-columns: 1fr;
        }

        .profile-content {
            padding: 25px 20px;
        }

        .profile-actions {
            flex-direction: column;
        }

        .profile-action-button {
            width: 100%;
        }
    }

</style>


<div class="profile-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="profile-header-title">

        <h1>
            Thông Tin Cá Nhân
        </h1>

        <p>
            Thông tin tài khoản của bạn
        </p>

    </div>


    @if (Model != null)
    {

        <!-- =================================================
             CARD
             ================================================= -->

        <div class="profile-card">


            <!-- =================================================
                 PROFILE TOP
                 ================================================= -->

            <div class="profile-top">

                <!-- AVATAR -->

                <div class="profile-avatar-wrapper">

                    <img src="@avatarUrl"
                         alt="Ảnh đại diện của @Model.HoTen"
                         class="profile-avatar"
                         onerror="this.onerror=null; this.src='/images/Icon/user.jpg';" />

                </div>


                <!-- USER INFO -->

                <div class="profile-info">

                    <h2 class="profile-name">
                        @(Model.HoTen ?? "Người dùng")
                    </h2>

                    <p class="profile-email">
                        @(Model.Email ?? "Chưa cập nhật")
                    </p>

                    <span class="profile-role-badge">

                        👤

                        @if (Model.VaiTro != null)
                        {
                            @Model.VaiTro.TenVaiTro
                        }
                        else
                        {
                            <span>Chưa có vai trò</span>
                        }

                    </span>

                </div>

            </div>


            <!-- =================================================
                 INFORMATION
                 ================================================= -->

            <div class="profile-content">

                <div class="profile-info-grid">


                    <!-- MÃ NGƯỜI DÙNG -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                🆔
                            </span>

                            Mã người dùng

                        </span>

                        <div class="profile-info-value">

                            @Model.MaNguoiDung

                        </div>

                    </div>


                    <!-- HỌ VÀ TÊN -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                👤
                            </span>

                            Họ và tên

                        </span>

                        <div class="profile-info-value">

                            @(Model.HoTen ?? "Chưa cập nhật")

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                ✉️
                            </span>

                            Email

                        </span>

                        <div class="profile-info-value">

                            @(Model.Email ?? "Chưa cập nhật")

                        </div>

                    </div>


                    <!-- SỐ ĐIỆN THOẠI -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                📱
                            </span>

                            Số điện thoại

                        </span>

                        <div class="profile-info-value">

                            @if (!string.IsNullOrEmpty(Model.SoDienThoai))
                            {
                                @Model.SoDienThoai
                            }
                            else
                            {
                                <span>Chưa cập nhật</span>
                            }

                        </div>

                    </div>


                    <!-- ĐỊA CHỈ -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                📍
                            </span>

                            Địa chỉ

                        </span>

                        <div class="profile-info-value">

                            @if (!string.IsNullOrEmpty(Model.DiaChi))
                            {
                                @Model.DiaChi
                            }
                            else
                            {
                                <span>Chưa cập nhật</span>
                            }

                        </div>

                    </div>


                    <!-- VAI TRÒ -->

                    <div class="profile-info-item">

                        <span class="profile-info-label">

                            <span class="profile-info-label-icon">
                                🛡️
                            </span>

                            Vai trò

                        </span>

                        <div class="profile-info-value">

                            @if (Model.VaiTro != null)
                            {
                                @Model.VaiTro.TenVaiTro
                            }
                            else
                            {
                                <span>Chưa có vai trò</span>
                            }

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="profile-actions">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="profile-action-button profile-back-button">

                        ← Quay lại

                    </a>


                    <a asp-controller="Account"
                       asp-action="EditProfile"
                       class="profile-action-button profile-edit-button">

                        ✏️ Chỉnh sửa thông tin

                    </a>

                </div>

            </div>

        </div>

    }
    else
    {

        <!-- =================================================
             EMPTY
             ================================================= -->

        <div class="empty-profile">

            <h4>
                Không tìm thấy thông tin tài khoản
            </h4>

            <p>
                Vui lòng đăng nhập lại.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-success">

                Đăng nhập

            </a>

        </div>

    }

</div>