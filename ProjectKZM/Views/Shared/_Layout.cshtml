<!DOCTYPE html>
<html lang="vi">

@inject ProjectKZM.Services.ThongBaoService ThongBaoService

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Yuuji Store
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

            /* =========================================================
                       GLOBAL
                       ========================================================= */

            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                background-color: #f8f9fa;
                color: #222;
            }


            /* =========================================================
                       NAVBAR
                       ========================================================= */

            .main-navbar {
                width: 100%;
                background-color: #212529;
                border-bottom: 1px solid #343a40;
            }

            .navbar-inner {
                width: 100%;
                min-height: 64px;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 10px 25px;
                box-sizing: border-box;
            }


            /* =========================================================
                       LOGO
                       ========================================================= */

            .store-logo {
                flex-shrink: 0;
                color: white;
                text-decoration: none;
                font-size: 24px;
                font-weight: 600;
                white-space: nowrap;
                transition: 0.2s;
            }

                .store-logo:hover {
                    color: #f8f9fa;
                }


            /* =========================================================
                       SEARCH
                       ========================================================= */

            .navbar-search {
                flex: 1;
                min-width: 250px;
                max-width: 680px;
                margin-left: 10px;
            }

            .search-form {
                width: 100%;
                display: flex;
                align-items: center;
            }

            .search-input {
                width: 100%;
                height: 40px;
                padding: 0 14px;
                border: none;
                outline: none;
                border-radius: 6px 0 0 6px;
                font-size: 14px;
                background-color: white;
                color: #222;
                box-sizing: border-box;
            }

                .search-input::placeholder {
                    color: #888;
                }

            .search-button {
                height: 40px;
                padding: 0 16px;
                border: none;
                border-radius: 0 6px 6px 0;
                background-color: #198754;
                color: white;
                font-size: 14px;
                white-space: nowrap;
                cursor: pointer;
                transition: 0.2s;
            }

                .search-button:hover {
                    background-color: #157347;
                }


            /* =========================================================
                       NAVIGATION BUTTONS
                       ========================================================= */

            .navbar-links {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
            }

            .navbar-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 38px;
                padding: 0 12px;
                border-radius: 6px;
                color: #dee2e6;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                transition: 0.2s;
                box-sizing: border-box;
            }

                .navbar-link:hover {
                    background-color: #343a40;
                    color: white;
                }


            /* =========================================================
                       4 NÚT CHÍNH

                       Trang chủ
                       Yêu thích
                       Giỏ hàng
                       Quản lý / Người dùng
                       ========================================================= */

            .navbar-action-link {
                width: 110px;
                min-width: 110px;
                height: 38px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 8px;
                box-sizing: border-box;
                background-color: #2b3035;
                border: 1px solid #3d4349;
                border-radius: 6px;
                color: #f1f3f5;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
            }

                .navbar-action-link:hover {
                    background-color: #3a4046;
                    border-color: #495057;
                    color: white;
                }


            /* =========================================================
                       FILTER BUTTON
                       ========================================================= */

            .filter-dropdown {
                position: relative;
            }

            .filter-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 38px;
                padding: 0 12px;
                border-radius: 6px;
                background-color: #343a40;
                border: 1px solid #495057;
                color: white;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                cursor: pointer;
                transition: 0.2s;
            }

                .filter-button:hover {
                    background-color: #495057;
                    color: white;
                }


            /* =========================================================
                       FILTER MENU
                       ========================================================= */

            .filter-menu {
                display: none;
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                width: 300px;
                max-height: 500px;
                overflow-y: auto;
                background-color: white;
                border: 1px solid #ddd;
                border-radius: 8px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
                padding: 15px;
                z-index: 9999;
            }

                .filter-menu.show {
                    display: block;
                }

            .filter-title {
                font-size: 15px;
                font-weight: 600;
                color: #222;
                margin-bottom: 8px;
                border-bottom: 1px solid #ddd;
                padding-bottom: 7px;
            }

            .filter-section {
                margin-bottom: 15px;
            }

            .filter-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 5px 0;
                font-size: 14px;
                color: #333;
                cursor: pointer;
            }

                .filter-item input {
                    cursor: pointer;
                }

            .filter-actions {
                display: flex;
                gap: 8px;
                margin-top: 10px;
                padding-top: 10px;
                border-top: 1px solid #ddd;
            }

            .filter-apply {
                flex: 1;
                height: 36px;
                border: none;
                border-radius: 5px;
                background-color: #198754;
                color: white;
                cursor: pointer;
                font-size: 14px;
            }

                .filter-apply:hover {
                    background-color: #157347;
                }

            .filter-clear {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 36px;
                padding: 0 12px;
                border-radius: 5px;
                background-color: #6c757d;
                color: white;
                text-decoration: none;
                font-size: 14px;
            }

                .filter-clear:hover {
                    background-color: #5c636a;
                    color: white;
                }


            /* =========================================================
                       USER AREA
                       ========================================================= */

            .user-area {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
                flex-shrink: 0;
            }


            /* =========================================================
                       USER NAME
                       ========================================================= */

            .user-name {
                color: #dee2e6;
                font-size: 14px;
                white-space: nowrap;
            }


            /* =========================================================
                       CART

                       Đồng bộ kích thước với:
                       Trang chủ
                       Yêu thích
                       Quản lý
                       ========================================================= */

            .cart-button {
                width: 110px;
                min-width: 110px;
                height: 38px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 8px;
                box-sizing: border-box;
                border-radius: 6px;
                background-color: #2b3035;
                border: 1px solid #3d4349;
                color: #f1f3f5;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                transition: 0.2s;
            }

                .cart-button:hover {
                    background-color: #3a4046;
                    border-color: #495057;
                    color: white;
                }


            /* =========================================================
                       LOGIN BUTTON
                       ========================================================= */

            .login-button {
                height: 38px;
                padding: 0 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px;
                background-color: #198754;
                border: 1px solid #198754;
                color: white;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                transition: 0.2s;
            }

                .login-button:hover {
                    background-color: #157347;
                    border-color: #157347;
                    color: white;
                }


            /* =========================================================
                       LOGOUT BUTTON
                       ========================================================= */

            .logout-button {
                height: 38px;
                padding: 0 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px;
                background-color: #dc3545;
                border: 1px solid #dc3545;
                color: white;
                font-size: 14px;
                white-space: nowrap;
                cursor: pointer;
                transition: 0.2s;
            }

                .logout-button:hover {
                    background-color: #bb2d3b;
                    border-color: #b02a37;
                    color: white;
                }
            
            .register-button {
                height: 38px;
                padding: 0 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px;
                background-color: #2b3035;
                border: 1px solid #3d4349;
                color: #f1f3f5;
                text-decoration: none;
                font-size: 14px;
                white-space: nowrap;
                transition: 0.2s;
            }

                .register-button:hover {
                    background-color: #3a4046;
                    border-color: #495057;
                    color: white;
                }

            /* =========================================================
               USER DROPDOWN
               ========================================================= */

            .user-dropdown {
                position: relative;
            }

            .user-button {
                border: 1px solid #3d4349;
                cursor: pointer;
            }

            .user-menu {
                display: none;
                position: absolute;
                top: calc(100% + 8px);
                right: 0;
                width: 270px;
                background-color: white;
                border: 1px solid #ddd;
                border-radius: 10px;
                box-shadow: 0 8px 22px rgba(0, 0, 0, 0.16);
                z-index: 9999;
                overflow: hidden;
                padding: 8px 0;
            }

                .user-menu.show {
                    display: block;
                }


            /* =========================================================
               USER MENU SECTION
               ========================================================= */

            .user-menu-section {
                padding: 8px 0;
            }

                .user-menu-section + .user-menu-section {
                    border-top: 1px solid #eeeeee;
                }

            .user-menu-title {
                padding: 8px 16px 6px;
                color: #999;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.6px;
            }


            /* =========================================================
               USER MENU LINK
               ========================================================= */

            .user-menu a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 16px;
                color: #222;
                background-color: white;
                text-decoration: none;
                font-size: 14px;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

                .user-menu a:hover {
                    background-color: #f5f5f5;
                    color: #000;
                }

            .user-menu-icon {
                width: 28px;
                text-align: center;
                font-size: 16px;
                flex-shrink: 0;
            }


            /* =========================================================
                       MAIN CONTENT
                       ========================================================= */

            .main-content {
                min-height: calc(100vh - 120px);
                padding-top: 20px;
                padding-bottom: 40px;
            }


            /* =========================================================
                       ALERT
                       ========================================================= */

            .site-alert {
                max-width: 1200px;
                margin: 20px auto;
                padding: 0 20px;
            }


            /* =========================================================
                       FOOTER
                       ========================================================= */

            .main-footer {
                width: 100%;
                padding: 20px;
                margin-top: 30px;
                background-color: #212529;
                color: #adb5bd;
                text-align: center;
                font-size: 14px;
            }


            /* =========================================================
                       RESPONSIVE
                       ========================================================= */

            @@media (max-width: 1200px) {

                .notification-button {
                    width: 100px;
                    min-width: 100px;
                }

                .navbar-inner {
                    gap: 10px;
                    padding-left: 15px;
                    padding-right: 15px;
                }

                .navbar-search {
                    max-width: 550px;
                }

                .navbar-link,
                .cart-button,
                .navbar-action-link {
                    width: 100px;
                    min-width: 100px;
                    padding: 0 6px;
                }

                .user-name {
                    max-width: 220px;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
            }


            @@media (max-width: 992px) {

                .navbar-inner {
                    flex-wrap: wrap;
                    padding-top: 12px;
                    padding-bottom: 12px;
                }

                .navbar-search {
                    order: 3;
                    flex-basis: 100%;
                    max-width: none;
                    margin-left: 0;
                    margin-top: 5px;
                }

                .navbar-links {
                    margin-left: auto;
                }

                .user-area {
                    margin-left: 0;
                }
            }


            @@media (max-width: 768px) {

                .store-logo {
                    font-size: 21px;
                }

                .navbar-inner {
                    gap: 8px;
                }

                .navbar-links {
                    gap: 3px;
                }

                .navbar-link,
                .filter-button,
                .cart-button,
                .navbar-action-link,
                .login-button,
                .logout-button {
                    padding-left: 8px;
                    padding-right: 8px;
                    font-size: 13px;
                }

                .navbar-action-link,
                .cart-button {
                    width: 95px;
                    min-width: 95px;
                }

                .user-name {
                    max-width: 160px;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .filter-menu {
                    width: 280px;
                }
            }


            @@media (max-width: 576px) {

                .navbar-inner {
                    padding-left: 10px;
                    padding-right: 10px;
                }

                .store-logo {
                    font-size: 19px;
                }

                .navbar-links {
                    width: 100%;
                    justify-content: space-between;
                    order: 2;
                }

                .user-area {
                    order: 1;
                }

                .navbar-search {
                    order: 3;
                }

                .user-name {
                    display: none;
                }

                .filter-menu {
                    position: fixed;
                    top: 70px;
                    left: 10px;
                    right: 10px;
                    width: auto;
                    max-height: calc(100vh - 90px);
                }

                .navbar-action-link,
                .cart-button {
                    width: 90px;
                    min-width: 90px;
                }
            }



            /* =========================================================
               NOTIFICATION BUTTON
               ========================================================= */

            .notification-dropdown {
                position: relative;
                flex-shrink: 0;
            }

            .notification-button {
                position: relative;

                width: 110px;
                min-width: 110px;
                height: 38px;

                display: inline-flex;
                align-items: center;
                justify-content: center;

                gap: 6px;

                padding: 0 8px;

                box-sizing: border-box;

                background-color: #2b3035;
                border: 1px solid #3d4349;
                border-radius: 6px;

                color: #f1f3f5;

                font-size: 14px;
                font-weight: 400;

                white-space: nowrap;

                cursor: pointer;

                transition:
                    background-color .2s ease,
                    border-color .2s ease,
                    color .2s ease,
                    transform .15s ease,
                    box-shadow .2s ease;
            }

            .notification-button:hover {
                background-color: #3a4046;
                border-color: #495057;
                color: #fff;

                transform: translateY(-1px);

                box-shadow:
                    0 4px 10px rgba(0, 0, 0, .12);
            }

            .notification-button:active {
                transform: translateY(0);
            }


            .notification-badge {
                position: absolute;
                top: -6px;
                right: -6px;
                min-width: 19px;
                height: 19px;
                padding: 0 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                background: #dc3545;
                color: #fff;
                border: 2px solid #212529;
                font-size: 10px;
                font-weight: 700;
                line-height: 1;
            }

            @@media (max-width: 768px) {

                .notification-button {
                    width: 95px;
                    min-width: 95px;
                    font-size: 13px;
                    padding-left: 8px;
                    padding-right: 8px;
                }
            }

            @@media (max-width: 576px) {

                .notification-button {
                    width: 90px;
                    min-width: 90px;
                    font-size: 12px;
                }
            }


            /* =========================================================
               DROPDOWN
               ========================================================= */

            .notification-menu {
                display: none;
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                width: 390px;
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 14px;
                box-shadow: 0 12px 30px rgba(0,0,0,.18);
                overflow: hidden;
                z-index: 10000;
            }


                .notification-menu.show {
                    display: block;
                }


            /* =========================================================
               HEADER
               ========================================================= */

            .notification-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 18px;
                border-bottom: 1px solid #eee;
            }


            .notification-title {
                font-size: 21px;
                font-weight: 700;
                color: #222;
            }


            .notification-read-all {
                border: none;
                background: transparent;
                color: #198754;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
            }


                .notification-read-all:hover {
                    text-decoration: underline;
                }


            /* =========================================================
               LIST
               ========================================================= */

            .notification-list {
                max-height: 420px;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: #c8c8c8 transparent;
            }

                .notification-list::-webkit-scrollbar {
                    width: 6px;
                }

                .notification-list::-webkit-scrollbar-track {
                    background: transparent;
                }

                .notification-list::-webkit-scrollbar-thumb {
                    background: #c8c8c8;
                    border-radius: 10px;
                }

                    .notification-list::-webkit-scrollbar-thumb:hover {
                        background: #a8a8a8;
                    }


            /* =========================================================
               ITEM
               ========================================================= */

            .notification-item {
                margin: 0;
            }


            .notification-item-button {
                position: relative;
                width: 100%;
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 14px 16px;
                border: none;
                background: white;
                color: #222;
                text-align: left;
                cursor: pointer;
                transition: background-color .2s ease;
            }


                .notification-item-button:hover {
                    background: #f5f5f5;
                }


            .notification-item.unread .notification-item-button {
                background: #f0f7ff;
            }

                .notification-item.unread .notification-item-button:hover {
                    background: #e7f2ff;
                }


            /* =========================================================
               ICON
               ========================================================= */

            .notification-icon {
                width: 42px;
                min-width: 42px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #edf2f7;
                font-size: 19px;
            }


            /* =========================================================
               CONTENT
               ========================================================= */

            .notification-content {
                min-width: 0;
                flex: 1;
            }


            .notification-item-title {
                margin-bottom: 3px;
                font-size: 14px;
                font-weight: 700;
                color: #222;
            }


            .notification-item-text {
                color: #666;
                font-size: 13px;
                line-height: 1.45;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }


            .notification-time {
                margin-top: 5px;
                color: #999;
                font-size: 11px;
            }


            /* =========================================================
               UNREAD DOT
               ========================================================= */

            .notification-dot {
                width: 9px;
                height: 9px;
                margin-top: 18px;
                border-radius: 50%;
                background: #0d6efd;
                flex-shrink: 0;
            }


            /* =========================================================
               EMPTY
               ========================================================= */

            .notification-empty {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 45px 20px;
                color: #999;
                font-size: 14px;
            }


            /* =========================================================
               FOOTER
               ========================================================= */

            .notification-footer {
                border-top: 1px solid #eee;
                padding: 11px 15px;
                text-align: center;
            }


            .notification-view-all {
                display: block;
                color: #198754;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
            }


                .notification-view-all:hover {
                    color: #157347;
                    text-decoration: underline;
                }


            /* =========================================================
               MOBILE
               ========================================================= */

            @@media (max-width: 576px) {

                .notification-menu {
                    position: fixed;
                    top: 70px;
                    left: 10px;
                    right: 10px;
                    width: auto;
                    max-height: calc(100vh - 90px);
                }
            }

    </style>

</head>


<body>


    <!-- =========================================================
         NAVBAR
         ========================================================= -->

    <header class="main-navbar">

        <div class="navbar-inner">


            <!-- =================================================
                 LOGO
                 ================================================= -->

            <a asp-controller="Home"
               asp-action="Index"
               class="store-logo">

                Yuuji Store

            </a>


            <!-- =================================================
                 SEARCH
                 ================================================= -->

            <div class="navbar-search">

                <form asp-controller="Home"
                      asp-action="Index"
                      method="get"
                      class="search-form">

                    <input type="text"
                           name="search"
                           value="@Context.Request.Query["search"].ToString()"
                           class="search-input"
                           placeholder="Tìm kiếm sách..." />

                    <button type="submit"
                            class="search-button">

                        Tìm kiếm

                    </button>

                </form>

            </div>


            <!-- =================================================
                 NAVIGATION
                 ================================================= -->

            <div class="navbar-links">


                <!-- =================================================
                     LỌC
                     ================================================= -->

                <div class="filter-dropdown">

                    <button type="button"
                            class="filter-button"
                            onclick="toggleFilterMenu()">

                        ☰ Lọc

                    </button>


                    <!-- =================================================
                         FILTER MENU
                         ================================================= -->

                    <div id="filterMenu"
                         class="filter-menu">

                        <form asp-controller="Home"
                              asp-action="Index"
                              method="get">

                            <input type="hidden"
                                   name="search"
                                   value="@Context.Request.Query["search"].ToString()" />


                            <!-- =================================================
                                 THỂ LOẠI
                                 ================================================= -->

                            <div class="filter-section">

                                <div class="filter-title">
                                    Thể loại
                                </div>

                                @{

                                    var filterTheLoais =
                                        ViewBag.TheLoais as IEnumerable<ProjectKZM.Models.TheLoai>
                                        ?? Enumerable.Empty<ProjectKZM.Models.TheLoai>();

                                    var selectedTheLoaiIds =
                                        ViewBag.SelectedTheLoaiIds as int[]
                                        ?? Array.Empty<int>();

                                }

                                @foreach (var theLoai in filterTheLoais)
                                {

                                    <label class="filter-item">

                                        <input type="checkbox"
                                               name="theLoaiIds"
                                               value="@theLoai.MaTheLoai"
                                        @(selectedTheLoaiIds.Contains(theLoai.MaTheLoai)
                                            ? "checked"
                                            : null) />

                                        <span>
                                            @theLoai.TenTheLoai
                                        </span>

                                    </label>

                                }

                            </div>


                            <!-- =================================================
                                 LOẠI SÁCH
                                 ================================================= -->

                            <div class="filter-section">

                                <div class="filter-title">
                                    Loại sách
                                </div>

                                @{

                                    var filterLoaiSachs =
                                        ViewBag.LoaiSachs as IEnumerable<ProjectKZM.Models.LoaiSach>
                                        ?? Enumerable.Empty<ProjectKZM.Models.LoaiSach>();

                                    var selectedLoaiSachIds =
                                        ViewBag.SelectedLoaiSachIds as int[]
                                        ?? Array.Empty<int>();

                                }

                                @foreach (var loaiSach in filterLoaiSachs)
                                {

                                    <label class="filter-item">

                                        <input type="checkbox"
                                               name="loaiSachIds"
                                               value="@loaiSach.MaLoaiSach"
                                        @(selectedLoaiSachIds.Contains(loaiSach.MaLoaiSach)
                                            ? "checked"
                                            : null) />

                                        <span>
                                            @loaiSach.TenLoaiSach
                                        </span>

                                    </label>

                                }

                            </div>


                            <!-- =================================================
                                 BUTTON
                                 ================================================= -->

                            <div class="filter-actions">

                                <button type="submit"
                                        class="filter-apply">

                                    Áp dụng

                                </button>


                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="filter-clear">

                                    Xóa lọc

                                </a>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- =================================================
                     TRANG CHỦ
                     ================================================= -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="navbar-link navbar-action-link">

                    🏠 Trang chủ

                </a>


                <!-- =================================================
                     YÊU THÍCH
                     USER + ADMIN ĐỀU CÓ
                     ================================================= -->
                @if (User.Identity?.IsAuthenticated == true)
                {

                    <a asp-controller="YeuThichs"
                       asp-action="Index"
                       class="navbar-link navbar-action-link">

                        ❤️ Yêu thích

                    </a>

                }

            </div>


            <!-- =================================================
                 USER AREA
                 ================================================= -->

            <div class="user-area">

                

                <!-- =================================================
                     GIỎ HÀNG
                     ================================================= -->

                <a asp-controller="GioHangs"
                   asp-action="Index"
                   class="navbar-link navbar-action-link">

                    🛒 Giỏ hàng

                </a>

                <!-- =====================================================
     THÔNG BÁO
     ===================================================== -->
            
                @if (User.Identity?.IsAuthenticated == true)
                {
                        

                
                    var layoutNotifications =
                        await ThongBaoService
                            .GetNotificationsAsync(10);

                    var unreadNotificationCount =
                        await ThongBaoService
                            .GetUnreadCountAsync();
                


                <div class="notification-dropdown">

                    <!-- =================================================
                         BUTTON
                         ================================================= -->

                    <button type="button"
                            class="notification-button"
                            onclick="toggleNotificationMenu()"
                            title="Thông báo">

                        <span>
                            🔔 Thông báo
                        </span>

                        @if (unreadNotificationCount > 0)
                        {
                            <span class="notification-badge">

                                @(unreadNotificationCount > 99
                                    ? "99+"
                                    : unreadNotificationCount.ToString())

                            </span>
                        }

                    </button>


                    <!-- =================================================
                         NOTIFICATION MENU
                         ================================================= -->

                    <div id="notificationMenu"
                         class="notification-menu">


                        <!-- =================================================
                             HEADER
                             ================================================= -->

                        <div class="notification-header">

                            <div class="notification-title">
                                Thông báo
                            </div>


                            @if (unreadNotificationCount > 0)
                            {
                                <form asp-controller="ThongBaos"
                                      asp-action="DaDocTatCa"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="notification-read-all">

                                        Đánh dấu đã đọc

                                    </button>

                                </form>
                            }

                        </div>


                        <!-- =================================================
                             LIST
                             ================================================= -->

                        <div class="notification-list">

                            @if (!layoutNotifications.Any())
                            {
                                <div class="notification-empty">

                                    <div style="font-size:28px;">
                                        🔕
                                    </div>

                                    <span>
                                        Chưa có thông báo
                                    </span>

                                </div>
                            }
                            else
                            {
                                foreach (var notification
                                        in layoutNotifications.Take(10))
                                {
                                    <form asp-controller="ThongBaos"
                                          asp-action="DaDoc"
                                          method="post"
                                          class="notification-item
                                                 @(notification.DaDoc
                                                     ? ""
                                                     : "unread")">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notification.MaThongBao" />


                                        <button type="submit"
                                                class="notification-item-button">


                                            <!-- ICON -->

                                            <div class="notification-icon">

                                                @if (notification.Loai == "COD")
                                                {
                                                    <span>💵</span>
                                                }
                                                else if (notification.Loai == "BANK")
                                                {
                                                    <span>🏦</span>
                                                }
                                                else if (notification.Loai == "VNPAY")
                                                {
                                                    <span>💳</span>
                                                }
                                                else if (notification.Loai == "XAC_NHAN")
                                                {
                                                    <span>✅</span>
                                                }
                                                else if (notification.Loai == "HUY")
                                                {
                                                    <span>❌</span>
                                                }
                                                else
                                                {
                                                    <span>🔔</span>
                                                }

                                            </div>


                                            <!-- CONTENT -->

                                            <div class="notification-content">

                                                <div class="notification-item-title">

                                                    @notification.TieuDe

                                                </div>


                                                <div class="notification-item-text">

                                                    @notification.NoiDung

                                                </div>


                                                <div class="notification-time">

                                                    @notification.NgayTao.ToString(
                                                        "dd/MM/yyyy HH:mm")

                                                </div>

                                            </div>


                                            <!-- UNREAD -->

                                            @if (!notification.DaDoc)
                                            {
                                                <span class="notification-dot"></span>
                                            }

                                        </button>

                                    </form>
                                }
                            }

                        </div>


                        <!-- =================================================
                             XEM TẤT CẢ
                             ================================================= -->

                        <div class="notification-footer">

                            <a asp-controller="ThongBaos"
                               asp-action="Index"
                               class="notification-view-all">

                                Xem tất cả

                            </a>

                        </div>

                    </div>

                </div>
                    }

                <!-- =================================================
                     ĐÃ ĐĂNG NHẬP
                     ================================================= -->
                @if (User.Identity?.IsAuthenticated == true)
                {

                    <!-- =================================================
                         ADMIN
                         ================================================= -->
                    @if (User.IsInRole("Admin"))
                    {

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="navbar-link navbar-action-link">

                            Quản lý

                        </a>

                    }
                    else
                    {

                        <!-- =================================================
                             USER
                             ================================================= -->

                        <div class="user-dropdown">

                            <button type="button"
                                    class="navbar-link navbar-action-link user-button"
                                    onclick="toggleUserMenu()">

                                Thông tin ▾

                            </button>


                            <div id="userMenu"
                                 class="user-menu">


                                <!-- =================================================
             THÔNG TIN ĐƠN HÀNG
             ================================================= -->

                                <div class="user-menu-section">

                                    <div class="user-menu-title">
                                        Thông tin đơn hàng
                                    </div>


                                    <a asp-controller="DonHangs"
                                       asp-action="LichSu">

                                        <span class="user-menu-icon">
                                            🧾
                                        </span>

                                        <span>
                                            Lịch sử mua hàng
                                        </span>

                                    </a>

                                </div>


                                <!-- =================================================
             THÔNG TIN NGƯỜI DÙNG
             ================================================= -->

                                <div class="user-menu-section">

                                    <div class="user-menu-title">
                                        Thông tin người dùng
                                    </div>


                                    <a asp-controller="Account"
                                       asp-action="Profile">

                                        <span class="user-menu-icon">
                                            👤
                                        </span>

                                        <span>
                                            Xem thông tin cá nhân
                                        </span>

                                    </a>


                                    <a asp-controller="Account"
                                       asp-action="EditProfile">

                                        <span class="user-menu-icon">
                                            ✏️
                                        </span>

                                        <span>
                                            Sửa thông tin cá nhân
                                        </span>

                                    </a>

                                </div>

                            </div>

                        </div>


                    }



                    <!-- =================================================
                         XIN CHÀO
                         ================================================= -->

                    <span class="user-name">

                        Xin chào, @(User.Identity?.Name ?? "Người dùng")

                    </span>


                    <!-- =================================================
                         ĐĂNG XUẤT
                         ================================================= -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          style="margin: 0;">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">

                            Đăng xuất

                        </button>

                    </form>

                }
                else
                {

                    <!-- =================================================
                         CHƯA ĐĂNG NHẬP
                         ================================================= -->

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="register-button">

                        Đăng ký

                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login-button">

                        Đăng nhập

                    </a>
                }

            </div>

        </div>

    </header>


    <!-- =========================================================
         SUCCESS ALERT
         ========================================================= -->
    @if (TempData["Success"] != null)
    {

        <div class="site-alert">

            <div class="alert alert-success">

                @TempData["Success"]

            </div>

        </div>

    }


    <!-- =========================================================
         ERROR ALERT
         ========================================================= -->
    @if (TempData["Error"] != null)
    {

        <div class="site-alert">

            <div class="alert alert-danger">

                @TempData["Error"]

            </div>

        </div>

    }


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <main class="main-content">

        @RenderBody()

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="main-footer">

        © @DateTime.Now.Year - Yuuji Store

    </footer>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =========================================================
         FILTER MENU SCRIPT
         ========================================================= -->

    <script>

            function toggleFilterMenu() {

                const menu =
                    document.getElementById("filterMenu");

                if (menu) {

                    menu.classList.toggle("show");

                }

            }


            document.addEventListener("click", function(event) {

                const menu =
                    document.getElementById("filterMenu");

                const button =
                    document.querySelector(".filter-button");

                if (!menu || !button) {

                    return;

                }

                if (!menu.contains(event.target) &&
                    !button.contains(event.target)) {

                    menu.classList.remove("show");

                }

            });


            document
                .getElementById("filterMenu")
                ?.addEventListener("click", function(event) {

                    event.stopPropagation();

                });

    </script>


    <!-- =========================================================
         USER MENU SCRIPT
         ========================================================= -->

    <script>

            function toggleUserMenu() {

                const menu =
                    document.getElementById("userMenu");

                if (menu) {

                    menu.classList.toggle("show");

                }

            }


            document.addEventListener("click", function(event) {

                const menu =
                    document.getElementById("userMenu");

                const button =
                    document.querySelector(".user-button");

                if (!menu || !button) {

                    return;

                }

                if (!menu.contains(event.target) &&
                    !button.contains(event.target)) {

                    menu.classList.remove("show");

                }

            });

    </script>


    <!-- =========================================================
         GIỎ HÀNG - CARD SẢN PHẨM
         ========================================================= -->

    <script>

            document.addEventListener("submit", async function(event) {

                const form = event.target;


                /*
                 * Chỉ bắt các form thêm sách vào giỏ.
                 */

                if (!form.matches(
                    'form[action*="/GioHangs/Them"]'
                )) {

                    return;

                }


                /*
                 * Chặn chuyển trang.
                 */

                event.preventDefault();


                const button =
                    form.querySelector(
                        'button[type="submit"]'
                    );


                if (!button) {

                    return;

                }


                /*
                 * Lưu nội dung ban đầu.
                 */

                const originalText =
                    button.innerHTML;


                /*
                 * Gửi request.
                 */

                try {

                    const response =
                        await fetch(
                            form.action,
                            {
                                method: "POST",
                                body: new FormData(form)
                            }
                        );


                    if (response.ok) {

                        /*
                         * Đổi button thành công
                         */

                        button.innerHTML =
                            "✓ Đã thêm vào giỏ";

                        button.style.backgroundColor =
                            "#198754";

                        button.style.borderColor =
                            "#198754";

                        button.style.color =
                            "white";

                        button.disabled =
                            true;


                        /*
                         * Sau 2 giây trả lại.
                         */

                        setTimeout(function() {

                            button.innerHTML =
                                originalText;

                            button.style.backgroundColor =
                                "";

                            button.style.borderColor =
                                "";

                            button.style.color =
                                "";

                            button.disabled =
                                false;

                        }, 2000);

                    }
                    else {

                        button.innerHTML =
                            originalText;

                        button.disabled =
                            false;

                    }

                }
                catch (error) {

                    button.innerHTML =
                        originalText;

                    button.disabled =
                        false;

                }

            });



    </script>
    <script>

            function toggleNotificationMenu() {

                const menu =
                    document.getElementById(
                        "notificationMenu"
                    );

                if (!menu) {
                    return;
                }

                menu.classList.toggle("show");
            }


            document.addEventListener(
                "click",
                function(event) {

                    const menu =
                        document.getElementById(
                            "notificationMenu"
                        );

                    const button =
                        document.querySelector(
                            ".notification-button"
                        );

                    if (!menu || !button) {
                        return;
                    }


                    if (
                        !menu.contains(event.target) &&
                        !button.contains(event.target)
                    ) {

                        menu.classList.remove(
                            "show"
                        );

                    }

                }
            );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>