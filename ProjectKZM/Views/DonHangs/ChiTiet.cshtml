@model ProjectKZM.ViewModels.DonHangChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<style>
    .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 80px;
    }

    .title {
        font-size: 36px;
        margin-bottom: 25px;
        font-weight: 400;
    }

    .box {
        background: #fff;
        border: 1px solid #e5e5e5;
        padding: 25px;
        margin-bottom: 20px;
    }

    .row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 8px 0;
    }

    .products {
        width: 100%;
        border-collapse: collapse;
    }

        .products th,
        .products td {
            padding: 13px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }

    .total {
        display: flex;
        justify-content: space-between;
        font-size: 20px;
        font-weight: 600;
        padding-top: 20px;
    }

    .product-image {
        width: 55px;
        height: 75px;
        object-fit: cover;
        background: #eee;
    }
</style>


<div class="page">

    <h1 class="title">
        Đơn hàng #@Model.MaDonHang
    </h1>


    <div class="box">

        <div class="row">
            <strong>Khách hàng</strong>
            <span>@Model.TenKhachHang</span>
        </div>

        <div class="row">
            <strong>Email</strong>
            <span>@Model.EmailKhachHang</span>
        </div>

        <div class="row">
            <strong>Ngày đặt</strong>
            <span>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <div class="row">
            <strong>Phương thức</strong>
            <span>@Model.PhuongThucThanhToan</span>
        </div>

        <div class="row">
            <strong>Trạng thái</strong>
            <span>@Model.TrangThai</span>
        </div>

        <div class="row">
            <strong>Địa chỉ giao hàng</strong>
            <span>@Model.DiaChiGiaoHang</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
        {
            <div class="row">
                <strong>Ghi chú</strong>
                <span>@Model.GhiChu</span>
            </div>
        }

    </div>


    <div class="box">

        <table class="products">

            <thead>

                <tr>
                    <th>Sách</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model.SanPhams)
                {
                    <tr>

                        <td>

                            @if (!string.IsNullOrWhiteSpace(item.Hinh))
                            {
                                <img src="@item.Hinh"
                                     class="product-image"
                                     alt="@item.TenSach" />
                            }

                            <span>
                                @item.TenSach
                            </span>

                        </td>

                        <td>
                            @item.SoLuong
                        </td>

                        <td>
                            @item.DonGia.ToString("N0") VNĐ
                        </td>

                        <td>
                            @item.ThanhTien.ToString("N0") VNĐ
                        </td>

                    </tr>
                }

            </tbody>

        </table>


        <div class="total">

            <span>
                Tổng tiền
            </span>

            <span>
                @Model.TongTien.ToString("N0") VNĐ
            </span>

        </div>

    </div>

</div>