@model ProjectKZM.ViewModels.ThongKeDonHangViewModel

@{
    ViewData["Title"] = "Thống kê đơn hàng";
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .statistics-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 50px 20px 80px;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .statistics-header {
        margin-bottom: 32px;
    }

    .statistics-title {
        margin: 0;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: -0.7px;
        color: #222;
    }

    .statistics-subtitle {
        margin: 9px 0 0;
        color: #888;
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
           GENERAL GRID
           ========================================================= */

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 18px;
    }


    /* =========================================================
           STAT CARD
           ========================================================= */

    .stat-card {
        position: relative;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 23px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.045);
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .08);
            border-color: #d8d8d8;
        }


        /* =========================================================
           TOP ACCENT
           ========================================================= */

        .stat-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: #212529;
            opacity: .9;
        }


    /* =========================================================
           ICON
           ========================================================= */

    .stat-icon {
        width: 42px;
        height: 42px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f3f3f3;
        font-size: 19px;
    }


    /* =========================================================
           LABEL
           ========================================================= */

    .stat-label {
        margin-bottom: 9px;
        color: #888;
        font-size: 13px;
        font-weight: 500;
    }


    /* =========================================================
           VALUE
           ========================================================= */

    .stat-value {
        font-size: 30px;
        font-weight: 700;
        color: #222;
        line-height: 1.15;
    }


    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .stat-description {
        margin-top: 8px;
        color: #aaa;
        font-size: 12px;
    }


    /* =========================================================
           COLOR VARIANTS
           ========================================================= */

    .stat-total::before {
        background: #212529;
    }

    .stat-total .stat-icon {
        background: #f0f0f0;
        color: #212529;
    }


    .stat-success::before {
        background: #198754;
    }

    .stat-success .stat-icon {
        background: #edf8f0;
        color: #198754;
    }


    .stat-waiting::before {
        background: #f0ad00;
    }

    .stat-waiting .stat-icon {
        background: #fff6df;
        color: #b47a00;
    }


    .stat-danger::before {
        background: #dc3545;
    }

    .stat-danger .stat-icon {
        background: #fff0f1;
        color: #dc3545;
    }


    /* =========================================================
           TOTAL REVENUE
           ========================================================= */

    .revenue-card {
        position: relative;
        margin-bottom: 18px;
        padding: 28px;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, .045);
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .revenue-card:hover {
            transform: translateY(-3px);
            border-color: #d8d8d8;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .08);
        }


        .revenue-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: #198754;
        }


    .revenue-label {
        margin-bottom: 10px;
        color: #777;
        font-size: 14px;
        font-weight: 500;
    }


    .revenue-value {
        font-size: 38px;
        font-weight: 700;
        color: #198754;
        letter-spacing: -0.8px;
    }


    .revenue-description {
        margin-top: 7px;
        color: #aaa;
        font-size: 12px;
    }


    /* =========================================================
           PAYMENT REVENUE
           ========================================================= */

    .payment-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }


    .payment-card {
        position: relative;
        padding: 23px;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, .045);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .payment-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .08);
            border-color: #d8d8d8;
        }


    .payment-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }


    .payment-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 18px;
    }


    .payment-name {
        font-size: 14px;
        font-weight: 600;
        color: #333;
    }


    .payment-value {
        font-size: 25px;
        font-weight: 700;
        color: #222;
    }


    .payment-vnpay .payment-icon {
        background: #eef6ff;
        color: #1769aa;
    }

    .payment-cod .payment-icon {
        background: #edf8f0;
        color: #198754;
    }

    .payment-bank .payment-icon {
        background: #f4efff;
        color: #6842a6;
    }


    /* =========================================================
           BACK BUTTON
           ========================================================= */

    .back-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }


    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 17px;
        border: 1px solid #d8d8d8;
        border-radius: 8px;
        background: #fff;
        color: #555;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }


        .back-button:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 13px rgba(0, 0, 0, .12);
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 950px) {

        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .payment-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .statistics-page {
            padding: 35px 15px 60px;
        }

        .statistics-title {
            font-size: 30px;
        }

        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .stat-value {
            font-size: 27px;
        }

        .revenue-value {
            font-size: 32px;
        }
    }

    /* =========================================================
       CHART SECTION
       ========================================================= */

    .chart-section {
        margin-top: 25px;
    }


    .chart-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }


    .chart-title {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
        color: #222;
    }


    .chart-subtitle {
        margin: 7px 0 0;
        color: #888;
        font-size: 13px;
    }


    /* =========================================================
       PERIOD BUTTON
       ========================================================= */

    .chart-period {
        display: flex;
        gap: 6px;
        padding: 4px;
        background: #f2f2f2;
        border: 1px solid #e2e2e2;
        border-radius: 9px;
    }


    .period-button {
        height: 34px;
        padding: 0 14px;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: #666;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease, box-shadow .2s ease;
    }


        .period-button:hover {
            background: #fff;
            color: #222;
        }


        .period-button.active {
            background: #212529;
            color: #fff;
            box-shadow: 0 3px 8px rgba(0,0,0,.12);
        }


    /* =========================================================
       CHART CARD
       ========================================================= */

    .chart-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 6px 20px rgba(0,0,0,.045);
    }


    .chart-card-header {
        margin-bottom: 18px;
    }


    .chart-card-title {
        font-size: 16px;
        font-weight: 600;
        color: #333;
    }


    .chart-container {
        position: relative;
        width: 100%;
        height: 360px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 700px) {

        .chart-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .chart-container {
            height: 300px;
        }

        .chart-period {
            width: 100%;
        }

        .period-button {
            flex: 1;
        }
    }

</style>


<div class="statistics-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="statistics-header">

        <h1 class="statistics-title">
            Thống kê đơn hàng
        </h1>

        <p class="statistics-subtitle">
            Tổng quan tình hình đơn hàng và doanh thu của hệ thống
        </p>

    </div>


    <!-- =====================================================
         ORDER STATISTICS
         ===================================================== -->

    <div class="statistics-grid">


        <!-- TỔNG ĐƠN -->

        <div class="stat-card stat-total">

            <div class="stat-icon">
                📦
            </div>

            <div class="stat-label">
                Tổng số đơn
            </div>

            <div class="stat-value">
                @Model.TongSoDon
            </div>

            <div class="stat-description">
                Tổng số đơn hàng trong hệ thống
            </div>

        </div>


        <!-- ĐÃ XÁC NHẬN -->

        <div class="stat-card stat-success">

            <div class="stat-icon">
                ✓
            </div>

            <div class="stat-label">
                Đã xác nhận
            </div>

            <div class="stat-value">
                @Model.SoDonDaXacNhan
            </div>

            <div class="stat-description">
                Đơn hàng đã được xử lý
            </div>

        </div>


        <!-- CHỜ XÁC NHẬN -->

        <div class="stat-card stat-waiting">

            <div class="stat-icon">
                ⏳
            </div>

            <div class="stat-label">
                Chờ xác nhận
            </div>

            <div class="stat-value">
                @Model.SoDonChoXacNhan
            </div>

            <div class="stat-description">
                Đơn hàng cần Admin kiểm tra
            </div>

        </div>


        <!-- ĐÃ HỦY -->

        <div class="stat-card stat-danger">

            <div class="stat-icon">
                ×
            </div>

            <div class="stat-label">
                Đã hủy
            </div>

            <div class="stat-value">
                @Model.SoDonDaHuy
            </div>

            <div class="stat-description">
                Đơn hàng đã bị hủy
            </div>

        </div>

    </div>


    <!-- =====================================================
         TOTAL REVENUE
         ===================================================== -->

    <div class="revenue-card">

        <div class="revenue-label">
            Tổng doanh thu
        </div>

        <div class="revenue-value">
            @Model.TongDoanhThu.ToString("N0") VNĐ
        </div>

        <div class="revenue-description">
            Tổng giá trị doanh thu từ các đơn hàng
        </div>

    </div>

    


    <!-- =====================================================
         REVENUE BY PAYMENT METHOD
         ===================================================== -->

    <div class="payment-grid">


        <!-- VNPAY -->

        <div class="payment-card payment-vnpay">

            <div class="payment-header">

                <div class="payment-icon">
                    💳
                </div>

                <div class="payment-name">
                    Doanh thu VNPAY
                </div>

            </div>

            <div class="payment-value">
                @Model.DoanhThuVNPAY.ToString("N0") VNĐ
            </div>

        </div>


        <!-- COD -->

        <div class="payment-card payment-cod">

            <div class="payment-header">

                <div class="payment-icon">
                    💵
                </div>

                <div class="payment-name">
                    Doanh thu COD
                </div>

            </div>

            <div class="payment-value">
                @Model.DoanhThuCOD.ToString("N0") VNĐ
            </div>

        </div>


        <!-- BANK -->

        <div class="payment-card payment-bank">

            <div class="payment-header">

                <div class="payment-icon">
                    🏦
                </div>

                <div class="payment-name">
                    Doanh thu chuyển khoản
                </div>

            </div>

            <div class="payment-value">
                @Model.DoanhThuChuyenKhoan.ToString("N0") VNĐ
            </div>

        </div>

    </div>

    <!-- =====================================================
     BIỂU ĐỒ DOANH THU
     ===================================================== -->

    <div class="chart-section">

        <div class="chart-header">

            <div>

                <h2 class="chart-title">
                    Doanh thu theo thời gian
                </h2>

                <p class="chart-subtitle">
                    Theo dõi doanh thu theo từng phương thức thanh toán
                </p>

            </div>


            <!-- =================================================
             CHỌN THỜI GIAN
             ================================================= -->

            <div class="chart-period">

                <button type="button"
                        class="period-button active"
                        data-period="week">

                    Tuần

                </button>


                <button type="button"
                        class="period-button"
                        data-period="month">

                    Tháng

                </button>


                <button type="button"
                        class="period-button"
                        data-period="year">

                    Năm

                </button>

            </div>

        </div>


        <!-- =====================================================
         CHART CỘT
         ===================================================== -->

        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-card-title">
                    📊 Doanh thu theo kỳ
                </div>

            </div>

            <div class="chart-container">

                <canvas id="revenueBarChart">
                </canvas>

            </div>

        </div>


        <!-- =====================================================
         CHART ĐƯỜNG
         ===================================================== -->

        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-card-title">
                    📈 Xu hướng doanh thu
                </div>

            </div>

            <div class="chart-container">

                <canvas id="revenueLineChart">
                </canvas>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BACK
         ===================================================== -->

    <div class="back-wrapper">

        <a asp-controller="DonHangs"
           asp-action="Index"
           class="back-button">

            ← Quay lại quản lý đơn hàng

        </a>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@section Scripts {

    <script>

        let revenueBarChart = null;
        let revenueLineChart = null;


        // =====================================================
        // FORMAT VNĐ
        // =====================================================

        function formatVnd(value) {

            return new Intl.NumberFormat(
                "vi-VN"
            ).format(value) + " VNĐ";

        }


        // =====================================================
        // TẠO DATASET
        // =====================================================

        function createDatasets(data) {

            return [

                {
                    label: "VNPAY",
                    data: data.vnpay,
                    borderWidth: 2,
                    tension: 0.35
                },

                {
                    label: "Chuyển khoản",
                    data: data.bank,
                    borderWidth: 2,
                    tension: 0.35
                },

                {
                    label: "COD",
                    data: data.cod,
                    borderWidth: 2,
                    tension: 0.35
                }

            ];

        }


        // =====================================================
        // TẢI DỮ LIỆU
        // =====================================================

        async function loadRevenueChart(period) {

            try {

                const response =
                    await fetch(
                        '@Url.Action("DoanhThuChart", "DonHangs")'
                        + '?period='
                        + encodeURIComponent(period)
                    );


                if (!response.ok) {

                    throw new Error(
                        "Không thể lấy dữ liệu thống kê."
                    );

                }


                const data =
                    await response.json();


                updateCharts(data);

            }
            catch (error) {

                console.error(
                    error
                );

            }

        }


        // =====================================================
        // UPDATE CHART
        // =====================================================

        function updateCharts(data) {

            const barCanvas =
                document.getElementById(
                    "revenueBarChart"
                );


            const lineCanvas =
                document.getElementById(
                    "revenueLineChart"
                );


            if (!barCanvas ||
                !lineCanvas) {

                return;

            }


            // =================================================
            // XÓA CHART CŨ
            // =================================================

            if (revenueBarChart) {

                revenueBarChart.destroy();

            }


            if (revenueLineChart) {

                revenueLineChart.destroy();

            }


            const datasets =
                createDatasets(data);


            // =================================================
            // BAR CHART
            // =================================================

            revenueBarChart =
                new Chart(
                    barCanvas,
                    {
                        type: "bar",

                        data:
                        {
                            labels:
                                data.labels,

                            datasets:
                                datasets.map(
                                    x => ({
                                        ...x
                                    })
                                )
                        },

                        options:
                        {
                            responsive: true,

                            maintainAspectRatio: false,

                            interaction:
                            {
                                mode: "index",
                                intersect: false
                            },

                            plugins:
                            {
                                legend:
                                {
                                    position:
                                        "top"
                                },

                                tooltip:
                                {
                                    callbacks:
                                    {
                                        label:
                                            function(context) {

                                                return (
                                                    context.dataset.label
                                                    + ": "
                                                    + formatVnd(
                                                        context.raw
                                                    )
                                                );

                                            }
                                    }
                                }
                            },

                            scales:
                            {
                                y:
                                {
                                    beginAtZero:
                                        true,

                                    ticks:
                                    {
                                        callback:
                                            function(value) {

                                                return new Intl.NumberFormat(
                                                    "vi-VN",
                                                    {
                                                        notation:
                                                            "compact"
                                                    }
                                                ).format(value);

                                            }
                                    }
                                }
                            }
                        }

                    }
                );


            // =================================================
            // LINE CHART
            // =================================================

            revenueLineChart =
                new Chart(
                    lineCanvas,
                    {
                        type: "line",

                        data:
                        {
                            labels:
                                data.labels,

                            datasets:
                                datasets.map(
                                    x => ({
                                        ...x,
                                        fill: false
                                    })
                                )
                        },

                        options:
                        {
                            responsive: true,

                            maintainAspectRatio: false,

                            interaction:
                            {
                                mode: "index",
                                intersect: false
                            },

                            plugins:
                            {
                                legend:
                                {
                                    position:
                                        "top"
                                },

                                tooltip:
                                {
                                    callbacks:
                                    {
                                        label:
                                            function(context) {

                                                return (
                                                    context.dataset.label
                                                    + ": "
                                                    + formatVnd(
                                                        context.raw
                                                    )
                                                );

                                            }
                                    }
                                }
                            },

                            scales:
                            {
                                y:
                                {
                                    beginAtZero:
                                        true,

                                    ticks:
                                    {
                                        callback:
                                            function(value) {

                                                return new Intl.NumberFormat(
                                                    "vi-VN",
                                                    {
                                                        notation:
                                                            "compact"
                                                    }
                                                ).format(value);

                                            }
                                    }
                                }
                            }
                        }

                    }
                );

        }


        // =====================================================
        // ĐỔI TUẦN / THÁNG / NĂM
        // =====================================================

        document
            .querySelectorAll(
                ".period-button"
            )
            .forEach(
                function(button) {

                    button.addEventListener(
                        "click",
                        function() {

                            document
                                .querySelectorAll(
                                    ".period-button"
                                )
                                .forEach(
                                    function(item) {

                                        item.classList.remove(
                                            "active"
                                        );

                                    }
                                );


                            button.classList.add(
                                "active"
                            );


                            const period =
                                button.getAttribute(
                                    "data-period"
                                );


                            loadRevenueChart(
                                period
                            );

                        }
                    );

                }
            );


        // =====================================================
        // MẶC ĐỊNH: TUẦN
        // =====================================================

        loadRevenueChart(
            "week"
        );

    </script>

}