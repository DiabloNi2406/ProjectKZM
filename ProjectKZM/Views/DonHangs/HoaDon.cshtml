@model ProjectKZM.ViewModels.DonHangChiTietViewModel

@{
    ViewData["Title"] = "Hóa đơn bán hàng";

    string maHoaDon = $"HD-{Model.MaDonHang:D6}";

    string paymentText = Model.PhuongThucThanhToan switch
    {
        "VNPAY" => "VNPAY",
        "COD" => "Thanh toán khi nhận hàng",
        "BANK" => "Chuyển khoản ngân hàng",
        _ => Model.PhuongThucThanhToan ?? "Chưa xác định"
    };

    string statusClass = Model.TrangThai switch
    {
        "Đã thanh toán" => "invoice-status-paid",
        "Đã xác nhận" => "invoice-status-confirmed",
        "Đã hủy" => "invoice-status-cancelled",
        "Chờ thanh toán" => "invoice-status-pending",
        "Chờ Admin xác nhận" => "invoice-status-pending",
        _ => "invoice-status-default"
    };
}

<style>
    /* =====================================================
           PAGE
           ===================================================== */

    .green-invoice-page {
        max-width: 960px;
        margin: 0 auto;
        padding: 38px 20px 60px;
        color: #303a33;
        font-family: Arial, Helvetica, sans-serif;
    }

    .green-invoice-paper {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e0e7e1;
        border-radius: 12px;
        box-shadow: 0 8px 28px rgba(35, 75, 48, .06);
    }

    .green-invoice-topline {
        height: 6px;
        background: #198754;
    }

    .green-invoice-content {
        padding: 38px 42px;
    }

    /* =====================================================
           HEADER
           ===================================================== */

    .green-invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        padding-bottom: 27px;
        border-bottom: 1px solid #e4ebe5;
    }

    .green-invoice-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .green-invoice-logo {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #198754;
        color: white;
        border-radius: 10px;
        font-size: 25px;
        font-weight: 700;
    }

    .green-invoice-store-name {
        margin: 0;
        color: #176b40;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -.5px;
    }

    .green-invoice-tagline {
        margin: 5px 0 0;
        color: #859087;
        font-size: 11px;
    }

    .green-invoice-brand-note {
        margin-top: 16px;
        color: #7c877e;
        font-size: 12px;
        line-height: 1.8;
    }

    .green-invoice-heading {
        min-width: 220px;
        text-align: right;
    }

        .green-invoice-heading h1 {
            margin: 0;
            color: #176b40;
            font-size: 27px;
            font-weight: 700;
            line-height: 1.3;
        }

    .green-invoice-heading-label {
        margin-bottom: 7px;
        color: #8b958d;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .green-invoice-code {
        margin-top: 10px;
        color: #198754;
        font-size: 14px;
        font-weight: 700;
    }

    .green-invoice-date {
        margin-top: 7px;
        color: #79847c;
        font-size: 12px;
    }

    /* =====================================================
           STATUS
           ===================================================== */

    .green-invoice-status {
        display: inline-flex;
        margin-top: 11px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
    }

    .invoice-status-paid,
    .invoice-status-confirmed {
        background: #e8f5ed;
        color: #237447;
    }

    .invoice-status-pending {
        background: #fff4dc;
        color: #926200;
    }

    .invoice-status-cancelled {
        background: #fdebed;
        color: #b02a37;
    }

    .invoice-status-default {
        background: #edf1ee;
        color: #59665d;
    }

    /* =====================================================
           SECTION HEADINGS
           ===================================================== */

    .green-invoice-section {
        margin-top: 29px;
    }

    .green-invoice-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 16px;
        color: #28543a;
        font-size: 14px;
        font-weight: 700;
    }

    .green-invoice-section-number {
        width: 27px;
        height: 27px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #eaf4ed;
        color: #198754;
        font-size: 11px;
        font-weight: 700;
    }

    /* =====================================================
           CUSTOMER INFORMATION
           ===================================================== */

    .green-invoice-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 28px;
        padding: 10px 22px;
        border: 1px solid #e3ebe4;
        border-radius: 9px;
        background: #fcfdfc;
    }

    .green-invoice-info-item {
        min-width: 0;
        padding: 13px 0;
        border-bottom: 1px solid #edf1ed;
    }

        .green-invoice-info-item:nth-last-child(-n+2) {
            border-bottom: none;
        }

    .green-invoice-info-label {
        display: block;
        margin-bottom: 6px;
        color: #879187;
        font-size: 11px;
    }

    .green-invoice-info-value {
        color: #344238;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    /* =====================================================
           PRODUCT TABLE
           ===================================================== */

    .green-invoice-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .green-invoice-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .green-invoice-table thead th {
            padding: 14px 12px;
            background: #198754;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .35px;
            text-align: left;
            white-space: nowrap;
        }

            .green-invoice-table thead th:first-child {
                border-radius: 7px 0 0 0;
            }

            .green-invoice-table thead th:last-child {
                border-radius: 0 7px 0 0;
            }

        .green-invoice-table tbody td {
            padding: 16px 12px;
            border-bottom: 1px solid #e9eee9;
            color: #536056;
            vertical-align: middle;
        }

        .green-invoice-table tbody tr:nth-child(even) {
            background: #f8fbf8;
        }

        .green-invoice-table tbody tr:last-child td {
            border-bottom: 1px solid #dce6dd;
        }

        .green-invoice-table .green-number {
            text-align: right;
            white-space: nowrap;
        }

        .green-invoice-table .green-center {
            text-align: center;
        }

    .green-invoice-product-name {
        min-width: 160px;
        color: #303d33 !important;
        font-weight: 600;
        line-height: 1.6;
    }

    .green-invoice-product-total {
        color: #198754 !important;
        font-weight: 700;
    }

    /* =====================================================
           SUMMARY
           ===================================================== */

    .green-invoice-summary-area {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .green-invoice-summary {
        width: 350px;
        max-width: 100%;
        padding: 20px;
        border: 1px solid #dce9df;
        border-radius: 9px;
        background: #f5faf6;
    }

    .green-invoice-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 7px 0;
        color: #78847a;
        font-size: 12px;
        line-height: 1.6;
    }

        .green-invoice-summary-row strong {
            color: #354438;
            text-align: right;
            overflow-wrap: anywhere;
        }

    .green-invoice-summary-divider {
        height: 1px;
        margin: 10px 0;
        background: #dce8de;
    }

    .green-invoice-grand-label {
        color: #245b3a;
        font-size: 13px;
        font-weight: 700;
    }

    .green-invoice-grand-total {
        color: #198754;
        font-size: 24px;
        font-weight: 700;
        text-align: right;
        letter-spacing: -.5px;
    }

    /* =====================================================
           NOTES
           ===================================================== */

    .green-invoice-note {
        margin-top: 23px;
        padding: 14px 17px;
        border: 1px solid #e0eae2;
        border-left: 4px solid #198754;
        border-radius: 7px;
        background: #f8fbf8;
        color: #68756b;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .green-invoice-note-title {
        margin-bottom: 5px;
        color: #28543a;
        font-weight: 700;
    }

    .green-invoice-cancel-note {
        border-color: #f0d8db;
        border-left-color: #dc3545;
        background: #fff8f8;
    }

        .green-invoice-cancel-note .green-invoice-note-title {
            color: #b02a37;
        }

    /* =====================================================
       GHI CHÚ GIAO HÀNG
       ===================================================== */

    .green-invoice-delivery {
        margin-top: 22px;
        padding: 17px 19px;
        background: #f8fbf8;
        border: 1px solid #dce9df;
        border-left: 4px solid #198754;
        border-radius: 8px;
    }

    .green-invoice-delivery-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #28543a;
        font-size: 13px;
        font-weight: 700;
    }

    .green-invoice-delivery-content {
        color: #68756b;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    /* =====================================================
       CAM KẾT YUUJI STORE
       ===================================================== */

    .green-invoice-commitment {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 15px;
        padding: 18px 19px;
        background: #f0f8f2;
        border: 1px solid #d5e9da;
        border-radius: 8px;
    }

    .green-invoice-commitment-icon {
        width: 34px;
        min-width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #198754;
        color: white;
        border-radius: 50%;
        font-size: 17px;
    }

    .green-invoice-commitment-title {
        margin-bottom: 6px;
        color: #176b40;
        font-size: 13px;
        font-weight: 700;
    }

    .green-invoice-commitment-text {
        color: #526657;
        font-size: 12px;
        line-height: 1.9;
    }

    /* =====================================================
           FOOTER
           ===================================================== */

    .green-invoice-footer {
        margin-top: 32px;
        padding-top: 19px;
        border-top: 1px dashed #dce5dd;
        text-align: center;
    }

    .green-invoice-thanks {
        margin-bottom: 7px;
        color: #28543a;
        font-size: 13px;
        font-weight: 700;
    }

    .green-invoice-footer-text {
        color: #909a91;
        font-size: 11px;
        line-height: 1.8;
    }

    /* =====================================================
           BUTTONS
           ===================================================== */

    .green-invoice-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 22px;
    }

    .green-invoice-button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 18px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease;
    }

    .green-invoice-back {
        border-color: #d7e1d9;
        background: #fff;
        color: #46554a;
    }

        .green-invoice-back:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
        }

    .green-invoice-print {
        background-color: #198754;
        border: 1px solid #198754;
        color: #fff;
        min-height: 38px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 7px;
        box-shadow: none;
        transition: all .2s ease;
    }

        .green-invoice-print:hover {
            background-color: #157347;
            border-color: #157347;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(25, 135, 84, .18);
        }

    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 650px) {
        .green-invoice-page {
            padding: 22px 10px 40px;
        }

        .green-invoice-content {
            padding: 25px 17px;
        }

        .green-invoice-header {
            flex-direction: column;
        }

        .green-invoice-heading {
            min-width: 0;
            text-align: left;
        }

            .green-invoice-heading h1 {
                font-size: 24px;
            }

        .green-invoice-info-grid {
            grid-template-columns: 1fr;
            padding: 8px 16px;
        }

        .green-invoice-info-item:nth-last-child(-n+2) {
            border-bottom: 1px solid #edf1ed;
        }

        .green-invoice-info-item:last-child {
            border-bottom: none;
        }

        .green-invoice-table {
            min-width: 590px;
        }

        .green-invoice-summary-area {
            justify-content: stretch;
        }

        .green-invoice-summary {
            width: 100%;
        }

        .green-invoice-actions {
            flex-direction: column-reverse;
        }

        .green-invoice-button {
            width: 100%;
        }
    }

    /* =====================================================
           PRINT / SAVE AS PDF
           ===================================================== */
    @@page {
        size: A4 portrait;
        margin: 8mm;
    }

    @@media print {

        html,
        body {
            width: auto !important;
            height: auto !important;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            overflow: visible !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        /* Ẩn các phần của website không cần in */
        header.main-navbar,
        footer.main-footer,
        .site-alert,
        .green-invoice-actions {
            display: none !important;
        }
        /* Xóa khoảng trống do Layout tạo ra */
        main.main-content {
            min-height: 0 !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        /* Bỏ padding bên ngoài hóa đơn */
        .green-invoice-page {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        /* Giữ hóa đơn trong luồng bố cục bình thường */
        #greenInvoiceDocument {
            position: static !important;
            display: block !important;
            width: 100% !important;
            max-width: none !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            border: 1px solid #e0e7e1 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            overflow: visible !important;
            box-sizing: border-box !important;
        }

            #greenInvoiceDocument .green-invoice-content {
                padding: 5mm !important;
            }
            /* Giảm khoảng cách để tận dụng diện tích A4 */
            #greenInvoiceDocument .green-invoice-section {
                margin-top: 14px !important;
            }

            #greenInvoiceDocument .green-invoice-header {
                padding-bottom: 14px !important;
                gap: 15px !important;
            }

            #greenInvoiceDocument .green-invoice-brand-note {
                margin-top: 8px !important;
            }

            #greenInvoiceDocument .green-invoice-info-grid {
                padding: 5px 14px !important;
                gap: 0 20px !important;
            }

            #greenInvoiceDocument .green-invoice-info-item {
                padding: 8px 0 !important;
            }

            #greenInvoiceDocument .green-invoice-section-title {
                margin-bottom: 9px !important;
            }
            /* Bảng sản phẩm */
            #greenInvoiceDocument .green-invoice-table {
                width: 100% !important;
                min-width: 0 !important;
                border-collapse: collapse !important;
            }

            #greenInvoiceDocument .green-invoice-table-wrap {
                width: 100% !important;
                overflow: visible !important;
            }

            #greenInvoiceDocument .green-invoice-table thead {
                display: table-header-group;
            }

                #greenInvoiceDocument .green-invoice-table thead th {
                    padding: 8px 6px !important;
                    background: #198754 !important;
                    color: #fff !important;
                }

            #greenInvoiceDocument .green-invoice-table tbody td {
                padding: 8px 6px !important;
            }

            #greenInvoiceDocument .green-invoice-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            /* Ghi chú bên trái, thành tiền bên phải */
            #greenInvoiceDocument .green-invoice-bottom-grid {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) 280px !important;
                align-items: start !important;
                gap: 10px !important;
                margin-top: 12px !important;
            }

            #greenInvoiceDocument .green-invoice-notes-box,
            #greenInvoiceDocument .green-invoice-summary {
                padding: 10px !important;
                box-sizing: border-box !important;
            }

            #greenInvoiceDocument .green-invoice-notes-section + .green-invoice-notes-section {
                margin-top: 8px !important;
                padding-top: 8px !important;
            }

            #greenInvoiceDocument .green-invoice-notes-content {
                line-height: 1.6 !important;
            }

            #greenInvoiceDocument .green-invoice-summary-area {
                margin-top: 0 !important;
            }

            #greenInvoiceDocument .green-invoice-summary-row {
                padding: 4px 0 !important;
            }

            #greenInvoiceDocument .green-invoice-grand-total {
                font-size: 18px !important;
            }

            #greenInvoiceDocument .green-invoice-footer {
                margin-top: 14px !important;
                padding-top: 10px !important;
            }
            /* Giữ màu nền và chữ khi in */
            #greenInvoiceDocument .green-invoice-topline,
            #greenInvoiceDocument .green-invoice-table thead th,
            #greenInvoiceDocument .green-invoice-summary,
            #greenInvoiceDocument .green-invoice-notes-box {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            /* Tránh cắt các khối nhỏ giữa trang */
            #greenInvoiceDocument .green-invoice-summary,
            #greenInvoiceDocument .green-invoice-notes-section,
            #greenInvoiceDocument .green-invoice-footer,
            #greenInvoiceDocument .green-invoice-note {
                break-inside: avoid;
                page-break-inside: avoid;
            }
    }


    /* =====================================================
       GHI CHÚ + THÀNH TIỀN NẰM CẠNH NHAU
       ===================================================== */

    .green-invoice-bottom-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 350px;
        align-items: stretch;
        gap: 20px;
        margin-top: 22px;
    }

    /* Ô ghi chú nét đứt */

    .green-invoice-notes-box {
        padding: 17px 19px;
        border: 1px dashed #cfd8cf;
        border-radius: 5px;
        background: #fffef9;
        color: #596359;
        min-width: 0;
    }

    .green-invoice-notes-section + .green-invoice-notes-section {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px dashed #e0e5dc;
    }

    .green-invoice-notes-title {
        margin-bottom: 7px;
        color: #39483c;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.6;
    }

    .green-invoice-notes-content {
        color: #6b746b;
        font-size: 12px;
        line-height: 1.9;
        overflow-wrap: anywhere;

    }

    /* Khung thành tiền */

    .green-invoice-bottom-grid .green-invoice-summary-area {
        margin-top: 0;
        justify-content: stretch;
        min-width: 0;
    }

    .green-invoice-bottom-grid .green-invoice-summary {
        width: 100%;
        box-sizing: border-box;
    }

    /* Màn hình nhỏ */

    @@media (max-width: 750px) {
        .green-invoice-bottom-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }

    /* Khi in hoặc lưu PDF */

    @@media print {
        .green-invoice-bottom-grid,
        .green-invoice-notes-box,
        .green-invoice-summary {
            break-inside: avoid;
        }
    }

</style>

<div class="green-invoice-page">

    <div class="green-invoice-paper" id="greenInvoiceDocument">

        <div class="green-invoice-topline"></div>

        <div class="green-invoice-content">

            <!-- HEADER -->

            <header class="green-invoice-header">

                <div>
                    <div class="green-invoice-brand">

                        <div class="green-invoice-logo">Y</div>

                        <div>
                            <p class="green-invoice-store-name">
                                Yuuji Store
                            </p>

                            <p class="green-invoice-tagline">
                                MANGA · NOVEL · LIGHT NOVEL
                            </p>
                        </div>

                    </div>

                    <div class="green-invoice-brand-note">
                        Chứng từ mua hàng của khách hàng<br />
                        Đơn vị bán: Yuuji Store
                    </div>
                </div>

                <div class="green-invoice-heading">

                    <div class="green-invoice-heading-label">
                        CHỨNG TỪ BÁN HÀNG
                    </div>

                    <h1>HÓA ĐƠN<br />BÁN HÀNG</h1>

                    <div class="green-invoice-code">
                        @maHoaDon
                    </div>

                    <div class="green-invoice-date">
                        Ngày lập: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <span class="green-invoice-status @statusClass">
                        @Model.TrangThai
                    </span>

                </div>

            </header>

            <!-- CUSTOMER INFORMATION -->

            <section class="green-invoice-section">

                <h2 class="green-invoice-section-title">
                    <span class="green-invoice-section-number">01</span>
                    Thông tin đơn hàng
                </h2>

                <div class="green-invoice-info-grid">

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Khách hàng
                        </span>

                        <div class="green-invoice-info-value">
                            @Model.TenKhachHang
                        </div>
                    </div>

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Mã đơn hàng
                        </span>

                        <div class="green-invoice-info-value">
                            #@Model.MaDonHang
                        </div>
                    </div>

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Email
                        </span>

                        <div class="green-invoice-info-value">
                            @(string.IsNullOrWhiteSpace(Model.EmailKhachHang)
                                ? "Chưa cung cấp"
                                : Model.EmailKhachHang)
                        </div>
                    </div>

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Phương thức thanh toán
                        </span>

                        <div class="green-invoice-info-value">
                            @paymentText
                        </div>
                    </div>

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Địa chỉ giao hàng
                        </span>

                        <div class="green-invoice-info-value">
                            @(string.IsNullOrWhiteSpace(Model.DiaChiGiaoHang)
                                ? "Chưa cung cấp"
                                : Model.DiaChiGiaoHang)
                        </div>
                    </div>

                    <div class="green-invoice-info-item">
                        <span class="green-invoice-info-label">
                            Ngày đặt hàng
                        </span>

                        <div class="green-invoice-info-value">
                            @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                </div>

            </section>

            <!-- PRODUCTS -->

            <section class="green-invoice-section">

                <h2 class="green-invoice-section-title">
                    <span class="green-invoice-section-number">02</span>
                    Chi tiết sản phẩm
                </h2>

                <div class="green-invoice-table-wrap">

                    <table class="green-invoice-table">

                        <thead>
                            <tr>
                                <th style="width: 48px;">STT</th>
                                <th>Tên sách</th>
                                <th class="green-center">Số lượng</th>
                                <th class="green-number">Đơn giá</th>
                                <th class="green-number">Thành tiền</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.SanPhams != null &&
                                 Model.SanPhams.Any())
                            {
                                var stt = 0;

                                foreach (var item in Model.SanPhams)
                                {
                                    stt++;

                                    <tr>
                                        <td>@stt.ToString("D2")</td>

                                        <td class="green-invoice-product-name">
                                            @item.TenSach
                                        </td>

                                        <td class="green-center">
                                            @item.SoLuong
                                        </td>

                                        <td class="green-number">
                                            @item.DonGia.ToString("N0") đ
                                        </td>

                                        <td class="green-number green-invoice-product-total">
                                            @item.ThanhTien.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="green-center">
                                        Không có sản phẩm trong đơn hàng.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </section>

            <!-- =====================================================
     GHI CHÚ GIAO HÀNG + CAM KẾT + THÀNH TIỀN
     ===================================================== -->

            <div class="green-invoice-bottom-grid">

                <!-- BÊN TRÁI: GHI CHÚ VÀ CAM KẾT -->

                <div class="green-invoice-notes-box">

                    <div class="green-invoice-notes-section">

                        <div class="green-invoice-notes-title">
                            Ghi chú giao hàng của khách:
                        </div>

                        <div class="green-invoice-notes-content">
                            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                            {
                                <text>“@Model.GhiChu”</text>
                            }
                            else
                            {
                                <text>Không có ghi chú giao hàng.</text>
                            }
                        </div>

                    </div>

                    <div class="green-invoice-notes-section">

                        <div class="green-invoice-notes-title">
                            Cam kết của Yuuji Store:
                        </div>

                        <div class="green-invoice-notes-content">
                            Cam kết sách bản quyền chính hãng 100%,
                            đóng gói chống sốc và hỗ trợ đổi trả miễn phí
                            trong 7 ngày nếu có lỗi in ấn.
                        </div>

                    </div>

                </div>


                <!-- BÊN PHẢI: THÀNH TIỀN -->

                <div class="green-invoice-summary-area">

                    <div class="green-invoice-summary">

                        <div class="green-invoice-summary-row">
                            <span>Số dòng sản phẩm</span>

                            <strong>
                                @(Model.SanPhams?.Count ?? 0)
                            </strong>
                        </div>

                        <div class="green-invoice-summary-row">
                            <span>Phương thức thanh toán</span>

                            <strong>
                                @paymentText
                            </strong>
                        </div>

                        <div class="green-invoice-summary-divider"></div>

                        <div class="green-invoice-summary-row">

                            <span class="green-invoice-grand-label">
                                TỔNG CỘNG
                            </span>

                            <span class="green-invoice-grand-total">
                                @Model.TongTien.ToString("N0") đ
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            @if (Model.TrangThai == "Đã hủy" &&
                 !string.IsNullOrWhiteSpace(Model.LyDoHuy))
            {
                <div class="green-invoice-note green-invoice-cancel-note">

                    <div class="green-invoice-note-title">
                        Lý do hủy đơn hàng
                    </div>

                    @Model.LyDoHuy

                </div>
            }

            <!-- FOOTER -->

            <footer class="green-invoice-footer">

                <div class="green-invoice-thanks">
                    Cảm ơn quý khách đã mua hàng tại Yuuji Store!
                </div>

                <div class="green-invoice-footer-text">
                    Vui lòng giữ lại chứng từ này để đối chiếu khi cần.<br />
                    Đây là chứng từ bán hàng nội bộ, không thay thế hóa đơn điện tử thuế.
                </div>

            </footer>

        </div>

    </div>

    <!-- TWO BUTTONS -->

    <div class="green-invoice-actions">

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="DonHangs"
               asp-action="ChiTiet"
               asp-route-id="@Model.MaDonHang"
               class="green-invoice-button green-invoice-back">
                ← Quay lại đơn hàng
            </a>
        }
        else
        {
            <a asp-controller="DonHangs"
               asp-action="ChiTietCuaToi"
               asp-route-id="@Model.MaDonHang"
               class="green-invoice-button green-invoice-back">
                ← Quay lại đơn hàng
            </a>
        }

        <button type="button"
                class="green-invoice-button green-invoice-print"
                onclick="window.print()">
            🖨 In hóa đơn
        </button>

    </div>

</div>
