@model IEnumerable<ProjectKZM.ViewModels.DonHangViewModel>

@{
    ViewData["Title"] = "Quản lý đơn hàng";

    const int pageSize = 10;

    int currentPage = 1;

    if (int.TryParse(
        Context.Request.Query["page"],
        out int requestedPage) &&
        requestedPage > 0)
    {
        currentPage = requestedPage;
    }

    var allOrders =
        Model.ToList();

    int totalOrders =
        allOrders.Count;

    int totalPages =
        (int)Math.Ceiling(
            totalOrders / (double)pageSize);

    if (totalPages == 0)
    {
        totalPages = 1;
    }

    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }

    var orders =
        allOrders
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .orders-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 50px 20px 80px;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .orders-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .orders-title {
        margin: 0;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: -0.7px;
        color: #222;
    }

    .orders-subtitle {
        margin: 8px 0 0;
        color: #888;
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
           TOP ACTIONS
           ========================================================= */

    .top-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .top-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 40px;
        padding: 0 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .top-action:hover {
            transform: translateY(-1px);
        }


    /* ĐƠN CHỜ XÁC NHẬN */

    .pending-action {
        background: #fff3cd;
        border: 1px solid #ffda6a;
        color: #8a5a00;
    }

        .pending-action:hover {
            background: #ffda6a;
            border-color: #ffca2c;
            color: #664300;
            box-shadow: 0 5px 14px rgba(255, 193, 7, .18);
        }


    /* THỐNG KÊ */

    .stats-action {
        background: #eef4ff;
        border: 1px solid #cfe0ff;
        color: #2f5fa7;
    }

        .stats-action:hover {
            background: #dce9ff;
            border-color: #b7d0ff;
            color: #234f91;
            box-shadow: 0 5px 14px rgba(13, 110, 253, .12);
        }


    /* =========================================================
           TABLE BOX
           ========================================================= */

    .table-box {
        overflow-x: auto;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 15px;
        box-shadow: 0 7px 25px rgba(0, 0, 0, .05);
    }


    /* =========================================================
           TABLE
           ========================================================= */

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }


    thead th {
        padding: 16px 18px;
        background: #f8f9fa;
        border-bottom: 1px solid #e7e7e7;
        color: #6b6b6b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        text-align: left;
        white-space: nowrap;
    }

        thead th:first-child {
            border-top-left-radius: 15px;
        }

        thead th:last-child {
            border-top-right-radius: 15px;
        }


    tbody td {
        padding: 17px 18px;
        border-bottom: 1px solid #eeeeee;
        color: #333;
        font-size: 14px;
        vertical-align: middle;
        white-space: nowrap;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
           ROW HOVER
           ========================================================= */

    tbody tr {
        transition: background-color .2s ease;
    }

        tbody tr:hover {
            background-color: #fafafa;
        }


    /* =========================================================
           ORDER ID
           ========================================================= */

    .order-id {
        font-weight: 700;
        color: #222;
    }


    /* =========================================================
           CUSTOMER
           ========================================================= */

    .customer-name {
        font-weight: 500;
        color: #222;
    }


    /* =========================================================
           PAYMENT BADGE
           ========================================================= */

    .payment-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f3f3f3;
        border: 1px solid #e1e1e1;
        color: #555;
        font-size: 12px;
        font-weight: 600;
    }

    .payment-vnpay {
        background: #eef6ff;
        border-color: #cfe2ff;
        color: #1769aa;
    }

    .payment-cod {
        background: #edf8f0;
        border-color: #cfe8d5;
        color: #28733b;
    }

    .payment-bank {
        background: #f4efff;
        border-color: #ded2ff;
        color: #6842a6;
    }


    /* =========================================================
           QUANTITY
           ========================================================= */

    .quantity-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 28px;
        padding: 0 8px;
        border-radius: 7px;
        background: #f5f5f5;
        border: 1px solid #e2e2e2;
        color: #444;
        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
           MONEY
           ========================================================= */

    .money {
        color: #222;
        font-size: 14px;
        font-weight: 700;
    }


    /* =========================================================
           STATUS
           ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f2f2f2;
        border: 1px solid #e1e1e1;
        color: #555;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================================
           STATUS COLORS
           ========================================================= */

    .status-waiting {
        background: #fff3cd;
        border-color: #ffda6a;
        color: #8a5a00;
    }

    .status-success {
        background: #edf8f0;
        border-color: #cfe8d5;
        color: #28733b;
    }

    .status-danger {
        background: #fff0f1;
        border-color: #f3c4c8;
        color: #b02a37;
    }

    .status-processing {
        background: #eef4ff;
        border-color: #cfe0ff;
        color: #2f5fa7;
    }


    /* =========================================================
           DETAIL BUTTON
           ========================================================= */

    .detail-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        padding: 0 13px;
        border-radius: 7px;
        background: #fff;
        border: 1px solid #d7d7d7;
        color: #444;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .detail-button:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, .12);
        }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f1f1;
        font-size: 26px;
    }

    .empty-title {
        margin: 0;
        font-size: 21px;
        font-weight: 600;
        color: #333;
    }

    .empty-description {
        margin: 8px 0 0;
        color: #888;
        font-size: 14px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .orders-header {
            align-items: flex-start;
        }

        .orders-title {
            font-size: 32px;
        }
    }


    @@media (max-width: 600px) {

        .orders-page {
            padding: 35px 15px 60px;
        }

        .orders-header {
            flex-direction: column;
        }

        .orders-title {
            font-size: 29px;
        }

        .orders-subtitle {
            font-size: 13px;
        }
    }
    /* =========================================================
       PAGINATION
       ========================================================= */

    .pagination-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 28px;
    }

    .pagination-button {
        min-width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        color: #444;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .pagination-button:hover {
            background: #f3f3f3;
            border-color: #cfcfcf;
            color: #111;
            transform: translateY(-1px);
        }

        .pagination-button.active {
            background: #212529;
            border-color: #212529;
            color: #fff;
        }

        .pagination-button.disabled {
            pointer-events: none;
            background: #f5f5f5;
            border-color: #e5e5e5;
            color: #aaa;
        }

    .pagination-info {
        margin-top: 10px;
        text-align: center;
        color: #888;
        font-size: 13px;
    }

</style>


<div class="orders-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="orders-header">

        <div>

            <h1 class="orders-title">
                Quản lý đơn hàng
            </h1>

            <p class="orders-subtitle">
                Theo dõi và quản lý thông tin các đơn hàng trong hệ thống
            </p>

        </div>

    </div>


    <!-- =====================================================
         TOP ACTIONS
         ===================================================== -->

    <div class="top-actions">

        <a asp-action="ChoXacNhan"
           class="top-action pending-action">

            ⏳
            Đơn chờ xác nhận

        </a>


        <a asp-action="ThongKe"
           class="top-action stats-action">

            📊
            Thống kê

        </a>

    </div>


    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="table-box">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    📦
                </div>

                <h2 class="empty-title">
                    Chưa có đơn hàng
                </h2>

                <p class="empty-description">
                    Hiện tại hệ thống chưa có dữ liệu đơn hàng.
                </p>

            </div>
        }
        else
        {
            <table>

                <thead>

                    <tr>

                        <th>
                            Mã đơn
                        </th>

                        <th>
                            Ngày đặt
                        </th>

                        <th>
                            Khách hàng
                        </th>

                        <th>
                            Phương thức
                        </th>

                        <th>
                            Số lượng
                        </th>

                        <th>
                            Tổng tiền
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in orders)
                    {
                        string paymentClass = "";

                        if (item.PhuongThucThanhToan == "VNPAY")
                        {
                            paymentClass = "payment-vnpay";
                        }
                        else if (item.PhuongThucThanhToan == "COD")
                        {
                            paymentClass = "payment-cod";
                        }
                        else if (item.PhuongThucThanhToan == "BANK")
                        {
                            paymentClass = "payment-bank";
                        }


                        string statusClass = "";

                        if (item.TrangThai == "Chờ Admin xác nhận" ||
                            item.TrangThai == "Chờ thanh toán")
                        {
                            statusClass = "status-waiting";
                        }
                        else if (item.TrangThai == "Đã thanh toán" ||
                                 item.TrangThai == "Đã xác nhận")
                        {
                            statusClass = "status-success";
                        }
                        else if (item.TrangThai == "Đã hủy" ||
                                 item.TrangThai == "Thanh toán thất bại")
                        {
                            statusClass = "status-danger";
                        }
                        else
                        {
                            statusClass = "status-processing";
                        }


                        <tr>

                            <!-- =================================================
                                 MÃ ĐƠN
                                 ================================================= -->

                            <td>

                                <span class="order-id">
                                    #@item.MaDonHang
                                </span>

                            </td>


                            <!-- =================================================
                                 NGÀY
                                 ================================================= -->

                            <td>

                                @(item.NgayDat.ToString(
                                    "dd/MM/yyyy HH:mm"))

                            </td>


                            <!-- =================================================
                                 KHÁCH HÀNG
                                 ================================================= -->

                            <td>

                                <span class="customer-name">
                                    @item.TenKhachHang
                                </span>

                            </td>


                            <!-- =================================================
                                 PHƯƠNG THỨC
                                 ================================================= -->

                            <td>

                                <span class="payment-badge @paymentClass">

                                    @(
                                        item.PhuongThucThanhToan switch
                                        {
                                            "VNPAY" => "VNPAY",
                                            "COD" => "COD",
                                            "BANK" => "Chuyển khoản",
                                            _ => item.PhuongThucThanhToan
                                        }
                                    )

                                </span>

                            </td>


                            <!-- =================================================
                                 SỐ LƯỢNG
                                 ================================================= -->

                            <td>

                                <span class="quantity-badge">
                                    @item.TongSoLuong
                                </span>

                            </td>


                            <!-- =================================================
                                 TỔNG TIỀN
                                 ================================================= -->

                            <td>

                                <span class="money">

                                    @item.TongTien.ToString("N0")
                                    VNĐ

                                </span>

                            </td>


                            <!-- =================================================
                                 TRẠNG THÁI
                                 ================================================= -->

                            <td>

                                <span class="status @statusClass">

                                    @item.TrangThai

                                </span>

                            </td>


                            <!-- =================================================
                                 CHI TIẾT
                                 ================================================= -->

                            <td>

                                <a asp-action="ChiTiet"
                                   asp-route-id="@item.MaDonHang"
                                   class="detail-button">

                                    Xem chi tiết →

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

    @if (totalOrders > 0)
    {
        <div class="pagination-wrapper">

            <!-- TRANG TRƯỚC -->
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   class="pagination-button">

                    ←

                </a>
            }
            else
            {
                <span class="pagination-button disabled">
                    ←
                </span>
            }


            <!-- CÁC TRANG -->
            @for (int pageNumber = 1;
                          pageNumber <= totalPages;
                          pageNumber++)
            {
                if (pageNumber == currentPage)
                {
                    <span class="pagination-button active">
                        @pageNumber
                    </span>
                }
                else
                {
                    <a asp-action="Index"
                       asp-route-page="@pageNumber"
                       class="pagination-button">

                        @pageNumber

                    </a>
                }
            }


            <!-- TRANG SAU -->
            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   class="pagination-button">

                    →

                </a>
            }
            else
            {
                <span class="pagination-button disabled">
                    →
                </span>
            }

        </div>


        <div class="pagination-info">

            Trang @currentPage / @totalPages
            ·
            Tổng @totalOrders đơn hàng

        </div>
    }


    <!-- =====================================================
         BACK
         ===================================================== -->

    <div style="
        display:flex;
        justify-content:flex-end;
        margin-top:25px;
        ">

        <a asp-controller="Admin"
           asp-action="Index"
           class="detail-button">

            ← Quay lại quản lý

        </a>

    </div>

</div>