@model ProjectKZM.ViewModels.DonHangChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    string statusClass =
        Model.TrangThai switch
        {
            "Đã xác nhận" => "status-success",
            "Đã thanh toán" => "status-success",
            "Đã hủy" => "status-danger",
            "Chờ Admin xác nhận" => "status-warning",
            "Chờ thanh toán" => "status-warning",
            "Thanh toán thất bại" => "status-danger",
            _ => "status-default"
        };

    string paymentText =
        Model.PhuongThucThanhToan switch
        {
            "VNPAY" => "VNPAY",
            "COD" => "Thanh toán khi nhận hàng",
            "BANK" => "Chuyển khoản ngân hàng",
            _ => Model.PhuongThucThanhToan ?? "Chưa xác định"
        };
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .order-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 50px 20px 85px;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .order-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .order-title {
        margin: 0;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: -0.8px;
        color: #222;
    }

    .order-subtitle {
        margin: 8px 0 0;
        color: #8b8b8b;
        font-size: 14px;
    }


    /* =========================================================
           NOTICE
           ========================================================= */

    .order-notice {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 17px 18px;
        margin-bottom: 20px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.55;
    }

    .notice-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 15px;
        font-weight: 700;
    }

    .notice-success {
        background: #edf8f0;
        border: 1px solid #cfe8d5;
        color: #28733b;
    }

        .notice-success .notice-icon {
            background: #d9f0df;
        }

    .notice-danger {
        background: #fff0f1;
        border: 1px solid #f3c4c8;
        color: #b02a37;
    }

        .notice-danger .notice-icon {
            background: #f8dfe2;
        }

    .notice-content {
        flex: 1;
    }

    .notice-title {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .notice-reason {
        margin-top: 6px;
    }


    /* =========================================================
           MAIN CARD
           ========================================================= */

    .order-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 7px 25px rgba(0, 0, 0, .045);
        overflow: hidden;
    }


    /* =========================================================
           CARD TITLE
           ========================================================= */

    .card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eeeeee;
        background: #fafafa;
    }

    .card-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: #333;
    }

    .card-description {
        margin-top: 4px;
        color: #999;
        font-size: 12px;
    }


    /* =========================================================
           ORDER INFO
           ========================================================= */

    .order-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
        padding: 8px 24px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 15px 8px;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-label {
        color: #999;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .info-value {
        color: #222;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.5;
    }


    /* =========================================================
           STATUS
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        padding: 7px 11px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-success {
        background: #edf8f0;
        border: 1px solid #cfe8d5;
        color: #28733b;
    }

    .status-danger {
        background: #fff0f1;
        border: 1px solid #f3c4c8;
        color: #b02a37;
    }

    .status-warning {
        background: #fff3cd;
        border: 1px solid #ffda6a;
        color: #8a5a00;
    }

    .status-default {
        background: #f2f2f2;
        border: 1px solid #e1e1e1;
        color: #555;
    }


    /* =========================================================
           PRODUCTS
           ========================================================= */

    .products-wrapper {
        overflow-x: auto;
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

        .products-table th {
            padding: 14px 18px;
            background: #fafafa;
            border-bottom: 1px solid #e7e7e7;
            color: #888;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            text-align: left;
            white-space: nowrap;
        }

        .products-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #eeeeee;
            color: #333;
            font-size: 14px;
            vertical-align: middle;
        }

        .products-table tbody tr {
            transition: background-color .2s ease;
        }

            .products-table tbody tr:hover {
                background: #fafafa;
            }

            .products-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================================================
           PRODUCT
           ========================================================= */

    .product-cell {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 280px;
    }

    .product-image {
        width: 58px;
        height: 78px;
        object-fit: cover;
        border-radius: 6px;
        background: #f1f1f1;
        flex-shrink: 0;
    }

    .product-no-image {
        width: 58px;
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #f1f1f1;
        color: #999;
        font-size: 10px;
        text-align: center;
        flex-shrink: 0;
    }

    .product-name {
        color: #222;
        font-weight: 600;
        line-height: 1.45;
    }


    /* =========================================================
           QUANTITY
           ========================================================= */

    .quantity-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 28px;
        padding: 0 9px;
        border-radius: 7px;
        background: #f4f4f4;
        border: 1px solid #e2e2e2;
        color: #444;
        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
           MONEY
           ========================================================= */

    .unit-price {
        white-space: nowrap;
        color: #555;
        font-size: 14px;
    }

    .item-total {
        white-space: nowrap;
        color: #222;
        font-weight: 700;
    }


    /* =========================================================
           TOTAL
           ========================================================= */

    .order-total {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        border-top: 1px solid #e5e5e5;
        background: #fafafa;
    }

    .total-label {
        color: #777;
        font-size: 14px;
        font-weight: 500;
    }

    .total-value {
        color: #198754;
        font-size: 26px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           BACK BUTTON
           ========================================================= */

    .bottom-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 25px;
    }

    .back-button {
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid #d7d7d7;
        border-radius: 8px;
        background: #fff;
        color: #555;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .back-button:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 13px rgba(0,0,0,.12);
        }

    .invoice-button.invoice-back {
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid #198754;
        border-radius: 8px;
        background: #198754;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .invoice-button.invoice-back:hover {
            background: #157347;
            border-color: #157347;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 13px rgba(21, 115, 71, .2);
        }



    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 700px) {

        .order-page {
            padding: 35px 15px 60px;
        }

        .order-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .order-title {
            font-size: 31px;
        }

        .order-info {
            grid-template-columns: 1fr;
        }

        .order-total {
            align-items: flex-start;
            flex-direction: column;
        }

        .total-value {
            font-size: 23px;
        }

        .bottom-actions {
            justify-content: stretch;
        }

        .back-button {
            width: 100%;
        }
    }

</style>


<div class="order-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="order-header">

        <div>

            <h1 class="order-title">
                Đơn hàng #@Model.MaDonHang
            </h1>

            <div class="order-subtitle">
                Thông tin chi tiết đơn hàng của bạn
            </div>

        </div>

    </div>


    <!-- =====================================================
         STATUS NOTICE
         ===================================================== -->
    @if (Model.TrangThai == "Đã xác nhận")
    {
        <div class="order-notice notice-success">

            <div class="notice-icon">
                ✓
            </div>

            <div class="notice-content">

                <div class="notice-title">
                    Đơn hàng đã được xác nhận
                </div>

                <div>
                    Admin đã xác nhận đơn hàng của bạn.
                </div>

            </div>

        </div>
    }
    else if (Model.TrangThai == "Đã thanh toán")
    {
        <div class="order-notice notice-success">

            <div class="notice-icon">
                ✓
            </div>

            <div class="notice-content">

                <div class="notice-title">
                    Thanh toán thành công
                </div>

                <div>
                    Đơn hàng của bạn đã được thanh toán thành công.
                </div>

            </div>

        </div>
    }
    else if (Model.TrangThai == "Đã hủy")
    {
        <div class="order-notice notice-danger">

            <div class="notice-icon">
                !
            </div>

            <div class="notice-content">

                <div class="notice-title">
                    Đơn hàng đã bị hủy
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.LyDoHuy))
                {
                    <div class="notice-reason">

                        <strong>
                            Lý do hủy:
                        </strong>

                        @Model.LyDoHuy

                    </div>
                }

            </div>

        </div>
    }


    <!-- =====================================================
         ORDER INFORMATION
         ===================================================== -->

    <div class="order-card">

        <div class="card-header">

            <div class="card-title">
                Thông tin đơn hàng
            </div>

            <div class="card-description">
                Thông tin giao hàng và thanh toán
            </div>

        </div>


        <div class="order-info">

            <div class="info-item">

                <div class="info-label">
                    Ngày đặt
                </div>

                <div class="info-value">
                    @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                </div>

            </div>


            <div class="info-item">

                <div class="info-label">
                    Phương thức thanh toán
                </div>

                <div class="info-value">
                    @paymentText
                </div>

            </div>


            <div class="info-item">

                <div class="info-label">
                    Trạng thái
                </div>

                <div class="info-value">

                    <span class="status-badge @statusClass">
                        @Model.TrangThai
                    </span>

                </div>

            </div>


            <div class="info-item">

                <div class="info-label">
                    Địa chỉ giao hàng
                </div>

                <div class="info-value">
                    @Model.DiaChiGiaoHang
                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div class="info-item">

                    <div class="info-label">
                        Ghi chú
                    </div>

                    <div class="info-value">
                        @Model.GhiChu
                    </div>

                </div>
            }


            @if (Model.TrangThai == "Đã hủy" &&
                 !string.IsNullOrWhiteSpace(Model.LyDoHuy))
            {
                <div class="info-item">

                    <div class="info-label">
                        Lý do hủy
                    </div>

                    <div class="info-value"
                         style="color:#b02a37; font-weight:600;">

                        @Model.LyDoHuy

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <div class="order-card">

        <div class="card-header">

            <div class="card-title">
                Sản phẩm trong đơn hàng
            </div>

            <div class="card-description">
                Danh sách sách bạn đã đặt
            </div>

        </div>


        <div class="products-wrapper">

            <table class="products-table">

                <thead>

                    <tr>

                        <th>
                            Sách
                        </th>

                        <th>
                            Số lượng
                        </th>

                        <th>
                            Đơn giá
                        </th>

                        <th>
                            Thành tiền
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.SanPhams)
                    {
                        <tr>

                            <td>

                                <div class="product-cell">

                                    @if (!string.IsNullOrWhiteSpace(item.Hinh))
                                    {
                                        <img src="@item.Hinh"
                                             class="product-image"
                                             alt="@item.TenSach" />
                                    }
                                    else
                                    {
                                        <div class="product-no-image">
                                            Không có hình
                                        </div>
                                    }


                                    <div class="product-name">
                                        @item.TenSach
                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="quantity-badge">
                                    @item.SoLuong
                                </span>

                            </td>


                            <td class="unit-price">
                                @item.DonGia.ToString("N0") VNĐ
                            </td>


                            <td class="item-total">
                                @item.ThanhTien.ToString("N0") VNĐ
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="order-total">

            <span class="total-label">
                Tổng cộng
            </span>

            <span class="total-value">
                @Model.TongTien.ToString("N0") VNĐ
            </span>

        </div>

    </div>


    <!-- =====================================================
         BACK
         ===================================================== -->

    <div class="bottom-actions">

        <a asp-controller="DonHangs"
           asp-action="LichSu"
           class="back-button">

            ← Quay lại lịch sử mua hàng

        </a>

        <a asp-controller="DonHangs"
           asp-action="HoaDon"
           asp-route-id="@Model.MaDonHang"
           class="invoice-button invoice-back">

            🧾 Xem hóa đơn

        </a>
    </div>

</div>