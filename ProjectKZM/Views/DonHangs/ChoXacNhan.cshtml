@model IEnumerable<ProjectKZM.ViewModels.DonHangViewModel>

@{
    ViewData["Title"] = "Đơn chờ xác nhận";
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .pending-page {
        max-width: 1350px;
        margin: 0 auto;
        padding: 50px 20px 80px;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header-left {
        min-width: 0;
    }

    .page-title {
        margin: 0;
        font-size: 36px;
        font-weight: 600;
        letter-spacing: -0.6px;
        color: #222;
    }

    .page-subtitle {
        margin: 8px 0 0;
        color: #888;
        font-size: 14px;
        line-height: 1.6;
    }


    /* =========================================================
           COUNT BADGE
           ========================================================= */

    .pending-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        padding: 0 12px;
        border-radius: 10px;
        background: #fff4e5;
        border: 1px solid #ffd9a8;
        color: #b56a00;
        font-size: 14px;
        font-weight: 600;
    }


    /* =========================================================
           TABLE BOX
           ========================================================= */

    .table-box {
        overflow-x: auto;
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    }


    /* =========================================================
           TABLE
           ========================================================= */

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    thead th {
        padding: 16px 18px;
        background: #f8f9fa;
        border-bottom: 1px solid #e8e8e8;
        color: #666;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        text-align: left;
        white-space: nowrap;
    }

        thead th:first-child {
            border-top-left-radius: 14px;
        }

        thead th:last-child {
            border-top-right-radius: 14px;
        }


    tbody td {
        padding: 17px 18px;
        border-bottom: 1px solid #eeeeee;
        color: #333;
        font-size: 14px;
        vertical-align: middle;
        white-space: nowrap;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
           ROW HOVER
           ========================================================= */

    tbody tr {
        transition: background-color .2s ease;
    }

        tbody tr:hover {
            background-color: #fafafa;
        }


    /* =========================================================
           ORDER ID
           ========================================================= */

    .order-id {
        font-weight: 700;
        color: #222;
    }


    /* =========================================================
           CUSTOMER
           ========================================================= */

    .customer-name {
        font-weight: 500;
        color: #222;
    }


    /* =========================================================
           PAYMENT BADGE
           ========================================================= */

    .payment-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f3f3f3;
        border: 1px solid #e5e5e5;
        color: #555;
        font-size: 12px;
        font-weight: 600;
    }

        .payment-badge.vnpay {
            background: #eef6ff;
            border-color: #cfe2ff;
            color: #1769aa;
        }

        .payment-badge.cod {
            background: #f3f7f3;
            border-color: #d5e6d5;
            color: #38703c;
        }

        .payment-badge.bank {
            background: #f5f0ff;
            border-color: #ded1ff;
            color: #6541a5;
        }


    /* =========================================================
           TOTAL
           ========================================================= */

    .order-total {
        font-weight: 700;
        color: #222;
    }


    /* =========================================================
           ACTIONS
           ========================================================= */

    .actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }


    /* =========================================================
           COMMON BUTTON
           ========================================================= */

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        padding: 0 13px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .action-button:hover {
            transform: translateY(-1px);
        }


    /* =========================================================
           DETAIL BUTTON
           ========================================================= */

    .detail-button {
        background: #fff;
        border: 1px solid #d9d9d9;
        color: #444;
    }

        .detail-button:hover {
            background: #f4f4f4;
            border-color: #c8c8c8;
            color: #111;
            box-shadow: 0 4px 10px rgba(0, 0, 0, .06);
        }


    /* =========================================================
           CONFIRM BUTTON - GREEN
           ========================================================= */

    .confirm-button {
        border: 1px solid #198754;
        background: #198754;
        color: #fff;
    }

        .confirm-button:hover {
            border-color: #157347;
            background: #157347;
            color: #fff;
            box-shadow: 0 5px 14px rgba(25, 135, 84, .22);
        }


    /* =========================================================
           CANCEL BUTTON
           ========================================================= */

    .cancel-button {
        border: 1px solid #dc3545;
        background: #fff;
        color: #dc3545;
    }

        .cancel-button:hover {
            border-color: #dc3545;
            background: #dc3545;
            color: #fff;
            box-shadow: 0 5px 14px rgba(220, 53, 69, .18);
        }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        padding: 70px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f3f3f3;
        font-size: 25px;
    }

    .empty-title {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }

    .empty-description {
        margin: 8px 0 0;
        color: #888;
        font-size: 14px;
    }




    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .page-header {
            align-items: flex-start;
        }

        .page-title {
            font-size: 31px;
        }

        .actions {
            flex-wrap: wrap;
        }

        tbody td,
        thead th {
            padding-left: 14px;
            padding-right: 14px;
        }
    }


    @@media (max-width: 600px) {

        .pending-page {
            padding: 35px 15px 60px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-title {
            font-size: 28px;
        }

        .page-subtitle {
            font-size: 13px;
        }
    }
    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .back-button-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 16px;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        background: #fff;
        color: #555;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .back-button:hover {
            background: #212529;
            border-color: #212529;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, .12);
        }

</style>


<div class="pending-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="page-header">

        <div class="page-header-left">

            <h1 class="page-title">
                Đơn chờ xác nhận
            </h1>

            <p class="page-subtitle">
                Kiểm tra và xử lý các đơn hàng đang chờ Admin xác nhận
            </p>

        </div>


        <div class="pending-count">

            @Model.Count()

            đơn chờ

        </div>

    </div>


    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="table-box">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ✓
                </div>

                <h2 class="empty-title">
                    Không có đơn hàng chờ xác nhận
                </h2>

                <p class="empty-description">
                    Hiện tại không có đơn hàng nào cần Admin xử lý.
                </p>

            </div>
        }
        else
        {
            <table>

                <thead>

                    <tr>

                        <th>
                            Mã đơn
                        </th>

                        <th>
                            Ngày đặt
                        </th>

                        <th>
                            Khách hàng
                        </th>

                        <th>
                            Phương thức
                        </th>

                        <th>
                            Tổng tiền
                        </th>

                        <th>
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- =================================================
                                 MÃ ĐƠN
                                 ================================================= -->

                            <td>

                                <span class="order-id">
                                    #@item.MaDonHang
                                </span>

                            </td>


                            <!-- =================================================
                                 NGÀY ĐẶT
                                 ================================================= -->

                            <td>

                                @item.NgayDat.ToString("dd/MM/yyyy HH:mm")

                            </td>


                            <!-- =================================================
                                 KHÁCH HÀNG
                                 ================================================= -->

                            <td>

                                <span class="customer-name">
                                    @item.TenKhachHang
                                </span>

                            </td>


                            <!-- =================================================
                                 PHƯƠNG THỨC
                                 ================================================= -->

                            <td>

                                @{
                                    string paymentClass = "";

                                    if (item.PhuongThucThanhToan == "VNPAY")
                                    {
                                        paymentClass = "vnpay";
                                    }
                                    else if (item.PhuongThucThanhToan == "COD")
                                    {
                                        paymentClass = "cod";
                                    }
                                    else if (item.PhuongThucThanhToan == "BANK")
                                    {
                                        paymentClass = "bank";
                                    }
                                }

                                <span class="payment-badge @paymentClass">

                                    @(
                                        item.PhuongThucThanhToan switch
                                        {
                                            "VNPAY" => "VNPAY",
                                            "COD" => "COD",
                                            "BANK" => "Chuyển khoản",
                                            _ => item.PhuongThucThanhToan
                                        }
                                    )

                                </span>

                            </td>


                            <!-- =================================================
                                 TỔNG TIỀN
                                 ================================================= -->

                            <td>

                                <span class="order-total">

                                    @item.TongTien.ToString("N0")
                                    VNĐ

                                </span>

                            </td>


                            <!-- =================================================
                                 ACTIONS
                                 ================================================= -->

                            <td>

                                <div class="actions">


                                    <!-- CHI TIẾT -->

                                    <a asp-action="ChiTiet"
                                       asp-route-id="@item.MaDonHang"
                                       class="action-button detail-button">

                                        Chi tiết

                                    </a>


                                    <!-- XÁC NHẬN -->

                                    <form asp-action="XacNhan"
                                          method="post"
                                          style="margin:0;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.MaDonHang" />


                                        <button type="submit"
                                                class="action-button confirm-button">

                                            ✓ Xác nhận

                                        </button>

                                    </form>


                                    <!-- HỦY -->

                                    <form asp-action="Huy"
                                          method="post"
                                          style="margin:0;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.MaDonHang" />


                                        <button type="submit"
                                                class="action-button cancel-button"
                                                onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">

                                            × Hủy

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

    <div class="back-button-wrapper">

        <a asp-controller="Admin"
           asp-action="Index"
           class="back-button">

            ← Quay lại quản lý

        </a>

    </div>

</div>