@model ProjectKZM.Models.TheLoai

@{
    ViewData["Title"] = "Thêm thể loại";
}

<div class="container mt-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Thêm thể loại</h1>
            <p class="text-muted">
                Thêm một thể loại sách mới vào hệ thống
            </p>
        </div>

        <!-- NÚT QUAY LẠI -->
        <a asp-controller="TheLoais"
           asp-action="Index"
           class="btn btn-secondary">
            ← Quản lý
        </a>

    </div>


    <!-- FORM -->
    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- HIỂN THỊ LỖI -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- TÊN THỂ LOẠI -->
                <div class="mb-4">

                    <label asp-for="TenTheLoai"
                           class="form-label fw-bold">
                        Tên thể loại
                    </label>

                    <input asp-for="TenTheLoai"
                           class="form-control"
                           placeholder="Nhập tên thể loại..." />

                    <span asp-validation-for="TenTheLoai"
                          class="text-danger">
                    </span>

                </div>


                <!-- MÔ TẢ -->
                <div class="mb-4">

                    <label asp-for="MoTa"
                           class="form-label fw-bold">
                        Mô tả
                    </label>

                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="5"
                              placeholder="Nhập mô tả cho thể loại..."></textarea>

                    <span asp-validation-for="MoTa"
                          class="text-danger">
                    </span>

                </div>


                <!-- HÌNH -->
                <div class="mb-4">

                    <label asp-for="Hinh"
                           class="form-label fw-bold">
                        Hình ảnh
                    </label>

                    <input asp-for="Hinh"
                           class="form-control"
                           placeholder="Nhập đường dẫn hình ảnh..." />

                    <span asp-validation-for="Hinh"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Ví dụ: /images/manga.jpg
                    </small>

                </div>


                <!-- BUTTON -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">
                        + Thêm thể loại
                    </button>

                    <a asp-controller="TheLoais"
                       asp-action="Index"
                       class="btn btn-secondary ms-2">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}