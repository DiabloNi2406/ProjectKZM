@model ProjectKZM.Models.TheLoai

@{
    ViewData["Title"] = "Xóa thể loại";
}

<style>
    .delete-page {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .delete-title {
        font-size: 40px;
        font-weight: 400;
        color: #222;
        margin-bottom: 8px;
    }

    .delete-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .delete-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 30px;
        background-color: white;
    }

    .warning-box {
        padding: 15px 20px;
        margin-bottom: 25px;
        border-radius: 6px;
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
        color: #856404;
    }

    .detail-row {
        display: flex;
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

    .detail-label {
        width: 180px;
        min-width: 180px;
        font-weight: 600;
        color: #444;
    }

    .detail-value {
        flex: 1;
        color: #555;
        word-break: break-word;
    }

    .category-image {
        width: 180px;
        max-height: 230px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .button-area {
        margin-top: 30px;
        display: flex;
        gap: 10px;
        align-items: center;
    }
</style>

<div class="delete-page">

    <h1 class="delete-title">
        Xóa thể loại
    </h1>

    <p class="delete-subtitle">
        Kiểm tra thông tin trước khi xóa thể loại
    </p>

    <div class="delete-card">

        <!-- CẢNH BÁO -->
        <div class="warning-box">
            <strong>Cảnh báo:</strong>
            Bạn có chắc chắn muốn xóa thể loại này không?
        </div>


        <!-- MÃ THỂ LOẠI -->
        <div class="detail-row">

            <div class="detail-label">
                Mã thể loại
            </div>

            <div class="detail-value">
                @Model.MaTheLoai
            </div>

        </div>


        <!-- TÊN THỂ LOẠI -->
        <div class="detail-row">

            <div class="detail-label">
                Tên thể loại
            </div>

            <div class="detail-value">
                @Model.TenTheLoai
            </div>

        </div>


        <!-- MÔ TẢ -->
        <div class="detail-row">

            <div class="detail-label">
                Mô tả
            </div>

            <div class="detail-value">

                @if (string.IsNullOrWhiteSpace(Model.MoTa))
                {
                    <span class="text-muted">
                        Chưa có mô tả
                    </span>
                }
                else
                {
                    @Model.MoTa
                }

            </div>

        </div>


        <!-- HÌNH -->
        <div class="detail-row">

            <div class="detail-label">
                Hình ảnh
            </div>

            <div class="detail-value">

                @if (!string.IsNullOrWhiteSpace(Model.Hinh))
                {
                    <img src="@Model.Hinh"
                         class="category-image"
                         alt="@Model.TenTheLoai" />
                }
                else
                {
                    <span class="text-muted">
                        Chưa có hình ảnh
                    </span>
                }

            </div>

        </div>


        <!-- SỐ LƯỢNG SÁCH -->
        <div class="detail-row">

            <div class="detail-label">
                Số sách
            </div>

            <div class="detail-value">

                @if (Model.SachTheLoais != null)
                {
                    @Model.SachTheLoais.Count
                }
                else
                {
                    @:0
                }

            </div>

        </div>


        <!-- BUTTON -->
        <div class="button-area">

            <form asp-action="Delete"
                  method="post"
                  style="margin: 0;">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="matheloai"
                       value="@Model.MaTheLoai" />

                <button type="submit"
                        class="btn btn-danger">
                    Xóa thể loại
                </button>

            </form>


            <a asp-action="Index"
               class="btn btn-secondary">
                ← Quay lại
            </a>

        </div>

    </div>

</div>