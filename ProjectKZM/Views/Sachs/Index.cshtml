@model IEnumerable<ProjectKZM.Models.Sach>

@{
    ViewData["Title"] = "Quản lý sách";


    // =====================================================
    // PHÂN TRANG
    // =====================================================

    const int pageSize = 10;

    int currentPage = 1;


    if (int.TryParse(
        Context.Request.Query["page"],
        out int requestedPage) &&
        requestedPage > 0)
    {
        currentPage = requestedPage;
    }


    var allBooks =
        (Model ?? Enumerable.Empty<ProjectKZM.Models.Sach>())
        .ToList();


    int totalBooks =
        allBooks.Count;


    int totalPages =
        (int)Math.Ceiling(
            totalBooks / (double)pageSize);


    if (totalPages == 0)
    {
        totalPages = 1;
    }


    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }


    var pagedBooks =
        allBooks
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
}
<style>
    .book-page {
        max-width: 1400px;
        margin: 40px auto;
        padding: 0 20px;
    }

    /* =========================
           HEADER
           ========================= */

    .book-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .book-title {
        font-size: 40px;
        font-weight: 400;
        margin-bottom: 8px;
    }

    .book-subtitle {
        color: #777;
        margin: 0;
    }

    .button-area {
        display: flex;
        gap: 10px;
    }

    /* =========================
           CARD
           ========================= */

    .book-card {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        background: white;
    }

    /* =========================
           TABLE
           ========================= */

    .book-table {
        width: 100%;
        border-collapse: collapse;
    }

        .book-table thead tr {
            background-color: #212529;
        }

        .book-table thead th {
            background-color: #212529;
            color: white;
            padding: 15px 10px;
            text-align: left;
            font-weight: 500;
            white-space: nowrap;
            border: none;
        }

        .book-table tbody td {
            padding: 12px 10px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .book-table tbody tr:hover {
            background-color: #f8f9fa;
        }

    /* =========================
           HÌNH ẢNH
           ========================= */

    .book-image {
        width: 70px;
        height: 90px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #ddd;
    }

    /* =========================
           TÊN SÁCH
           ========================= */

    .book-name {
        font-weight: 600;
    }

    /* =========================
           GIÁ
           ========================= */

    .book-price {
        font-weight: 600;
        color: #dc3545;
        white-space: nowrap;
    }

    /* =========================
           THỂ LOẠI
           ========================= */

    .category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .category-badge {
        display: inline-block;
        padding: 5px 9px;
        background-color: #e9ecef;
        border-radius: 5px;
        font-size: 13px;
        color: #333;
        white-space: nowrap;
    }

    .no-category {
        color: #999;
        font-size: 14px;
    }

    /* =========================
           LOẠI SÁCH
           ========================= */

    .book-type {
        display: inline-block;
        padding: 5px 9px;
        background-color: #f1f3f5;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 13px;
        color: #333;
        white-space: nowrap;
    }

    /* =========================
           CHƯƠNG
           ========================= */

    .chapter {
        white-space: nowrap;
    }

    /* =========================
           NÚT THAO TÁC
           ========================= */

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 65px;
    }

        .action-buttons .btn {
            width: 100%;
        }

    /* =========================
           KHÔNG CÓ DỮ LIỆU
           ========================= */

    .empty-message {
        padding: 50px;
        text-align: center;
        color: #777;
    }

    /* =========================
       PHÂN TRANG
       ========================= */

    .pagination-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 25px;
    }

    .pagination-button {
        min-width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        color: #444;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
    }

        .pagination-button:hover {
            background: #f3f3f3;
            border-color: #ccc;
            color: #111;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, .07);
        }

        .pagination-button.active {
            background: #212529;
            border-color: #212529;
            color: #fff;
        }

        .pagination-button.disabled {
            pointer-events: none;
            background: #f5f5f5;
            border-color: #e5e5e5;
            color: #aaa;
        }

    .pagination-info {
        margin-top: 10px;
        text-align: center;
        color: #777;
        font-size: 13px;
    }
</style>


<div class="book-page">

    <!-- =========================================
         HEADER
         ========================================= -->

    <div class="book-header">

        <div>

            <h1 class="book-title">
                Quản lý sách
            </h1>

            <p class="book-subtitle">
                Thêm, chỉnh sửa, xem và xóa sách
            </p>

        </div>


        <div class="button-area">

            <!-- THÊM SÁCH -->

            <a asp-action="Create"
               class="btn btn-success">

                + Thêm sách

            </a>


            <!-- QUẢN LÝ -->

            <a href="/Admin"
               class="btn btn-secondary">

                ← Quản lý

            </a>

        </div>

    </div>


    <!-- =========================================
         BẢNG
         ========================================= -->

    <div class="book-card">

        @if (Model != null && Model.Any())
        {

            <table class="book-table">

                <!-- =====================================
                     HEADER BẢNG
                     ===================================== -->

                <thead>

                    <tr>

                        <th>
                            Mã
                        </th>

                        <th>
                            Hình ảnh
                        </th>

                        <th>
                            Tên sách
                        </th>

                        <th>
                            Loại sách
                        </th>

                        <th>
                            Chương
                        </th>

                        <th>
                            Tác giả
                        </th>

                        <th>
                            Nhà xuất bản
                        </th>

                        <th>
                            Giá
                        </th>

                        <th>
                            Số lượng
                        </th>

                        <th>
                            Thể loại
                        </th>

                        <th>
                            Thao tác
                        </th>

                    </tr>

                </thead>


                <!-- =====================================
                     DỮ LIỆU
                     ===================================== -->

                <tbody>

                    @foreach (var item in pagedBooks)
                    {
                        <tr>

                            <!-- =========================
                                 MÃ SÁCH
                                 ========================= -->

                            <td>
                                @item.MaSach
                            </td>


                            <!-- =========================
                                 HÌNH ẢNH
                                 ========================= -->

                            <td>

                                @if (!string.IsNullOrEmpty(item.Hinh))
                                {
                                    <img src="@item.Hinh"
                                         class="book-image"
                                         alt="@item.TenSach" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Không có hình
                                    </span>
                                }

                            </td>


                            <!-- =========================
                                 TÊN SÁCH
                                 ========================= -->

                            <td>

                                <span class="book-name">
                                    @item.TenSach
                                </span>

                            </td>


                            <!-- =========================
                                 LOẠI SÁCH
                                 ========================= -->

                            <td>

                                @if (item.LoaiSach != null)
                                {
                                    <span class="book-type">
                                        @item.LoaiSach.TenLoaiSach
                                    </span>
                                }
                                else
                                {
                                    <span class="no-category">
                                        Chưa có loại sách
                                    </span>
                                }

                            </td>


                            <!-- =========================
                                 CHƯƠNG
                                 ========================= -->

                            <td>

                                <span class="chapter">
                                    @item.Chuong
                                </span>

                            </td>


                            <!-- =========================
                                 TÁC GIẢ
                                 ========================= -->

                            <td>
                                @item.TacGia
                            </td>


                            <!-- =========================
                                 NHÀ XUẤT BẢN
                                 ========================= -->

                            <td>
                                @item.NhaXuatBan
                            </td>


                            <!-- =========================
                                 GIÁ
                                 ========================= -->

                            <td>

                                <span class="book-price">
                                    @item.Gia.ToString("N0") ₫
                                </span>

                            </td>


                            <!-- =========================
                                 SỐ LƯỢNG
                                 ========================= -->

                            <td>
                                @item.SoLuong
                            </td>


                            <!-- =========================
                                 THỂ LOẠI
                                 ========================= -->

                            <td>

                                @if (item.SachTheLoais != null &&
                                     item.SachTheLoais.Any())
                                {

                                    <div class="category-list">

                                        @foreach (var sachTheLoai in item.SachTheLoais)
                                        {

                                            @if (sachTheLoai.TheLoai != null)
                                            {
                                                <span class="category-badge">

                                                    @sachTheLoai.TheLoai.TenTheLoai

                                                </span>
                                            }

                                        }

                                    </div>

                                }
                                else
                                {

                                    <span class="no-category">

                                        Chưa có thể loại

                                    </span>

                                }

                            </td>


                            <!-- =========================
                                 THAO TÁC
                                 ========================= -->

                            <td>

                                <div class="action-buttons">

                                    <!-- XEM -->

                                    <a asp-action="Details"
                                       asp-route-id="@item.MaSach"
                                       class="btn btn-info btn-sm">

                                        Xem

                                    </a>


                                    <!-- SỬA -->

                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaSach"
                                       class="btn btn-warning btn-sm">

                                        Sửa

                                    </a>


                                    <!-- XÓA -->

                                    <a asp-action="Delete"
                                       asp-route-id="@item.MaSach"
                                       class="btn btn-danger btn-sm">

                                        Xóa

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            

        }
        else
        {

            <!-- =====================================
                 KHÔNG CÓ SÁCH
                 ===================================== -->

            <div class="empty-message">

                Chưa có sách nào trong hệ thống.

            </div>

        }

    </div>
    @if (totalBooks > 0 && totalPages > 1)
    {
        <div class="pagination-wrapper">

            <!-- TRANG TRƯỚC -->
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   class="pagination-button">

                    ←

                </a>
            }
            else
            {
                <span class="pagination-button disabled">
                    ←
                </span>
            }


            <!-- CÁC TRANG -->
            @for (
                        int pageNumber = 1;
                        pageNumber <= totalPages;
                        pageNumber++)
            {
                if (pageNumber == currentPage)
                {
                    <span class="pagination-button active">
                        @pageNumber
                    </span>
                }
                else
                {
                    <a asp-action="Index"
                       asp-route-page="@pageNumber"
                       class="pagination-button">

                        @pageNumber

                    </a>
                }
            }


            <!-- TRANG SAU -->
            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   class="pagination-button">

                    →

                </a>
            }
            else
            {
                <span class="pagination-button disabled">
                    →
                </span>
            }

        </div>


        <div class="pagination-info">

            Trang @currentPage / @totalPages
            ·
            Tổng @totalBooks sách

        </div>
    }

</div>