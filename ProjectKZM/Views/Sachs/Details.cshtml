
@model ProjectKZM.Models.Sach

@{
    ViewData["Title"] = "Xem sách";

    var sachCungTacGia =
        ViewBag.SachCungTacGia as List<ProjectKZM.Models.Sach>
        ?? new List<ProjectKZM.Models.Sach>();

    var sachDeXuat =
        ViewBag.SachDeXuat as List<ProjectKZM.Models.Sach>
        ?? new List<ProjectKZM.Models.Sach>();

    // =========================================================
    // DANH SÁCH SÁCH ĐÃ YÊU THÍCH
    // =========================================================

    var favoriteBookIds =
        ViewBag.FavoriteBookIds as IEnumerable<int>
        ?? Enumerable.Empty<int>();

    var isFavorite =
        favoriteBookIds.Contains(Model.MaSach);
}

<style>

    /* =========================================================
               DETAILS PAGE
               ========================================================= */

    .details-page {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .details-title {
        font-size: 40px;
        font-weight: 400;
        margin-bottom: 8px;
    }

    .details-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    /* =========================================================
               DETAILS CARD
               ========================================================= */

    .details-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 30px;
        background: white;
    }

    /* =========================================================
               BOOK IMAGE
               ========================================================= */

    .book-image {
        width: 220px;
        height: 300px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    /* =========================================================
               INFORMATION
               ========================================================= */

    .info-label {
        font-weight: 600;
        width: 180px;
        display: inline-block;
    }

    /* =========================================================
               GENRE
               ========================================================= */

    .genre-badge {
        display: inline-block;
        margin-right: 6px;
        margin-bottom: 6px;
        padding: 6px 10px;
        background: #f0f0f0;
        color: #555;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none !important;
        transition: 0.2s;
    }

        .genre-badge:hover {
            background: #212529 !important;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-1px);
        }

    /* =========================================================
               LOẠI SÁCH
               ========================================================= */

    .book-type-detail {
        display: inline-block;
        padding: 5px 9px;
        background: #f0f0f0;
        color: #555;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: 0.2s;
    }

        .book-type-detail:hover {
            background: #212529;
            color: white;
            transform: translateY(-1px);
        }

    /* =========================================================
               TÌNH TRẠNG
               ========================================================= */

    .book-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
    }

        .book-status.available {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .book-status.out-of-stock {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

    /* =========================================================
               BUTTON AREA
               ========================================================= */

    .button-area {
        margin-top: 45px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .favorite-detail-form {
        margin: 0;
        padding: 0;
    }

    /* =========================================================
               FAVORITE BUTTON - PHẦN CHI TIẾT
               ========================================================= */

    .favorite-detail-button {
        border: 1px solid #dc3545;
        border-radius: 6px;
        background: white;
        color: #dc3545;
        padding: 8px 14px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
        white-space: nowrap;
    }

        .favorite-detail-button:hover {
            background: #dc3545;
            color: white;
        }

        .favorite-detail-button.active {
            background: #dc3545;
            border-color: #dc3545;
            color: white;
        }

            .favorite-detail-button.active:hover {
                background: #bb2d3b;
                border-color: #bb2d3b;
                color: white;
            }

        .favorite-detail-button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* =========================================================
               CART BUTTON - DETAIL
               ========================================================= */

    .cart-detail-button {
        border: none;
        border-radius: 6px;
        background: #212529;
        color: white;
        padding: 8px 14px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
        white-space: nowrap;
    }

        .cart-detail-button:hover {
            background: #000;
        }

        .cart-detail-button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .details-cart-form {
        margin: 0;
        padding: 0;
    }

    /* =========================================================
               THÔNG BÁO
               ========================================================= */

    .login-warning {
        position: fixed;
        top: 25px;
        right: 25px;
        z-index: 9999;
        color: white;
        padding: 14px 22px;
        border-radius: 7px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        display: none;
        font-size: 15px;
        min-width: 280px;
        max-width: 420px;
        text-align: center;
    }

    /* =========================================================
               RELATED
               ========================================================= */

    .related-section {
        margin-top: 55px;
    }

    .related-title {
        font-size: 28px;
        font-weight: 400;
        margin-bottom: 30px;
    }

    .related-row {
        margin-bottom: 45px;
    }

    .related-row-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .related-row-title {
        font-size: 21px;
        font-weight: 500;
        margin: 0;
    }

    /* =========================================================
               ARROWS
               ========================================================= */

    .related-arrows {
        display: flex;
        gap: 6px;
    }

    .related-arrow {
        width: 34px;
        height: 34px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: white;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
        font-size: 18px;
        line-height: 1;
    }

        .related-arrow:hover:not(:disabled) {
            background: #212529;
            color: white;
            border-color: #212529;
        }

        .related-arrow:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

    /* =========================================================
               VIEWPORT
               ========================================================= */

    .related-viewport {
        overflow: hidden;
        width: 100%;
    }

    .related-track {
        display: flex;
        gap: 18px;
        transform: translateX(0);
        transition: transform 0.25s ease;
        will-change: transform;
    }

    /* =========================================================
               CARD
               ========================================================= */

    .related-card-wrapper {
        flex: 0 0 calc((100% - 54px) / 4);
        min-width: 0;
    }

    .related-card {
        height: 100%;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: white;
        overflow: hidden;
        transition: 0.2s;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .related-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
        }

    /* =========================================================
               IMAGE
               ========================================================= */

    .related-image-wrapper {
        width: 100%;
        height: 245px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .related-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.2s;
    }

    .related-no-image {
        color: #888;
        font-size: 13px;
    }

    /* =========================================================
               HẾT HÀNG - CHỈNH LẠI
               Không còn nhãn đỏ ở góc phải.
               Hình sẽ tối/mờ khi hết hàng.
               ========================================================= */

    .related-card.out-of-stock .related-image {
        filter: brightness(0.42);
    }

    .related-out-overlay {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.22);
        color: white;
        font-size: 36px;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
        pointer-events: none;
    }

    /* =========================================================
               LOẠI SÁCH TRÊN ẢNH
               ========================================================= */

    .related-book-type {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 7;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        background: white;
        color: #212529;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

        .related-book-type:hover {
            background: #212529;
            color: white;
            border-color: #212529;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

    /* =========================================================
               FAVORITE BUTTON TRÊN CARD
               ========================================================= */

    .related-favorite-form {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 8;
        margin: 0;
        padding: 0;
    }

    .related-favorite-button {
        width: 36px;
        height: 36px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: white;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 20px;
        line-height: 1;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

        .related-favorite-button:hover {
            transform: scale(1.12);
        }

        .related-favorite-button.active {
            color: #dc3545;
            background: white;
        }

        .related-favorite-button:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    /* =========================================================
               CONTENT
               ========================================================= */

    .related-content {
        padding: 14px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .related-book-title {
        font-size: 17px;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
    }

    .related-author {
        color: #777;
        font-size: 13px;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* =========================================================
               GIÁ - ĐỎ
               ========================================================= */

    .related-price {
        font-size: 16px;
        font-weight: 600;
        color: #dc3545;
        margin-bottom: 5px;
    }

    /* =========================================================
               TRẠNG THÁI
               Nằm ngay dưới giá
               ========================================================= */

    .related-status {
        margin-bottom: 13px;
        font-size: 12px;
        font-weight: 500;
    }

        .related-status.available {
            color: #198754;
        }

        .related-status.out {
            color: #dc3545;
        }

    /* =========================================================
               GENRES
               ========================================================= */

    .related-genres {
        min-height: 35px;
        margin-bottom: 12px;
    }

    .related-genre-link {
        display: inline-block;
        padding: 4px 7px;
        margin-right: 3px;
        margin-bottom: 4px;
        border-radius: 4px;
        background: #f0f0f0;
        color: #555;
        font-size: 11px;
        text-decoration: none !important;
        transition: 0.2s;
    }

        .related-genre-link:hover {
            background: #212529;
            color: white;
            text-decoration: none !important;
        }

    /* =========================================================
               ACTIONS
               ========================================================= */

    .related-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: auto;
    }

    /* =========================================================
               XEM SÁCH
               ========================================================= */

    .related-view-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: auto;
        min-width: 76px;
        height: 36px;
        padding: 0 12px;
        border: 1px solid #6C757D;
        border-radius: 6px;
        background: #6C757D;
        color: white;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none !important;
        white-space: nowrap;
        cursor: pointer;
        transition: 0.2s;
    }

        .related-view-button:hover {
            background: #5c636a;
            border-color: #5c636a;
            color: white;
        }

    /* =========================================================
               KHI HẾT HÀNG - XEM SÁCH DÀI HƠN
               ========================================================= */

    .related-actions.out-of-stock .related-view-button {
        flex: 1;
        min-width: 0;
    }

    /* =========================================================
               GIỎ HÀNG
               ========================================================= */

    .related-cart-form {
        flex: 1;
        min-width: 0;
        margin: 0;
        padding: 0;
        display: flex;
    }

    .related-cart-button {
        width: 100%;
        height: 36px;
        border: 1px solid #212529;
        border-radius: 6px;
        background: #212529;
        color: white;
        font-size: 12px;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        cursor: pointer;
        transition: 0.2s;
    }

        .related-cart-button:hover {
            background: #000;
            border-color: #000;
        }

        .related-cart-button.added {
            background: #d1e7dd !important;
            border-color: #badbcc !important;
            color: #0f5132 !important;
        }

        .related-cart-button:disabled {
            cursor: not-allowed;
            opacity: 1;
        }

        /* =========================================================
               NÚT HẾT HÀNG
               Vừa đủ kích thước + màu #A7ACB1
               ========================================================= */

        .related-cart-button.out-of-stock-button {
            width: auto;
            flex: 0 0 auto;
            min-width: 92px;
            padding: 0 12px;
            background: #A7ACB1;
            border-color: #A7ACB1;
            color: white;
            cursor: not-allowed;
        }

            .related-cart-button.out-of-stock-button:hover {
                background: #A7ACB1;
                border-color: #A7ACB1;
            }

    /* =========================================================
               EMPTY
               ========================================================= */

    .related-empty {
        border: 1px dashed #ddd;
        border-radius: 8px;
        padding: 25px;
        color: #777;
        text-align: center;
    }

    /* =========================================================
               BACK
               ========================================================= */

    .back-button {
        margin-top: 25px;
    }

    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 992px) {

        .related-card-wrapper {
            flex: 0 0 calc((100% - 18px) / 2);
        }
    }

    @@media (max-width: 768px) {

        .details-page {
            margin-top: 25px;
        }

        .details-title {
            font-size: 32px;
        }

        .details-card {
            padding: 20px;
        }

        .book-image {
            width: 180px;
            height: 260px;
            margin-bottom: 25px;
        }

        .info-label {
            width: 150px;
        }

        .related-title {
            font-size: 25px;
        }
    }

    @@media (max-width: 576px) {

        .details-page {
            padding: 0 12px;
        }

        .details-title {
            font-size: 28px;
        }

        .details-card {
            padding: 15px;
        }

        .info-label {
            width: 130px;
        }

        .button-area {
            margin-top: 30px;
        }

        .related-card-wrapper {
            flex: 0 0 100%;
        }

        .related-image-wrapper {
            height: 270px;
        }

        .login-warning {
            left: 15px;
            right: 15px;
            top: 15px;
            min-width: auto;
            max-width: none;
        }
    }

</style>


<div class="details-page">

    <!-- =========================================================
         TITLE
         ========================================================= -->

    <h1 class="details-title">
        Xem sách
    </h1>

    <p class="details-subtitle">
        Thông tin chi tiết của sách
    </p>


    <!-- =========================================================
         DETAILS CARD
         GIỮ NGUYÊN
         ========================================================= -->

    <div class="details-card">

        <div class="row">

            <!-- HÌNH ẢNH -->

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.Hinh))
                {
                    <img src="@Model.Hinh"
                         class="book-image"
                         alt="@Model.TenSach" />
                }
                else
                {
                    <div class="text-muted">
                        Chưa có hình ảnh
                    </div>
                }

            </div>


            <!-- THÔNG TIN -->

            <div class="col-md-8">

                <div class="mb-3"
                     style="display:flex;align-items:flex-start;">

                    <strong class="info-label"
                            style="flex:0 0 180px;">
                        Tên sách:
                    </strong>

                    <span style="flex:1;">
                        @Model.TenSach
                    </span>

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Chương:
                    </strong>

                    @(Model.Chuong ?? "Chưa cập nhật")

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Tác giả:
                    </strong>

                    @(Model.TacGia ?? "Chưa cập nhật")

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Nhà xuất bản:
                    </strong>

                    @(Model.NhaXuatBan ?? "Chưa cập nhật")

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Giá:
                    </strong>

                    @Model.Gia.ToString("N0") VNĐ

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Số lượng:
                    </strong>

                    @Model.SoLuong

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Tình trạng:
                    </strong>

                    @if (Model.SoLuong > 0)
                    {
                        <span class="book-status available">
                            Còn hàng
                        </span>
                    }
                    else
                    {
                        <span class="book-status out-of-stock">
                            Hết hàng
                        </span>
                    }

                </div>


                <div class="mb-3">

                    <strong class="info-label">
                        Loại sách:
                    </strong>

                    @if (Model.LoaiSach != null)
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-route-loaiSachIds="@Model.MaLoaiSach"
                           class="book-type-detail"
                           title="Lọc theo loại sách">

                            @Model.LoaiSach.TenLoaiSach

                        </a>
                    }
                    else
                    {
                        <span class="text-muted">
                            Chưa có loại sách
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- THỂ LOẠI + MÔ TẢ -->

        <div class="details-genre-section">

            <div class="mb-3">

                <strong class="info-label">
                    Thể loại:
                </strong>

                @if (Model.SachTheLoais != null &&
                     Model.SachTheLoais.Any())
                {
                    <div class="mt-2">

                        @foreach (var item in Model.SachTheLoais)
                        {
                            if (item.TheLoai != null)
                            {
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-theLoaiIds="@item.MaTheLoai"
                                   class="genre-badge"
                                   title="Lọc theo thể loại">

                                    @item.TheLoai.TenTheLoai

                                </a>
                            }
                        }

                    </div>
                }
                else
                {
                    <span class="text-muted">
                        Chưa có thể loại
                    </span>
                }

            </div>


            <div class="mb-3">

                <strong class="info-label">
                    Mô tả:
                </strong>

                <p class="mt-2">
                    @(Model.MoTa ?? "Chưa có mô tả")
                </p>

            </div>

        </div>


        <!-- BUTTON -->

        <div class="button-area">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.MaSach"
                   class="btn btn-warning">
                    Sửa
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.MaSach"
                   class="btn btn-danger">
                    Xóa
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="YeuThichs"
                          asp-action="@(isFavorite ? "Xoa" : "Them")"
                          method="post"
                          class="favorite-detail-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="maSach"
                               value="@Model.MaSach" />

                        <button type="submit"
                                class="favorite-detail-button @(isFavorite ? "active" : "")"
                                data-favorite="@isFavorite.ToString().ToLower()">

                            @if (isFavorite)
                            {
                                @:♥ Đã thêm vào yêu thích
                            }
                            else
                            {
                                @:♡ Thêm vào yêu thích
                            }

                        </button>

                    </form>


                    @if (Model.SoLuong > 0)
                    {
                        <form asp-controller="GioHangs"
                              asp-action="Them"
                              method="post"
                              class="details-cart-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="maSach"
                                   value="@Model.MaSach" />

                            <input type="hidden"
                                   name="soLuong"
                                   value="1" />

                            <button type="submit"
                                    class="cart-detail-button">

                                🛒 Bỏ vào giỏ hàng

                            </button>

                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="cart-detail-button"
                                disabled>

                            🛒 Hết hàng

                        </button>
                    }

                }
                else
                {
                    <button type="button"
                            class="favorite-detail-button"
                            onclick="showFavoriteLoginWarning()">

