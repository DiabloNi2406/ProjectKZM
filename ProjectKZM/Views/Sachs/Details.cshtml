<!-- =========================================================
     THÔNG BÁO
     ========================================================= -->

<div id="loginWarning"
     class="login-warning">

    Hãy đăng nhập

</div>


@section Scripts {

    <script>

        /* =========================================================
           RELATED STATE
           ========================================================= */

        const relatedState = {

            author: {
                current: 0,
                total: @Math.Min(sachCungTacGia.Count, 10)
                        },

            suggest: {
                current: 0,
                total: @Math.Min(sachDeXuat.Count, 10)
                        }

        };


        /* =========================================================
           SỐ CARD HIỂN THỊ
           ========================================================= */

        function getVisibleCards() {

            if (window.innerWidth <= 576) {
                return 1;
            }

            if (window.innerWidth <= 992) {
                return 2;
            }

            return 4;
        }


        /* =========================================================
           DI CHUYỂN RELATED
           ========================================================= */

        function moveRelated(type, direction) {

            const state = relatedState[type];

            const track =
                document.getElementById(
                    type === "author"
                        ? "authorTrack"
                        : "suggestTrack"
                );

            if (!track) {
                return;
            }

            const visible = getVisibleCards();

            const maxPosition =
                Math.max(
                    0,
                    state.total - visible
                );

            state.current += direction;

            if (state.current < 0) {
                state.current = 0;
            }

            if (state.current > maxPosition) {
                state.current = maxPosition;
            }

            const cards =
                track.querySelectorAll(
                    ".related-card-wrapper"
                );

            if (!cards.length) {
                return;
            }

            const firstCard = cards[0];

            const cardWidth =
                firstCard.getBoundingClientRect().width;

            const gap =
                parseFloat(
                    getComputedStyle(track).gap
                ) || 0;

            const moveAmount =
                (cardWidth + gap)
                * state.current;

            track.style.transform =
                "translateX(-" +
                moveAmount +
                "px)";

            updateRelatedButtons(type);
        }


        /* =========================================================
           UPDATE ARROWS
           ========================================================= */

        function updateRelatedButtons(type) {

            const state = relatedState[type];

            const visible = getVisibleCards();

            const maxPosition =
                Math.max(
                    0,
                    state.total - visible
                );

            const prev =
                document.getElementById(
                    type === "author"
                        ? "authorPrev"
                        : "suggestPrev"
                );

            const next =
                document.getElementById(
                    type === "author"
                        ? "authorNext"
                        : "suggestNext"
                );

            if (prev) {
                prev.disabled =
                    state.current <= 0;
            }

            if (next) {
                next.disabled =
                    state.current >= maxPosition;
            }
        }


        /* =========================================================
           RESIZE
           ========================================================= */

        window.addEventListener(
            "resize",
            function() {

                relatedState.author.current = 0;
                relatedState.suggest.current = 0;

                const authorTrack =
                    document.getElementById(
                        "authorTrack"
                    );

                const suggestTrack =
                    document.getElementById(
                        "suggestTrack"
                    );

                if (authorTrack) {

                    authorTrack.style.transform =
                        "translateX(0)";
                }

                if (suggestTrack) {

                    suggestTrack.style.transform =
                        "translateX(0)";
                }

                updateRelatedButtons("author");
                updateRelatedButtons("suggest");

            }
        );


        /* =========================================================
           WARNING
           ========================================================= */

        let warningTimer = null;


        function showWarning(
            message,
            background
        ) {

            const warning =
                document.getElementById(
                    "loginWarning"
                );

            if (!warning) {
                return;
            }

            if (warningTimer) {
                clearTimeout(warningTimer);
            }

            warning.innerText =
                message;

            warning.style.background =
                background;

            warning.style.display =
                "block";

            warningTimer =
                setTimeout(
                    function() {

                        warning.style.display =
                            "none";

                    },
                    2000
                );
        }


        /* =========================================================
           LOGIN - YÊU THÍCH
           ========================================================= */

        function showFavoriteLoginWarning() {

            showWarning(
                "Hãy đăng nhập để thêm sách vào danh sách yêu thích",
                "#dc3545"
            );

        }


        /* =========================================================
           LOGIN - GIỎ HÀNG
           ========================================================= */

        function showLoginWarning() {

            showWarning(
                "Hãy đăng nhập để bỏ vào giỏ hàng",
                "#dc3545"
            );

        }


        /* =========================================================
           DOM READY
           ========================================================= */

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                updateRelatedButtons("author");
                updateRelatedButtons("suggest");


                /* =================================================
                   YÊU THÍCH - PHẦN CHI TIẾT
                   ================================================= */

                const favoriteDetailForm =
                    document.querySelector(
                        ".favorite-detail-form"
                    );

                if (favoriteDetailForm) {

                    favoriteDetailForm.addEventListener(
                        "submit",
                        async function(event) {

                            event.preventDefault();

                            const button =
                                favoriteDetailForm.querySelector(
                                    ".favorite-detail-button"
                                );

                            if (!button ||
                                button.disabled) {
                                return;
                            }

                            const wasFavorite =
                                button.dataset.favorite === "true";

                            const originalText =
                                button.innerHTML;

                            button.disabled = true;

                            try {

                                const response =
                                    await fetch(
                                        favoriteDetailForm.action,
                                        {
                                            method: "POST",

                                            headers: {
                                                "X-Requested-With":
                                                    "XMLHttpRequest"
                                            },

                                            body:
                                                new FormData(
                                                    favoriteDetailForm
                                                )
                                        }
                                    );

                                if (!response.ok) {
                                    throw new Error(
                                        "Favorite request failed"
                                    );
                                }

                                const result =
                                    await response.json();

                                if (!result.success) {
                                    throw new Error(
                                        "Favorite request failed"
                                    );
                                }


                                if (result.active === true) {

                                    button.dataset.favorite =
                                        "true";

                                    button.classList.add(
                                        "active"
                                    );

                                    button.innerHTML =
                                        "♥ Đã thêm vào yêu thích";

                                    favoriteDetailForm.action =
                                        "@Url.Action("Xoa", "YeuThichs")";

                                    showWarning(
                                        "Đã thêm sách vào danh sách yêu thích.",
                                        "#198754"
                                    );

                                }
                                else {

                                    button.dataset.favorite =
                                        "false";

                                    button.classList.remove(
                                        "active"
                                    );

                                    button.innerHTML =
                                        "♡ Thêm vào yêu thích";

                                    favoriteDetailForm.action =
                                        "@Url.Action("Them", "YeuThichs")";

                                    showWarning(
                                        "Đã bỏ sách khỏi danh sách yêu thích.",
                                        "#198754"
                                    );

                                }

                            }
                            catch (error) {

                                button.innerHTML =
                                    originalText;

                                button.dataset.favorite =
                                    wasFavorite
                                        ? "true"
                                        : "false";

                                showWarning(
                                    "Không thể cập nhật danh sách yêu thích.",
                                    "#dc3545"
                                );

                            }
                            finally {

                                button.disabled =
                                    false;

                            }

                        }
                    );

                }


                /* =================================================
                   YÊU THÍCH - CARD
                   ================================================= */

                document
                    .querySelectorAll(
                        ".related-favorite-form"
                    )
                    .forEach(
                        function(form) {

                            form.addEventListener(
                                "submit",
                                async function(event) {

                                    event.preventDefault();

                                    const button =
                                        form.querySelector(
                                            ".related-favorite-button"
                                        );

                                    if (!button ||
                                        button.disabled) {
                                        return;
                                    }

                                    const wasFavorite =
                                        button.dataset.favorite === "true";

                                    button.disabled =
                                        true;

                                    try {

                                        const response =
                                            await fetch(
                                                form.action,
                                                {
                                                    method: "POST",

                                                    headers: {
                                                        "X-Requested-With":
                                                            "XMLHttpRequest"
                                                    },

                                                    body:
                                                        new FormData(form)
                                                }
                                            );

                                        if (!response.ok) {

                                            throw new Error(
                                                "Favorite request failed"
                                            );

                                        }

                                        const result =
                                            await response.json();

                                        if (!result.success) {

                                            throw new Error(
                                                "Favorite request failed"
                                            );

                                        }


                                        /* =========================
                                           ĐÃ THÊM
                                           ========================= */

                                        if (result.active === true) {

                                            button.dataset.favorite =
                                                "true";

                                            button.classList.add(
                                                "active"
                                            );

                                            button.innerHTML =
                                                "♥";

                                            button.title =
                                                "Bỏ yêu thích";

                                            form.action =
                                                "@Url.Action("Xoa", "YeuThichs")";

                                            showWarning(
                                                "Đã thêm sách vào danh sách yêu thích.",
                                                "#198754"
                                            );

                                        }


                                        /* =========================
                                           ĐÃ XÓA
                                           ========================= */

                                        else {

                                            button.dataset.favorite =
                                                "false";

                                            button.classList.remove(
                                                "active"
                                            );

                                            button.innerHTML =
                                                "♡";

                                            button.title =
                                                "Thêm vào yêu thích";

                                            form.action =
                                                "@Url.Action("Them", "YeuThichs")";

                                            showWarning(
                                                "Đã bỏ sách khỏi danh sách yêu thích.",
                                                "#198754"
                                            );

                                        }

                                    }
                                    catch (error) {

                                        button.dataset.favorite =
                                            wasFavorite
                                                ? "true"
                                                : "false";

                                        showWarning(
                                            "Không thể cập nhật danh sách yêu thích.",
                                            "#dc3545"
                                        );

                                    }
                                    finally {

                                        button.disabled =
                                            false;

                                    }

                                }
                            );

                        }
                    );


                /* =================================================
                   GIỎ HÀNG - CARD
                   ================================================= */

                document
                    .querySelectorAll(
                        ".related-cart-form"
                    )
                    .forEach(
                        function(form) {

                            form.addEventListener(
                                "submit",
                                async function(event) {

                                    event.preventDefault();

                                    const button =
                                        form.querySelector(
                                            ".related-cart-button"
                                        );

                                    if (!button ||
                                        button.disabled) {
                                        return;
                                    }

                                    const originalText =
                                        button.innerHTML;

                                    button.disabled =
                                        true;

                                    try {

                                        const response =
                                            await fetch(
                                                form.action,
                                                {
                                                    method: "POST",

                                                    body:
                                                        new FormData(form)
                                                }
                                            );

                                        if (response.ok) {

                                            button.innerHTML =
                                                "✓ Đã thêm vào giỏ";

                                            button.classList.add(
                                                "added"
                                            );

                                            showWarning(
                                                "Đã thêm sách vào giỏ hàng.",
                                                "#198754"
                                            );

                                            setTimeout(
                                                function() {

                                                    button.innerHTML =
                                                        originalText;

                                                    button.classList.remove(
                                                        "added"
                                                    );

                                                    button.disabled =
                                                        false;

                                                },
                                                2000
                                            );

                                        }
                                        else {

                                            button.disabled =
                                                false;

                                            showWarning(
                                                "Không thể thêm sản phẩm vào giỏ hàng.",
                                                "#dc3545"
                                            );

                                        }

                                    }
                                    catch (error) {

                                        button.disabled =
                                            false;

                                        showWarning(
                                            "Có lỗi xảy ra khi thêm vào giỏ hàng.",
                                            "#dc3545"
                                        );

                                    }

                                }
                            );

                        }
                    );


                /* =================================================
                   GIỎ HÀNG - DETAIL
                   ================================================= */

                document
                    .querySelectorAll(
                        ".details-cart-form"
                    )
                    .forEach(
                        function(form) {

                            form.addEventListener(
                                "submit",
                                async function(event) {

                                    event.preventDefault();

                                    const button =
                                        form.querySelector(
                                            ".cart-detail-button"
                                        );

                                    if (!button ||
                                        button.disabled) {
                                        return;
                                    }

                                    const originalText =
                                        button.innerHTML;

                                    button.disabled =
                                        true;

                                    try {

                                        const response =
                                            await fetch(
                                                form.action,
                                                {
                                                    method: "POST",

                                                    body:
                                                        new FormData(form)
                                                }
                                            );

                                        if (response.ok) {

                                            button.innerHTML =
                                                "✓ Đã thêm vào giỏ";

                                            button.style.backgroundColor =
                                                "#d1e7dd";

                                            button.style.borderColor =
                                                "#badbcc";

                                            button.style.color =
                                                "#0f5132";

                                            showWarning(
                                                "Đã thêm sách vào giỏ hàng.",
                                                "#198754"
                                            );

                                            setTimeout(
                                                function() {

                                                    button.innerHTML =
                                                        originalText;

                                                    button.style.backgroundColor =
                                                        "";

                                                    button.style.borderColor =
                                                        "";

                                                    button.style.color =
                                                        "";

                                                    button.disabled =
                                                        false;

                                                },
                                                2000
                                            );

                                        }
                                        else {

                                            button.disabled =
                                                false;

                                            showWarning(
                                                "Không thể thêm sản phẩm vào giỏ hàng.",
                                                "#dc3545"
                                            );

                                        }

                                    }
                                    catch (error) {

                                        button.disabled =
                                            false;

                                        showWarning(
                                            "Có lỗi xảy ra khi thêm vào giỏ hàng.",
                                            "#dc3545"
                                        );

                                    }

                                }
                            );

                        }
                    );

            }
        );

    </script>

}

